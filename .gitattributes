# スクリプト・画面定義・バッチは CRLF で取り出す（PowerShell 5.1・cmd の前提。tests\meta\encoding.Tests.ps1 が確かめる）。
# core.autocrlf の設定に左右されないよう、ここで固定する（GitHub Actions のランナーでも同じになる）
*.ps1 text eol=crlf
*.xaml text eol=crlf
*.bat text eol=crlf
# インストーラー（Inno Setup のスクリプトと、起動口 tebunko.exe のソース）も Windows の道具が読むため CRLF にする
*.iss text eol=crlf
*.cs text eol=crlf
# 起動に失敗したときの文言（tebunko.bat が読み込む）も同じ理由で CRLF にする
scripts/tebunko/startup/*.txt text eol=crlf

# git のフックは git for Windows の sh が読むため、LF で取り出す
tools/hooks/* text eol=lf
