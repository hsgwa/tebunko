<!-- 高速検索の表示 758x296。Fast Search Indicator の 6 状態（上から優先順）をまとめた見本。 -->
<Grid x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="758" Height="296">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Grid.Resources>
  <Border Background="#FFFFFF" BorderBrush="#E0E2E5" BorderThickness="1" CornerRadius="4">
  <StackPanel Margin="16">
    <TextBlock Text="高速検索の表示（上から順に、最初に当てはまるもの）" Style="{StaticResource Text.12}" FontWeight="Bold" Margin="0,0,0,10" />

    <!-- 1. Windows Search に接続できません -->
    <DockPanel Margin="0,0,0,10">
      <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Bg.F3F3F4}" BorderBrush="{StaticResource Disabled.9AA0A6}" DockPanel.Dock="Left">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource Icon.Zap}" Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Ink.5F6368}" StrokeThickness="1.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,4,0" />
          <TextBlock Text="高速検索：使用不可（Windows Search に接続できません）" Style="{StaticResource Text.11}" Foreground="{StaticResource Disabled.8C949E}" />
          <Grid Width="13" Height="13" Margin="4,0,0,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Path Style="{StaticResource Icon.InfoCircle.S13}" Stroke="{StaticResource Disabled.9AA0A6}" />
            <Path Style="{StaticResource Icon.InfoGlyph.S13.Style}" Stroke="{StaticResource Disabled.9AA0A6}" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Bubble}" Margin="12,0,0,0">
        <TextBlock Text="検索はできますが時間がかかります　［インデックス管理で確認］" Style="{StaticResource Text.Bubble}" />
      </Border>
    </DockPanel>

    <!-- 2. 正規表現では使えません -->
    <DockPanel Margin="0,0,0,10">
      <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Bg.F3F3F4}" BorderBrush="{StaticResource Disabled.9AA0A6}" DockPanel.Dock="Left">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource Icon.Zap}" Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Ink.5F6368}" StrokeThickness="1.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,4,0" />
          <TextBlock Text="高速検索：使用不可（正規表現では使えません）" Style="{StaticResource Text.11}" Foreground="{StaticResource Disabled.8C949E}" />
          <Grid Width="13" Height="13" Margin="4,0,0,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Path Style="{StaticResource Icon.InfoCircle.S13}" Stroke="{StaticResource Disabled.9AA0A6}" />
            <Path Style="{StaticResource Icon.InfoGlyph.S13.Style}" Stroke="{StaticResource Disabled.9AA0A6}" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Bubble}" Margin="12,0,0,0">
        <TextBlock Text="正規表現をオフにすると速く検索できます" Style="{StaticResource Text.Bubble}" />
      </Border>
    </DockPanel>

    <!-- 3. 2文字以上で使えます（吹き出しの代わりに「(i) なし」という案内を添える） -->
    <DockPanel Margin="0,0,0,10">
      <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Bg.F3F3F4}" BorderBrush="{StaticResource Disabled.9AA0A6}" DockPanel.Dock="Left">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource Icon.Zap}" Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Ink.5F6368}" StrokeThickness="1.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,4,0" />
          <TextBlock Text="高速検索：使用不可（2文字以上で使えます）" Style="{StaticResource Text.11}" Foreground="{StaticResource Disabled.8C949E}" />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center">
        <Grid Width="13" Height="13" Margin="0,0,4,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
          <Path Style="{StaticResource Icon.InfoCircle.S13}" Stroke="{StaticResource Disabled.9AA0A6}" />
          <Path Style="{StaticResource Icon.InfoGlyph.S13.Style}" Stroke="{StaticResource Disabled.9AA0A6}" />
        </Grid>
        <TextBlock Text="なし" Style="{StaticResource Text.11.Muted}" />
      </StackPanel>
    </DockPanel>

    <!-- 4. 反映待ちです -->
    <DockPanel Margin="0,0,0,10">
      <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Bg.F3F3F4}" BorderBrush="{StaticResource Disabled.9AA0A6}" DockPanel.Dock="Left">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource Icon.Zap}" Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Ink.5F6368}" StrokeThickness="1.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,4,0" />
          <TextBlock Text="高速検索：使用不可（反映待ちです）" Style="{StaticResource Text.11}" Foreground="{StaticResource Disabled.8C949E}" />
          <Grid Width="13" Height="13" Margin="4,0,0,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Path Style="{StaticResource Icon.InfoCircle.S13}" Stroke="{StaticResource Disabled.9AA0A6}" />
            <Path Style="{StaticResource Icon.InfoGlyph.S13.Style}" Stroke="{StaticResource Disabled.9AA0A6}" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Bubble}" Margin="12,0,0,0">
        <TextBlock Text="インデックスの更新が終わると使えます　［インデックス管理で確認］" Style="{StaticResource Text.Bubble}" />
      </Border>
    </DockPanel>

    <!-- 5. 一部で使用可（オレンジ） -->
    <DockPanel Margin="0,0,0,10">
      <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Warn.FFF5E0}" BorderBrush="{StaticResource Warn.BA7D00}" DockPanel.Dock="Left">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource Icon.Zap}" Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Warn.BA7D00}" StrokeThickness="1.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,4,0" />
          <TextBlock Text="高速検索：一部で使用可" Style="{StaticResource Text.11}" Foreground="{StaticResource Warn.BA7D00}" />
          <Grid Width="13" Height="13" Margin="4,0,0,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Path Style="{StaticResource Icon.InfoCircle.S13}" Stroke="{StaticResource Warn.BA7D00}" />
            <Path Style="{StaticResource Icon.InfoGlyph.S13.Style}" Stroke="{StaticResource Warn.BA7D00}" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Bubble}" Margin="12,0,0,0">
        <TextBlock Text="2フォルダはパスが長いため、通常の検索で調べます（検索結果は変わりません）" Style="{StaticResource Text.Bubble}" />
      </Border>
    </DockPanel>

    <!-- 6. 使用可（緑。吹き出しの代わりに「(i) なし」という案内を添える） -->
    <DockPanel Margin="0,0,0,0">
      <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Ok.E0F7E0}" BorderBrush="{StaticResource Ok.218A21}" DockPanel.Dock="Left">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource Icon.Zap}" Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Ok.218A21}" StrokeThickness="1.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,4,0" />
          <TextBlock Text="高速検索：使用可" Style="{StaticResource Text.11}" Foreground="{StaticResource Ok.218A21}" />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center">
        <Grid Width="13" Height="13" Margin="0,0,4,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
          <Path Style="{StaticResource Icon.InfoCircle.S13}" Stroke="{StaticResource Disabled.9AA0A6}" />
          <Path Style="{StaticResource Icon.InfoGlyph.S13.Style}" Stroke="{StaticResource Disabled.9AA0A6}" />
        </Grid>
        <TextBlock Text="なし" Style="{StaticResource Text.11.Muted}" />
      </StackPanel>
    </DockPanel>
  </StackPanel>
  </Border>
</Grid>
