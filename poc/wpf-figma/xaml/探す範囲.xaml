<!-- 探す範囲 817x202。「探す範囲」ドロップダウンの見本を 3 枚並べる。
     既定（閉じている）／開いたとき（すべて選択）／本文以外を外したとき（ボタンの文字が変わる）。 -->
<Grid x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="817" Height="202" Background="#FFFFFF">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Grid.Resources>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="260" />
    <ColumnDefinition Width="260" />
    <ColumnDefinition Width="*" />
  </Grid.ColumnDefinitions>

  <!-- 正規表現のチェックと吹き出し -->
  <StackPanel Grid.Column="0" Margin="8">
    <TextBlock Text="[正規表現] のツールチップ" Style="{StaticResource Text.11.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
    <CheckBox Content="正規表現" IsChecked="False" FontFamily="{DynamicResource Font.UI}" FontSize="11" Margin="0,0,0,8" />
    <Border Style="{StaticResource Bubble}" HorizontalAlignment="Left" MaxWidth="220">
      <TextBlock Text="正規表現を使う&#10;オンにすると高速検索は使えません" Style="{StaticResource Text.Bubble}" />
    </Border>
  </StackPanel>

  <!-- 探す範囲（すべて選択） -->
  <StackPanel Grid.Column="1" Margin="8">
    <TextBlock Text="[探す範囲 ▾] を開いたとき" Style="{StaticResource Text.11.Muted}" Margin="0,0,0,8" />
    <Button Style="{StaticResource Btn.Outline}" Height="26" Padding="10,2,10,2" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="探す範囲" Style="{StaticResource Text.11}" />
        <Path Data="{StaticResource Icon.ChevronDown}" Width="10" Height="10" Stretch="Uniform" Stroke="{StaticResource Ink.202124}" StrokeThickness="0.83" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="4,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
    <!-- Width を明示した要素は、既定の HorizontalAlignment（Stretch）のままだと
         親の StackPanel の幅の中で中央寄せになってしまう（WPF の仕様）。左端に揃えるため
         HorizontalAlignment="Left" を明示する。 -->
    <Border Width="230" HorizontalAlignment="Left" Background="{StaticResource Bg.FFFFFF}" BorderBrush="{StaticResource Border.D9DEE3}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.4}" Effect="{StaticResource Shadow.Small}" Padding="12" Margin="0,4,0,0">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <CheckBox Style="{StaticResource CheckBox.Tree}" IsChecked="True" IsEnabled="False" />
          <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource Font.UI}">
            <Run Text="本文" FontSize="12" Foreground="{StaticResource Ink.202124}" />
            <Run Text="　（常に対象）" FontSize="11" Foreground="{StaticResource Ink.6B737D}" />
          </TextBlock>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
          <CheckBox Style="{StaticResource CheckBox.Tree}" IsChecked="True" />
          <TextBlock Text="図形" Margin="8,0,0,0" Style="{StaticResource Text.12}" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
          <CheckBox Style="{StaticResource CheckBox.Tree}" IsChecked="True" />
          <TextBlock Text="コメント" Margin="8,0,0,0" Style="{StaticResource Text.12}" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
          <CheckBox Style="{StaticResource CheckBox.Tree}" IsChecked="True" />
          <TextBlock Text="ノート（PowerPoint）" Margin="8,0,0,0" Style="{StaticResource Text.12}" VerticalAlignment="Center" />
        </DockPanel>
        <Rectangle Height="1" Fill="{StaticResource Line.E0E2E5}" Margin="0,2,0,8" />
        <TextBlock Text="Excel・Word・PowerPoint のファイルが対象です" Style="{StaticResource Text.11.Muted}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>

  <!-- 探す範囲（本文以外を外したとき） -->
  <StackPanel Grid.Column="2" Margin="8">
    <TextBlock Text="本文以外を外したとき（ボタンの文字が変わる）" Style="{StaticResource Text.11.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
    <Button Style="{StaticResource Btn.Outline}" Height="26" Padding="10,2,10,2" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="探す範囲：本文・図形" Style="{StaticResource Text.11}" />
        <Path Data="{StaticResource Icon.ChevronDown}" Width="10" Height="10" Stretch="Uniform" Stroke="{StaticResource Ink.202124}" StrokeThickness="0.83" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="4,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
    <!-- Width を明示した要素は、既定の HorizontalAlignment（Stretch）のままだと
         親の StackPanel の幅の中で中央寄せになってしまう（WPF の仕様）。左端に揃えるため
         HorizontalAlignment="Left" を明示する。 -->
    <Border Width="230" HorizontalAlignment="Left" Background="{StaticResource Bg.FFFFFF}" BorderBrush="{StaticResource Border.D9DEE3}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.4}" Effect="{StaticResource Shadow.Small}" Padding="12" Margin="0,4,0,0">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <CheckBox Style="{StaticResource CheckBox.Tree}" IsChecked="True" IsEnabled="False" />
          <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource Font.UI}">
            <Run Text="本文" FontSize="12" Foreground="{StaticResource Ink.202124}" />
            <Run Text="　（常に対象）" FontSize="11" Foreground="{StaticResource Ink.6B737D}" />
          </TextBlock>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
          <CheckBox Style="{StaticResource CheckBox.Tree}" IsChecked="True" />
          <TextBlock Text="図形" Margin="8,0,0,0" Style="{StaticResource Text.12}" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
          <CheckBox Style="{StaticResource CheckBox.Tree}" IsChecked="False" />
          <TextBlock Text="コメント" Margin="8,0,0,0" Style="{StaticResource Text.12}" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
          <CheckBox Style="{StaticResource CheckBox.Tree}" IsChecked="False" />
          <TextBlock Text="ノート（PowerPoint）" Margin="8,0,0,0" Style="{StaticResource Text.12}" VerticalAlignment="Center" />
        </DockPanel>
        <Rectangle Height="1" Fill="{StaticResource Line.E0E2E5}" Margin="0,2,0,8" />
        <TextBlock Text="Excel・Word・PowerPoint のファイルが対象です" Style="{StaticResource Text.11.Muted}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</Grid>
