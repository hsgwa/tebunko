<!-- インデックス管理の一覧（index_list）353:29841。scroll.md の X-多・X-多-詳細 向け見本。
     見出し・列の見出しは固定、行は IndexListScroll（ScrollViewer）だけが縦にスクロールする。
     詳細欄（IndexDetailPanel）は X-多-詳細 でだけ出す簡易な置き場所（index_detail.md は今回の範囲外）。 -->
<Grid x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="1280" Height="820" Background="#FFFFFF">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Grid.Resources>
  <Grid.RowDefinitions>
    <RowDefinition Height="*" MinHeight="225" />
    <RowDefinition x:Name="IndexSplitterRow" Height="5" />
    <RowDefinition x:Name="IndexDetailRow" Height="Auto" />
    <RowDefinition Height="24" />    <!-- ステータスバー（固定。shell/status_bar.md） -->
  </Grid.RowDefinitions>

  <!-- 一覧（index_list 部品） -->
  <Grid Grid.Row="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />  <!-- 見出し -->
      <RowDefinition Height="28" />    <!-- 列の見出し -->
      <RowDefinition Height="*" />     <!-- 行 -->
    </Grid.RowDefinitions>

    <!-- 見出し（header-section） -->
    <Border Grid.Row="0" Padding="16" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,16,0">
          <TextBlock Text="インデックス管理" Style="{StaticResource Text.16}" FontWeight="Bold" />
          <TextBlock Text="検索するフォルダとインデックスを管理します。ファイルを変更したら［更新］でインデックスを最新にします。"
                     Style="{StaticResource Text.12.Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="インポート…" Style="{StaticResource Btn.Outline}" Height="32" Padding="14,0" />
          <Button Content="＋ フォルダを追加" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Padding="16,7" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 列の見出し（固定。縦には流れない） -->
    <Border Grid.Row="1" Background="{StaticResource Bg.F9FAFA}" BorderBrush="{StaticResource Line.E0E2E5}"
            BorderThickness="0,0,0,1" Padding="12,0">
      <Grid x:Name="IndexGridHeader">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="13" /><ColumnDefinition Width="12" />
          <ColumnDefinition Width="120" /><ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" MinWidth="160" /><ColumnDefinition Width="12" />
          <ColumnDefinition Width="60" /><ColumnDefinition Width="12" />
          <ColumnDefinition Width="120" /><ColumnDefinition Width="12" />
          <ColumnDefinition Width="164" /><ColumnDefinition Width="12" />
          <ColumnDefinition Width="96" /><ColumnDefinition Width="12" />
          <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="2" Text="インデックス名" Style="{StaticResource Text.11.Body}" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Text="パス" Style="{StaticResource Text.11.Body}" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBlock Grid.Column="6" Text="ファイル数" Style="{StaticResource Text.11.Body}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="8" Text="最終更新" Style="{StaticResource Text.11.Body}" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBlock Grid.Column="10" Text="ステータス" Style="{StaticResource Text.11.Body}" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBlock Grid.Column="12" Text="高速検索" Style="{StaticResource Text.11.Body}" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBlock Grid.Column="14" Text="操作" Style="{StaticResource Text.11.Body}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
    </Border>

    <!-- 行（ここだけスクロールする） -->
    <ScrollViewer x:Name="IndexListScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="IndexRowsPanel" />
    </ScrollViewer>
  </Grid>

  <!-- 境目（詳細欄を出すときだけ見える） -->
  <GridSplitter x:Name="IndexSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                Background="{StaticResource Bg.F9FAFA}" IsEnabled="False" Visibility="Collapsed" />

  <!-- 詳細欄（簡易な置き場所。index_detail.md は今回の範囲外） -->
  <Border x:Name="IndexDetailPanel" Grid.Row="2" Height="397" Visibility="Collapsed"
          Background="{StaticResource Bg.FFFFFF}" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,1,0,0">
    <StackPanel Margin="16">
      <TextBlock x:Name="IndexDetailTitle" Text="顧客" Style="{StaticResource Text.16}" FontWeight="Bold" />
      <TextBlock x:Name="IndexDetailPath" Text="C:\Share\顧客" Style="{StaticResource Text.12.Muted}" Margin="0,4,0,0" />
      <TextBlock Text="（詳細欄の中身は index_detail.md の範囲。ここでは置き場所だけ示す）" Style="{StaticResource Text.11.Muted}" Margin="0,12,0,0" />
    </StackPanel>
  </Border>

  <!-- ステータスバー（固定。合計はここに出す。shell/status_bar.md の受け入れどおり） -->
  <Border Grid.Row="3" Background="{StaticResource Bg.F9FAFA}" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,1,0,0">
    <Grid>
      <TextBlock x:Name="IndexStatusBarText" Text="" Style="{StaticResource Text.11.Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
      <TextBlock x:Name="IndexStatusBarTotalText" Text="合計: 6,670 ファイル" Style="{StaticResource Text.11.Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
    </Grid>
  </Border>
</Grid>
