<!-- プレビューの種類ごと見本 820x1450。
     メンテナ指摘（2026-10-03・追加の 3）: 下部プレビュー（docs/design/gui/preview.md「選択行のプレビュー」）の
     種類ごとの見本をまとめた参照用シート。Figma のフレームではなく、メンテナ指摘向けに新規に作った参考シート
     （26 枚には含まれない。参照 PNG は無い・compare.ps1 の対象外）。
     行番号は（tsv・テキストの見本を除き）実物の行番号の雰囲気を示す仮の値で、元のファイルの実在の行とは
     対応しない。列見出しは、設計書どおり Excel は A・B・C…、それ以外（tsv を除く）は「1」、
     タブ区切りの tsv だけ「1」「2」「3」。 -->
<Grid x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="820" Height="1450" Background="#FFFFFF">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Grid.Resources>
  <StackPanel Margin="16">
    <TextBlock Text="プレビューの種類ごと見本（docs/design/gui/preview.md「選択行のプレビュー」）" Style="{StaticResource Text.12}" FontWeight="Bold" Margin="0,0,0,10" />

    <!-- 1. Excel・セル -->
    <Border BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Excel・セル" Style="{StaticResource Text.11}" FontWeight="Bold" Margin="8,6,0,4" />
        <Grid Margin="8,0,8,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" /><ColumnDefinition Width="160" /><ColumnDefinition Width="160" /><ColumnDefinition Width="160" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Background="{StaticResource Bg.F3F3F4}" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,0,1" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="A" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="B" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="3" Text="C" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="2" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="取引規模" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="Aクラス" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
          <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Background="{StaticResource Select.E1F2FF}" />
          <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Match.FFF3CD}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="3" Style="{StaticResource Text.11.Muted}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="Bold" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center">
            <Run Text="見積先：" /><Run Text="(株)山田商事" Background="{StaticResource Hit.FFF176}" /><Run Text="（御中）" />
          </TextBlock>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="見積番号：12-2324-0143" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock Grid.Row="3" Grid.Column="0" Text="4" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="件名：基幹システム導入一式" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 2. Excel・図形 -->
    <Border BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Excel・図形（場所の表記は図形の左上のセル）" Style="{StaticResource Text.11}" FontWeight="Bold" Margin="8,6,0,4" />
        <Grid Margin="8,0,8,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" /><ColumnDefinition Width="160" /><ColumnDefinition Width="160" /><ColumnDefinition Width="160" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Background="{StaticResource Bg.F3F3F4}" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,0,1" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="A" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="B" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="3" Text="C" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="4" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Background="{StaticResource Select.E1F2FF}" />
          <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Match.FFF3CD}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="5" Style="{StaticResource Text.11.Muted}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="Bold" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center">
            <Run Text="（図形）納期は" /><Run Text="別途ご相談" Background="{StaticResource Hit.FFF176}" />
          </TextBlock>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="6" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 3. Excel・コメント -->
    <Border BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Excel・コメント（場所の表記はコメントのセル）" Style="{StaticResource Text.11}" FontWeight="Bold" Margin="8,6,0,4" />
        <Grid Margin="8,0,8,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" /><ColumnDefinition Width="160" /><ColumnDefinition Width="160" /><ColumnDefinition Width="160" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Background="{StaticResource Bg.F3F3F4}" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,0,1" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="A" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="B" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="3" Text="C" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="11" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Background="{StaticResource Select.E1F2FF}" />
          <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Match.FFF3CD}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="12" Style="{StaticResource Text.11.Muted}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="Bold" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center">
            <Run Text="（コメント）要確認：" /><Run Text="単価" Background="{StaticResource Hit.FFF176}" /><Run Text="を見直す" />
          </TextBlock>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="13" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 4. Word・本文 -->
    <Border BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Word・本文（列見出しは 1）" Style="{StaticResource Text.11}" FontWeight="Bold" Margin="8,6,0,4" />
        <Grid Margin="8,0,8,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" /><ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Bg.F3F3F4}" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,0,1" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="1" Style="{StaticResource Text.11.Muted}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="14" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="第3条（支払条件）" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
          <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Select.E1F2FF}" />
          <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Match.FFF3CD}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="15" Style="{StaticResource Text.11.Muted}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="Bold" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center">
            <Run Text="甲：" /><Run Text="(株)山田商事" Background="{StaticResource Hit.FFF176}" /><Run Text="は毎月末日までに支払う" />
          </TextBlock>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="16" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="（以下、振込先を記載）" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 5. Word・ノート -->
    <Border BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Word・ノート（列見出しは 1）" Style="{StaticResource Text.11}" FontWeight="Bold" Margin="8,6,0,4" />
        <Grid Margin="8,0,8,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" /><ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Bg.F3F3F4}" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,0,1" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="1" Style="{StaticResource Text.11.Muted}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="3" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Select.E1F2FF}" />
          <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Match.FFF3CD}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="4" Style="{StaticResource Text.11.Muted}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="Bold" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center">
            <Run Text="（ノート）" /><Run Text="顧客名" Background="{StaticResource Hit.FFF176}" /><Run Text="の表記はカタカナ不要" />
          </TextBlock>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="5" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 6. PowerPoint・本文 -->
    <Border BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="PowerPoint・本文（列見出しは 1）" Style="{StaticResource Text.11}" FontWeight="Bold" Margin="8,6,0,4" />
        <Grid Margin="8,0,8,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" /><ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Bg.F3F3F4}" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,0,1" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="1" Style="{StaticResource Text.11.Muted}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="1" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="導入事例のご紹介" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
          <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Select.E1F2FF}" />
          <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Match.FFF3CD}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="2" Style="{StaticResource Text.11.Muted}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="Bold" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center">
            <Run Text="導入効果：" /><Run Text="(株)山田商事" Background="{StaticResource Hit.FFF176}" /><Run Text="様の事例" />
          </TextBlock>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="3" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 7. PowerPoint・ノート -->
    <Border BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="PowerPoint・ノート（列見出しは 1）" Style="{StaticResource Text.11}" FontWeight="Bold" Margin="8,6,0,4" />
        <Grid Margin="8,0,8,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" /><ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Bg.F3F3F4}" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,0,1" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="1" Style="{StaticResource Text.11.Muted}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="1" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Select.E1F2FF}" />
          <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Match.FFF3CD}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="2" Style="{StaticResource Text.11.Muted}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="Bold" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center">
            <Run Text="（ノート）次回更新予定：" /><Run Text="単価" Background="{StaticResource Hit.FFF176}" /><Run Text="の数値" />
          </TextBlock>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="3" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 8. テキスト（txt・md・csv・log。列見出しは 1） -->
    <Border BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="テキスト（txt・md・csv・log。列見出しは 1。行番号は元のファイルの行番号）" Style="{StaticResource Text.11}" FontWeight="Bold" Margin="8,6,0,4" />
        <Grid Margin="8,0,8,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" /><ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Bg.F3F3F4}" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,0,1" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="1" Style="{StaticResource Text.11.Muted}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="29" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="定例会の出席：佐藤様・山田" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
          <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Select.E1F2FF}" />
          <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Match.FFF3CD}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="30" Style="{StaticResource Text.11.Muted}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="Bold" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center">
            <Run Text="次回までに" /><Run Text="(株)山田商事" Background="{StaticResource Hit.FFF176}" /><Run Text="向けの見積を送る" />
          </TextBlock>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="31" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="（以上）" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 9. テキスト（tsv。列見出しは 1・2・3） -->
    <Border BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="テキスト（tsv。タブ区切りのため列見出しは 1・2・3）" Style="{StaticResource Text.11}" FontWeight="Bold" Margin="8,6,0,4" />
        <Grid Margin="8,0,8,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" /><ColumnDefinition Width="160" /><ColumnDefinition Width="160" /><ColumnDefinition Width="160" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Background="{StaticResource Bg.F3F3F4}" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,0,1" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="1" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="2" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="3" Text="3" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="8" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="2024-10-10" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="B社" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="3" Text="見積送付" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
          <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Background="{StaticResource Select.E1F2FF}" />
          <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource Match.FFF3CD}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="9" Style="{StaticResource Text.11.Muted}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="2024-10-15" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="2" FontWeight="Bold" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center">
            <Run Text="(株)山田商事" Background="{StaticResource Hit.FFF176}" />
          </TextBlock>
          <TextBlock Grid.Row="2" Grid.Column="3" Text="見積送付" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock Grid.Row="3" Grid.Column="0" Text="10" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="2024-10-20" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock Grid.Row="3" Grid.Column="2" Text="A社" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock Grid.Row="3" Grid.Column="3" Text="請求書発行" Style="{StaticResource Text.12}" Margin="4,0" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 10. 未選択 -->
    <Border BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="未選択（行を選んでいないとき。枠は常に表示する）" Style="{StaticResource Text.11}" FontWeight="Bold" Margin="8,6,0,4" />
        <Border Height="56" Margin="8,0,8,8" Background="{StaticResource Bg.FFFFFF}">
          <TextBlock Text="結果の表で行を選ぶと、ここにその前後の行を表示します。" Style="{StaticResource Text.12.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </StackPanel>
    </Border>

    <!-- 11. 読めない -->
    <Border BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="読めない（本文インデックスのファイルが読み込めない。選択行だけを表示）" Style="{StaticResource Text.11}" FontWeight="Bold" Margin="8,6,0,4" />
        <Grid Margin="8,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" /><ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Select.E1F2FF}" Height="20" VerticalAlignment="Top" />
