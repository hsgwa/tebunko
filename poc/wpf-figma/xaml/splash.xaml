<!-- SP（起動画面）480x300。フレームそのままの大きさのルート要素。
     show.ps1 / compare.ps1 が Width=480 Height=300 で Measure/Arrange して使う。 -->
<Grid x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="480" Height="300" Background="#FFFFFF">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Grid.Resources>
  <Border BorderBrush="{StaticResource Border.D9DEE3}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="6" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Rectangle Grid.Row="0" Fill="{StaticResource Accent.0078D4}" />

      <Grid Grid.Row="1">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-20,0,0">
          <!-- round10 項目2。起動画面のロゴを新しい app_logo.svg に差し替え、48x48 で中央に置く（README の 10） -->
          <Image Source="{StaticResource Logo.AppLogo}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" />
          <TextBlock Text="tebunko" Style="{StaticResource Text.22}" HorizontalAlignment="Center" Margin="0,10,0,0" />
          <!-- 幅 240 で細く（diff_round3.md 12・小） -->
          <Grid Width="240" Height="4" Margin="0,18,0,0">
            <Border CornerRadius="2" Background="{StaticResource Bg.EDF0F2}" />
            <Border x:Name="SplashProgress" CornerRadius="2" Background="{StaticResource Accent.0078D4}"
                    Width="157" HorizontalAlignment="Left" />
          </Grid>
          <TextBlock x:Name="SplashCaption" Text="起動中…" Style="{StaticResource Text.12.Muted}"
                     HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>

        <TextBlock x:Name="SplashVersion" Text="v1.2.0" Style="{StaticResource Text.11.Muted}"
                   Foreground="{StaticResource Disabled.9AA0A6}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" />
      </Grid>
    </Grid>
  </Border>
</Grid>
