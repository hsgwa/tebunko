<!-- SP（起動画面）480x300。フレームそのままの大きさのルート要素。
     show.ps1 / compare.ps1 が Width=480 Height=300 で Measure/Arrange して使う。 -->
<Grid x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="480" Height="300" Background="#FFFFFF">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Grid.Resources>
  <Border BorderBrush="{StaticResource Border.D9DEE3}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="6" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Rectangle Grid.Row="0" Fill="{StaticResource Accent.0078D4}" />

      <Grid Grid.Row="1">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-20,0,0">
          <Grid Width="56" Height="56" HorizontalAlignment="Center">
            <Path Data="{StaticResource Icon.AppBook}" Width="40" Height="40" Stretch="Uniform"
                  Fill="#E5F1FB" Stroke="{StaticResource Accent.0078D4}" StrokeThickness="3.33"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,6,0,0" />
            <Path Data="{StaticResource Icon.AppMag}" Width="26" Height="26" Stretch="Uniform"
                  Stroke="{StaticResource Accent.0078D4}" StrokeThickness="2.17"
                  HorizontalAlignment="Right" VerticalAlignment="Top" />
          </Grid>
          <TextBlock Text="tebunko" Style="{StaticResource Text.22}" HorizontalAlignment="Center" Margin="0,10,0,0" />
          <Grid Width="260" Height="6" Margin="0,18,0,0">
            <Border CornerRadius="3" Background="{StaticResource Bg.EDF0F2}" />
            <Border x:Name="SplashProgress" CornerRadius="3" Background="{StaticResource Accent.0078D4}"
                    Width="170" HorizontalAlignment="Left" />
          </Grid>
          <TextBlock x:Name="SplashCaption" Text="起動中…" Style="{StaticResource Text.12.Muted}"
                     HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>

        <TextBlock x:Name="SplashVersion" Text="v1.2.0" Style="{StaticResource Text.11.Muted}"
                   Foreground="{StaticResource Disabled.9AA0A6}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" />
      </Grid>
    </Grid>
  </Border>
</Grid>
