        </DockPanel>
        <Rectangle Height="1" Fill="{StaticResource Line.E0E2E5}" Margin="0,2,0,8" />
        <TextBlock Text="Excel・Word・PowerPoint のファイルが対象です" Style="{StaticResource Text.11.Muted}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border x:Name="FastSearchTooltip" Visibility="Collapsed" Canvas.Left="900" Canvas.Top="118" MaxWidth="300" Style="{StaticResource Bubble}">
      <TextBlock x:Name="FastSearchTooltipText" Text="正規表現をオフにすると速く検索できます" Style="{StaticResource Text.Bubble}" />
    </Border>

    <Border x:Name="FullPathTooltip" Visibility="Collapsed" Canvas.Left="60" Canvas.Top="360" MaxWidth="420" Style="{StaticResource Bubble}">
      <TextBlock x:Name="FullPathTooltipText" Text="C:\Share\営業部\2024\見積もり\提案書_2024年度下期_大口顧客向け.xlsx" Style="{StaticResource Text.Bubble}" />
    </Border>

    <Border x:Name="ContextMenuPopup" Visibility="Collapsed" Canvas.Left="1000" Canvas.Top="645" Width="180"
            Background="{StaticResource Bg.FFFFFF}" BorderBrush="{StaticResource Border.D9DEE3}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.4}" Effect="{StaticResource Shadow.Small}" Padding="4">
      <StackPanel>
        <TextBlock Text="開く" Style="{StaticResource Text.12}" Padding="8,6" />
        <TextBlock Text="新規で開く" Style="{StaticResource Text.12}" Padding="8,6" />
        <TextBlock Text="読み取り専用で開く" Style="{StaticResource Text.12}" Padding="8,6" />
      </StackPanel>
    </Border>
  </Canvas>
</Grid>
