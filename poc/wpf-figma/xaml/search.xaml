<!-- 検索の主画面 1280x820。H を基準に、同じ骨組みを 22 枚の状態違いフレームに使い回す。
     dummy.ps1 / show.ps1 / compare.ps1 が、ここに挙げた x:Name の要素の
     Visibility・Text・Background 等をフレームごとに差し替える（「状態だけが違うフレームは、
     ダミーのデータを差し替えて出す」という計画の指示どおり）。 -->
<!-- 窓は最小 1024x640、既定 1280x820。レンダリングする側（show.ps1 / compare.ps1 /
     screenshots.ps1）が Measure / Arrange に渡すサイズで実際の大きさが決まるため、ここでは
     Width/Height を固定せず MinWidth/MinHeight だけ持たせる（figma_wpf_map.md
     「レイアウトとリサイズ」2026-10-03 指摘） -->
<Grid x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      MinWidth="1024" MinHeight="640" Background="#FFFFFF" ClipToBounds="True">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Grid.Resources>
  <Grid.RowDefinitions>
    <RowDefinition Height="32" />
    <RowDefinition Height="*" />
  </Grid.RowDefinitions>

  <!-- ===== タイトルバー ===== -->
  <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="{StaticResource Bg.F0F0F0}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="135" />
    </Grid.ColumnDefinitions>
    <!-- タイトルバーのアプリの印は 40x32 の青い地に白い印（diff_round2.md 2 回目指摘） -->
    <Border Grid.Column="0" Width="40" Height="32" Background="{StaticResource Accent.0078D4}">
      <Path Data="{StaticResource Icon.FileText}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource White}" StrokeThickness="1.3" />
    </Border>
    <TextBlock Grid.Column="1" Text="tebunko" Style="{StaticResource Text.13}" VerticalAlignment="Center" Margin="8,0,0,0" />
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <TextBlock Text="&#x2015;" Width="45" TextAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.13}" />
      <TextBlock Text="&#x25A1;" Width="45" TextAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Text.13}" />
      <Border Width="45">
        <Path Data="{StaticResource Icon.CircleX}" Width="13" Height="13" Stretch="Uniform"
              Stroke="{StaticResource Ink.212126}" StrokeThickness="1.08" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </StackPanel>
    <!-- タイトルバーの下の線（diff_round2.md 2 回目指摘） -->
    <Rectangle Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1" Fill="{StaticResource Border.Window}" />
  </Grid>

  <!-- ===== 本体（ナビ｜縦の仕切り｜本文） ===== -->
  <Grid x:Name="BodyGrid" Grid.Row="1">
    <Grid.ColumnDefinitions>
      <!-- 左の欄は固定。既定 220・最小 180・最大 360（figma_wpf_map.md「レイアウトとリサイズ」。
           ドラッグでの変更は今回は実装しない） -->
      <ColumnDefinition Width="220" MinWidth="180" MaxWidth="360" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===== ナビ ===== -->
    <Grid Grid.Column="0" Background="{StaticResource Bg.F0F2F4}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition x:Name="NavNoticeRow" Height="0" />
        <RowDefinition Height="1" />
        <RowDefinition Height="28" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <Border x:Name="NavItem_Search" Height="40" Background="{StaticResource Select.E5F1FB}" BorderThickness="3,0,0,0" BorderBrush="{StaticResource Accent.0078D4}">
          <DockPanel Margin="21,0,12,0">
            <TextBlock Text="検索" VerticalAlignment="Center" Style="{StaticResource Text.13}" Foreground="{StaticResource Accent.0078D4}" FontWeight="Bold" />
          </DockPanel>
        </Border>
        <Border x:Name="NavItem_Index" Height="40" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent">
          <DockPanel Margin="21,0,12,0">
            <StackPanel x:Name="NavBadge_Index" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
              <Ellipse x:Name="NavBadge_IndexDot" Width="6" Height="6" Fill="{StaticResource Accent.0078D4}" Margin="0,0,4,0" />
              <TextBlock x:Name="NavBadge_IndexText" Text="58%" Style="{StaticResource Text.11.Bold}" Foreground="{StaticResource Accent.0078D4}" />
            </StackPanel>
            <TextBlock Text="インデックス管理" VerticalAlignment="Center" Style="{StaticResource Text.13.Medium}" />
          </DockPanel>
        </Border>
        <Border x:Name="NavItem_Settings" Height="40" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent">
          <DockPanel Margin="21,0,12,0">
            <TextBlock Text="設定" VerticalAlignment="Center" Style="{StaticResource Text.13.Medium}" />
          </DockPanel>
        </Border>
        <Border x:Name="NavItem_OfficeStop" Height="40" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent">
          <DockPanel Margin="21,0,12,0">
            <TextBlock Text="Office の終了" VerticalAlignment="Center" Style="{StaticResource Text.13.Medium}" />
          </DockPanel>
        </Border>
      </StackPanel>

      <Rectangle Grid.Row="1" Fill="{StaticResource Line.E0E2E5}" />

      <DockPanel Grid.Row="2" Margin="21,10,12,4">
        <TextBlock Text="検索対象" Style="{StaticResource Text.12}" FontWeight="Bold" />
        <TextBlock x:Name="SearchTargetCountText" Text="3 / 4" Margin="6,0,0,0" Style="{StaticResource Text.11.Muted}" />
      </DockPanel>
      <StackPanel x:Name="SearchTargetLinksRow" Grid.Row="3" Orientation="Horizontal" Margin="21,0,12,8">
        <TextBlock x:Name="SelectAllLink" Text="すべて" Style="{StaticResource Text.11}" Foreground="{StaticResource Accent.0078D4}" />
        <TextBlock Text="　" Style="{StaticResource Text.11}" />
        <TextBlock x:Name="ClearAllLink" Text="解除" Style="{StaticResource Text.11}" Foreground="{StaticResource Accent.0078D4}" />
      </StackPanel>

      <Grid Grid.Row="4" Margin="21,0,12,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="SearchTargetSearchBoxBorder" Grid.Row="0" Height="26" CornerRadius="{StaticResource Radius.4}" Background="{StaticResource Bg.FFFFFF}" BorderBrush="{StaticResource Border.D9DEE3}" BorderThickness="1" Margin="0,0,0,8">
          <DockPanel Margin="7,0">
            <Path Data="{StaticResource Icon.Search}" Width="10" Height="10" Stretch="Uniform" Stroke="{StaticResource Disabled.9AA0A6}" StrokeThickness="0.83" Margin="0,0,5,0" />
            <TextBlock x:Name="SearchTargetSearchBox" Text="フォルダを探す" Style="{StaticResource Text.12.Muted}" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <Grid>
            <StackPanel x:Name="TreePanel">
              <!-- 営業部 -->
              <Border Height="26"><DockPanel Margin="0,0,0,0">
                <ToggleButton Style="{StaticResource TreeChevron}" IsChecked="True" />
                <CheckBox x:Name="TreeCheck_営業部" Style="{StaticResource CheckBox.Tree}" IsChecked="True" Margin="2,0,6,0" />
                <Path Data="{StaticResource Icon.Folder}" Width="14" Height="14" Stretch="Uniform"
                      Stroke="{StaticResource Folder.E8A020}" StrokeThickness="1.6" StrokeLineJoin="Round" Margin="0,0,5,0" />
                <TextBlock Text="営業部" VerticalAlignment="Center" Style="{StaticResource Text.12}" />
              </DockPanel></Border>
              <Border Height="26" Margin="16,0,0,0"><DockPanel>
                <Border Width="16" />
                <CheckBox x:Name="TreeCheck_A社" Style="{StaticResource CheckBox.Tree}" IsChecked="True" Margin="2,0,6,0" />
                <Path Data="{StaticResource Icon.Folder}" Width="14" Height="14" Stretch="Uniform"
                      Stroke="{StaticResource Folder.E8A020}" StrokeThickness="1.6" StrokeLineJoin="Round" Margin="0,0,5,0" />
                <TextBlock Text="A社" VerticalAlignment="Center" Style="{StaticResource Text.12}" />
              </DockPanel></Border>
              <Border Height="26" Margin="16,0,0,0"><DockPanel>
                <Border Width="16" />
                <CheckBox x:Name="TreeCheck_B社" Style="{StaticResource CheckBox.Tree}" IsChecked="True" Margin="2,0,6,0" />
                <Path Data="{StaticResource Icon.Folder}" Width="14" Height="14" Stretch="Uniform"
                      Stroke="{StaticResource Folder.E8A020}" StrokeThickness="1.6" StrokeLineJoin="Round" Margin="0,0,5,0" />
                <TextBlock Text="B社" VerticalAlignment="Center" Style="{StaticResource Text.12}" />
              </DockPanel></Border>
              <Border Height="26" Margin="16,0,0,0"><DockPanel>
                <Border Width="16" />
                <CheckBox x:Name="TreeCheck_提案書" Style="{StaticResource CheckBox.Tree}" IsChecked="True" Margin="2,0,6,0" />
                <Path Data="{StaticResource Icon.Folder}" Width="14" Height="14" Stretch="Uniform"
                      Stroke="{StaticResource Folder.E8A020}" StrokeThickness="1.6" StrokeLineJoin="Round" Margin="0,0,5,0" />
                <TextBlock Text="提案書_2024年度…" VerticalAlignment="Center" Style="{StaticResource Text.12}" TextTrimming="CharacterEllipsis" />
              </DockPanel></Border>
              <!-- 顧客 -->
              <Border Height="26"><DockPanel>
                <ToggleButton Style="{StaticResource TreeChevron}" IsChecked="True" />
                <CheckBox x:Name="TreeCheck_顧客" Style="{StaticResource CheckBox.Tree}" IsChecked="True" Margin="2,0,6,0" />
                <Path Data="{StaticResource Icon.Folder}" Width="14" Height="14" Stretch="Uniform"
                      Stroke="{StaticResource Folder.E8A020}" StrokeThickness="1.6" StrokeLineJoin="Round" Margin="0,0,5,0" />
                <TextBlock Text="顧客" VerticalAlignment="Center" Style="{StaticResource Text.12}" />
                <Ellipse x:Name="Dot_顧客" Width="6" Height="6" Fill="{StaticResource Folder.E8A020}" VerticalAlignment="Center" Margin="4,0,0,0" />
              </DockPanel></Border>
              <Border Height="26" Margin="16,0,0,0"><DockPanel>
                <Border Width="16" />
                <CheckBox x:Name="TreeCheck_取引先台帳" Style="{StaticResource CheckBox.Tree}" IsChecked="True" Margin="2,0,6,0" />
                <Path Data="{StaticResource Icon.Folder}" Width="14" Height="14" Stretch="Uniform"
                      Stroke="{StaticResource Folder.E8A020}" StrokeThickness="1.6" StrokeLineJoin="Round" Margin="0,0,5,0" />
                <TextBlock Text="取引先台帳" VerticalAlignment="Center" Style="{StaticResource Text.12}" />
              </DockPanel></Border>
              <Border Height="26" Margin="16,0,0,0"><DockPanel>
                <Border Width="16" />
                <CheckBox x:Name="TreeCheck_契約書" Style="{StaticResource CheckBox.Tree}" IsChecked="True" Margin="2,0,6,0" />
                <Path Data="{StaticResource Icon.Folder}" Width="14" Height="14" Stretch="Uniform"
                      Stroke="{StaticResource Folder.E8A020}" StrokeThickness="1.6" StrokeLineJoin="Round" Margin="0,0,5,0" />
                <TextBlock Text="契約書" VerticalAlignment="Center" Style="{StaticResource Text.12}" />
              </DockPanel></Border>
              <!-- 営業部2025 -->
              <Border Height="26"><DockPanel>
                <ToggleButton Style="{StaticResource TreeChevron}" IsChecked="True" />
                <CheckBox x:Name="TreeCheck_営業部2025" Style="{StaticResource CheckBox.Tree}" IsChecked="True" Margin="2,0,6,0" />
                <Path Data="{StaticResource Icon.Folder}" Width="14" Height="14" Stretch="Uniform"
                      Stroke="{StaticResource Folder.E8A020}" StrokeThickness="1.6" StrokeLineJoin="Round" Margin="0,0,5,0" />
                <TextBlock Text="営業部2025" VerticalAlignment="Center" Style="{StaticResource Text.12}" />
                <Ellipse x:Name="Dot_営業部2025" Width="6" Height="6" Fill="{StaticResource Accent.0078D4}" VerticalAlignment="Center" Margin="4,0,0,0" />
              </DockPanel></Border>
              <Border Height="26" Margin="16,0,0,0"><DockPanel>
                <Border Width="16" />
                <CheckBox x:Name="TreeCheck_見積もり" Style="{StaticResource CheckBox.Tree}" IsChecked="True" Margin="2,0,6,0" />
                <Path Data="{StaticResource Icon.Folder}" Width="14" Height="14" Stretch="Uniform"
                      Stroke="{StaticResource Folder.E8A020}" StrokeThickness="1.6" StrokeLineJoin="Round" Margin="0,0,5,0" />
                <TextBlock Text="見積もり" VerticalAlignment="Center" Style="{StaticResource Text.12}" />
              </DockPanel></Border>
              <Border Height="26" Margin="16,0,0,0"><DockPanel>
                <Border Width="16" />
                <CheckBox x:Name="TreeCheck_請求書" Style="{StaticResource CheckBox.Tree}" IsChecked="True" Margin="2,0,6,0" />
                <Path Data="{StaticResource Icon.Folder}" Width="14" Height="14" Stretch="Uniform"
                      Stroke="{StaticResource Folder.E8A020}" StrokeThickness="1.6" StrokeLineJoin="Round" Margin="0,0,5,0" />
                <TextBlock Text="請求書" VerticalAlignment="Center" Style="{StaticResource Text.12}" />
              </DockPanel></Border>
              <!-- アーカイブ（折りたたみ・未選択） -->
              <Border Height="26"><DockPanel>
                <ToggleButton Style="{StaticResource TreeChevron}" IsChecked="False" />
                <CheckBox x:Name="TreeCheck_アーカイブ" Style="{StaticResource CheckBox.Tree}" IsChecked="False" Margin="2,0,6,0" />
                <Path Data="{StaticResource Icon.FolderClosed}" Width="14" Height="14" Stretch="Uniform"
                      Stroke="{StaticResource Folder.E8A020}" StrokeThickness="1.6" StrokeLineJoin="Round" Margin="0,0,5,0" />
                <TextBlock Text="アーカイブ" VerticalAlignment="Center" Style="{StaticResource Text.12}" />
                <Ellipse x:Name="Dot_アーカイブ" Width="6" Height="6" Fill="{StaticResource Danger.D13438}" VerticalAlignment="Center" Margin="4,0,0,0" />
              </DockPanel></Border>
            </StackPanel>
            <StackPanel x:Name="EmptyTreeState" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,40,0,0">
              <Path Data="{StaticResource Icon.FolderEmptyState}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center"
                    Stroke="{StaticResource Folder.E8A020}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              <TextBlock Text="検索できるフォルダがありません" Style="{StaticResource Text.12.Muted}" Margin="0,8,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>

      <DockPanel x:Name="NavNotice" Grid.Row="5" Margin="21,0,12,8" Visibility="Collapsed">
        <Path Data="{StaticResource Icon.Info}" Width="11" Height="11" Stretch="Uniform" Stroke="{StaticResource Disabled.9AA0A6}" StrokeThickness="0.92" Margin="0,0,5,0" VerticalAlignment="Center" />
        <TextBlock Text="検索するフォルダを選んでください" VerticalAlignment="Center" Style="{StaticResource Text.11.Muted}" TextWrapping="Wrap" />
      </DockPanel>

      <Rectangle Grid.Row="6" Fill="{StaticResource Line.E0E2E5}" />
      <DockPanel Grid.Row="7" Margin="21,0,12,0">
        <Path Data="{StaticResource Icon.Info}" Width="11" Height="11" Stretch="Uniform" Stroke="{StaticResource Disabled.9AA0A6}" StrokeThickness="0.92" Margin="0,0,5,0" VerticalAlignment="Center" />
        <TextBlock Text="バージョン情報" VerticalAlignment="Center" Style="{StaticResource Text.11.Muted}" />
      </DockPanel>
    </Grid>

    <!-- 左の欄の境（diff_round2.md 2 回目指摘） -->
    <Rectangle Grid.Column="1" Fill="{StaticResource Border.D0D4D9}" />

    <!-- ===== 本文 ===== -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="TopBannerRow" Height="0" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1" />
        <RowDefinition Height="Auto" />
        <!-- 結果一覧。窓が低くても最小の高さ 120 を保つ（figma_wpf_map.md「レイアウトとリサイズ」） -->
        <RowDefinition Height="*" MinHeight="120" />
        <RowDefinition Height="8" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" MinHeight="120" />
        <RowDefinition Height="28" />
      </Grid.RowDefinitions>

      <!-- バナー（更新中・中断・検索結果の状態のお知らせ）。既定は高さ 0 で非表示。
           主な領域の幅（ナビの右側だけ）で検索バーより上に置く。角は四角、左に 4px の色の帯（diff_round2.md 2 回目指摘） -->
      <Border x:Name="Banner" Grid.Row="0" BorderThickness="0,0,0,1"
              Background="{StaticResource Select.E1F2FF}" BorderBrush="{StaticResource Border.D9DEE3}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Rectangle x:Name="BannerAccent" Grid.Column="0" Fill="{StaticResource Accent.0078D4}" />
          <DockPanel Grid.Column="1" Margin="12,8,12,8">
            <Button x:Name="BannerButton" DockPanel.Dock="Right" Style="{StaticResource Btn.BannerAccent}" Content="進み具合を見る" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Grid Width="14" Height="14" Margin="0,0,8,0">
                <Ellipse x:Name="BannerIcon" Fill="{StaticResource Accent.0078D4}" />
                <Path x:Name="BannerGlyph" Data="{StaticResource Icon.BadgeGlyphInfo}" Width="8.4" Height="8.4" Stretch="Uniform"
                      Stroke="{StaticResource White}" StrokeThickness="0.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Grid>
              <TextBlock x:Name="BannerText" Text="インデックスを更新しています（営業部 1,200 / 2,075 件）" Style="{StaticResource Text.12}" />
            </StackPanel>
          </DockPanel>
        </Grid>
      </Border>

      <!-- 検索ワード -->
      <StackPanel Grid.Row="1">
        <DockPanel Margin="16,10,16,8">
          <TextBlock Text="検索ワード" VerticalAlignment="Center" Width="68" Style="{StaticResource Text.12}" />
          <Button x:Name="SearchButton" DockPanel.Dock="Right" Width="80" Style="{StaticResource Btn.Primary}" Content="検索" FontWeight="Bold" Margin="8,0,0,0" />
          <TextBox x:Name="SearchWordBox" Text="（株）山田商事" Height="30" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel x:Name="SearchWordError" Visibility="Collapsed" Margin="84,0,16,8" LastChildFill="True">
          <!-- Figma の赤い circle-alert（diff_round2.md 2 回目指摘。前回は三角だった） -->
          <Grid Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Top">
            <Ellipse Fill="{StaticResource Danger.D13438}" />
            <Path Data="{StaticResource Icon.BadgeGlyphWarn}" Width="6.6" Height="6.6" Stretch="Uniform"
                  Stroke="{StaticResource White}" StrokeThickness="0.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Grid>
          <TextBlock Style="{StaticResource Text.11}" Foreground="{StaticResource Danger.D13438}" TextWrapping="Wrap"
                     Text="正規表現が正しくありません（閉じていない括弧があります）" />
        </DockPanel>
      </StackPanel>

      <!-- 絞り込み -->
      <DockPanel x:Name="FilterRow" Grid.Row="2" Margin="16,0,16,8" VerticalAlignment="Center" LastChildFill="False">
        <Border x:Name="FastSearchBadge" DockPanel.Dock="Right" Style="{StaticResource StatusBadge}" Background="{StaticResource Ok.E0F7E0}" BorderBrush="{StaticResource Ok.218A21}">
          <StackPanel Orientation="Horizontal">
            <Path x:Name="FastSearchIcon" Data="{StaticResource Icon.Zap}" Width="12" Height="12" Stretch="Uniform"
                  Stroke="{StaticResource Ok.218A21}" StrokeThickness="1.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,4,0" />
            <TextBlock x:Name="FastSearchText" Text="高速検索：使用可" Style="{StaticResource Text.11}" Foreground="{StaticResource Ok.218A21}" />
            <Path x:Name="FastSearchInfo" Data="{StaticResource Icon.Info}" Width="10" Height="10" Stretch="Uniform" Stroke="{StaticResource Ok.218A21}" StrokeThickness="0.83" Margin="4,0,0,0" Visibility="Collapsed" />
          </StackPanel>
        </Border>
        <CheckBox x:Name="RegexCheck" Style="{StaticResource CheckBox.Label}" DockPanel.Dock="Right" Content="正規表現" VerticalAlignment="Center" Margin="0,0,16,0" />
        <CheckBox x:Name="CaseCheck" Style="{StaticResource CheckBox.Label}" DockPanel.Dock="Right" Content="大文字・小文字を区別" VerticalAlignment="Center" Margin="0,0,16,0" />
        <Border x:Name="FilterChip_Excel" DockPanel.Dock="Left" Style="{StaticResource Chip}" Background="{StaticResource Select.E5F1FB}" BorderBrush="{StaticResource Accent.0078D4}" Margin="0,0,6,0">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource Icon.Check}" Width="10" Height="10" Stretch="Uniform" Stroke="{StaticResource Accent.0078D4}" StrokeThickness="0.83" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,3,0" />
            <TextBlock Text="Excel" Style="{StaticResource Text.11}" Foreground="{StaticResource Accent.0078D4}" />
          </StackPanel>
        </Border>
        <Border x:Name="FilterChip_Word" DockPanel.Dock="Left" Style="{StaticResource Chip}" Background="{StaticResource Select.E5F1FB}" BorderBrush="{StaticResource Accent.0078D4}" Margin="0,0,6,0">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource Icon.Check}" Width="10" Height="10" Stretch="Uniform" Stroke="{StaticResource Accent.0078D4}" StrokeThickness="0.83" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,3,0" />
            <TextBlock Text="Word" Style="{StaticResource Text.11}" Foreground="{StaticResource Accent.0078D4}" />
          </StackPanel>
        </Border>
        <Border x:Name="FilterChip_PowerPoint" DockPanel.Dock="Left" Style="{StaticResource Chip}" Background="{StaticResource Select.E5F1FB}" BorderBrush="{StaticResource Accent.0078D4}" Margin="0,0,6,0">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource Icon.Check}" Width="10" Height="10" Stretch="Uniform" Stroke="{StaticResource Accent.0078D4}" StrokeThickness="0.83" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,3,0" />
            <TextBlock Text="PowerPoint" Style="{StaticResource Text.11}" Foreground="{StaticResource Accent.0078D4}" />
          </StackPanel>
        </Border>
        <Border x:Name="FilterChip_Text" DockPanel.Dock="Left" Style="{StaticResource Chip}" Background="{StaticResource Select.E5F1FB}" BorderBrush="{StaticResource Accent.0078D4}" Margin="0,0,12,0">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource Icon.Check}" Width="10" Height="10" Stretch="Uniform" Stroke="{StaticResource Accent.0078D4}" StrokeThickness="0.83" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,3,0" />
            <TextBlock Text="テキスト" Style="{StaticResource Text.11}" Foreground="{StaticResource Accent.0078D4}" />
          </StackPanel>
        </Border>
        <Button x:Name="RangeButton" DockPanel.Dock="Left" Style="{StaticResource Btn.Outline}" Height="26" Padding="10,2,10,2" Margin="0,0,16,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="RangeButtonText" Text="探す範囲" Style="{StaticResource Text.11}" />
            <Path Data="{StaticResource Icon.ChevronDown}" Width="10" Height="10" Stretch="Uniform" Stroke="{StaticResource Ink.202124}" StrokeThickness="0.83" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="4,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
