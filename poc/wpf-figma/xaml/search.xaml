        <DockPanel x:Name="PreviewToolbar" Margin="16,0,16,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="PreviewOpenBody" Style="{StaticResource Btn.OpenSplitBody}" Content="開く" />
            <Button x:Name="PreviewOpenArrow" Style="{StaticResource Btn.OpenSplitArrow}">
              <Path Data="{StaticResource Icon.ChevronDown}" Width="10" Height="10" Stretch="Uniform" Stroke="{StaticResource Accent.0078D4}" StrokeThickness="0.83" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Button>
            <TextBlock x:Name="PreviewOpenFolderLink" Text="フォルダを開く" TextDecorations="Underline" Style="{StaticResource Text.12}" Foreground="{StaticResource Accent.0078D4}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>
          <TextBlock x:Name="PreviewBreadcrumbText" Text="営業部\A社_見積書.xlsx ・ [シート]見積書!A3 ・ セル" Style="{StaticResource Text.12.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>
      <!-- 表の左端は枠に付ける（左の余白を 0 にする。diff_round5.md 2） -->
      <Grid x:Name="PreviewContentHost" Grid.Row="8" Margin="0,0,16,8">
        <!-- Excel のような罫線の格子。列幅は固定（約 220）で A〜D を出し、入らなければ横にスクロールする
             （全幅には引き伸ばさない。diff_round3.md 2） -->
        <ScrollViewer x:Name="PreviewSheetScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid x:Name="PreviewSheetGrid" Background="{StaticResource Bg.FFFFFF}" HorizontalAlignment="Left">
          <!-- 列幅: A は 220、B〜D は 200（diff_round6.md 4） -->
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="200" />
          </Grid.ColumnDefinitions>
          <!-- 行の高さ 22、セルの文字 10〜11px（diff_round4.md 5）。
               選んだ行を真ん中にして、前後 2 行ずつの 5 行を出す（diff_round5.md 1） -->
          <Grid.RowDefinitions>
            <RowDefinition Height="22" />
            <RowDefinition Height="22" />
            <RowDefinition Height="22" />
            <RowDefinition Height="22" />
            <RowDefinition Height="22" />
            <RowDefinition Height="22" />
          </Grid.RowDefinitions>

          <!-- 列見出し行（地 Bg.F3F3F4、左寄せ・左余白 8。diff_round5.md 2） -->
          <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Background="{StaticResource Bg.F3F3F4}" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,0,1" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="A" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="B" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="3" Text="C" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="4" Text="D" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center" />

          <!-- 行番号の列の地（Bg.F3F3F4）。選んだ行だけ Select.E1F2FF を上から重ねる（diff_round5.md 2） -->
          <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Bg.F3F3F4}" />
          <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource Bg.F3F3F4}" />
          <Border Grid.Row="3" Grid.Column="0" Background="{StaticResource Bg.F3F3F4}" />
          <Border Grid.Row="4" Grid.Column="0" Background="{StaticResource Bg.F3F3F4}" />
          <Border Grid.Row="5" Grid.Column="0" Background="{StaticResource Bg.F3F3F4}" />

          <!-- 罫線の格子（セルごとに右と下に線を引く。行番号の列も含む） -->
          <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,0,1" />
          <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,0,1" />
          <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,0,1" />
          <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,0,1" />
          <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,0,1" />
          <Border Grid.Row="0" Grid.RowSpan="6" Grid.Column="1" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,1,0" />
          <Border Grid.Row="0" Grid.RowSpan="6" Grid.Column="2" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,1,0" />
          <Border Grid.Row="0" Grid.RowSpan="6" Grid.Column="3" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,1,0" />
          <Border Grid.Row="0" Grid.RowSpan="6" Grid.Column="4" BorderBrush="{StaticResource Line.E0E2E5}" BorderThickness="0,0,1,0" />

          <!-- 選んだ行を真ん中（Grid.Row=3）にして、前後 2 行ずつの計 5 行を出す（diff_round5.md 1） -->
          <TextBlock x:Name="PreviewTopRowNum" Grid.Row="1" Grid.Column="0" Text="1" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock x:Name="PreviewTopText1" Grid.Row="1" Grid.Column="1" Text="取引規模" Style="{StaticResource Text.11}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock x:Name="PreviewTopText2" Grid.Row="1" Grid.Column="2" Text="Aクラス" Style="{StaticResource Text.11}" Margin="4,0" VerticalAlignment="Center" />

          <!-- 選んだ行の 1 つ上（既定では内容が無い行。diff_round5.md 1） -->
          <TextBlock x:Name="PreviewMidRowNum" Grid.Row="2" Grid.Column="0" Text="2" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock x:Name="PreviewMidText1" Grid.Row="2" Grid.Column="1" Text="" Style="{StaticResource Text.11}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock x:Name="PreviewMidText2" Grid.Row="2" Grid.Column="2" Text="" Style="{StaticResource Text.11}" Margin="4,0" VerticalAlignment="Center" />

          <!-- 一致した行。選んだ行は Select.E1F2FF、一致したセルの地は Match.FFF3CD（diff_round3.md 2） -->
          <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Background="{StaticResource Select.E1F2FF}" />
          <Border x:Name="PreviewHighlightCellA" Grid.Row="3" Grid.Column="1" Background="{StaticResource Match.FFF3CD}" />
          <Border x:Name="PreviewHighlightCellD" Grid.Row="3" Grid.Column="4" Background="{StaticResource Match.FFF3CD}" Visibility="Collapsed" />
          <TextBlock x:Name="PreviewHighlightRowNum" Grid.Row="3" Grid.Column="0" Text="3" Style="{StaticResource Text.11.Muted}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock x:Name="PreviewHighlightText1" Grid.Row="3" Grid.Column="1" Text="見積先：(株)山田商事(御中)" Style="{StaticResource Text.11}" FontWeight="Bold" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock x:Name="PreviewHighlightText2" Grid.Row="3" Grid.Column="2" Text="見積番号：12-2324-0143" Style="{StaticResource Text.11}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock x:Name="PreviewHighlightTextD" Grid.Row="3" Grid.Column="4" Style="{StaticResource Text.11}" FontWeight="Bold" Margin="4,0" VerticalAlignment="Center" />

          <TextBlock x:Name="PreviewBottomRowNum" Grid.Row="4" Grid.Column="0" Text="4" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock x:Name="PreviewBottomText1" Grid.Row="4" Grid.Column="1" Text="件名：基幹システム導入一式" Style="{StaticResource Text.11}" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock x:Name="PreviewBottomText2" Grid.Row="4" Grid.Column="2" Text="発行日：2024/10/15" Style="{StaticResource Text.11}" Margin="4,0" VerticalAlignment="Center" />

          <!-- 空の行（続きがあることを示す） -->
          <TextBlock x:Name="PreviewExtraRowNum" Grid.Row="5" Grid.Column="0" Text="5" Style="{StaticResource Text.11.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        </ScrollViewer>
        <!-- H-W の本文。見出しは太字、2 行目に「2 振込手数料…」を足す（diff_round3.md 10）。
             余白は左 24・上 24（diff_round6.md 3） -->
        <StackPanel x:Name="PreviewParagraphView" Visibility="Collapsed" Margin="24">
          <TextBlock x:Name="PreviewParagraphHeading" Style="{StaticResource Text.13}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock x:Name="PreviewParagraphText" Style="{StaticResource Text.13}" TextWrapping="Wrap" />
          <TextBlock x:Name="PreviewParagraphText2" Style="{StaticResource Text.13}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <TextBlock x:Name="PreviewEmptyState" Visibility="Collapsed" Text="結果の表で行を選ぶと、ここにその前後の行を表示します。" Style="{StaticResource Text.12.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>

      <Border Grid.Row="9" Background="{StaticResource Bg.F3F3F4}">
        <TextBlock x:Name="StatusBarText" Text="検索しました：(株)山田商事 14 件" Style="{StaticResource Text.11.Muted}" VerticalAlignment="Center" Margin="16,0,0,0" />
      </Border>
    </Grid>
  </Grid>

  <!-- ===== 重ねの層（ポップオーバー・吹き出し・メニュー。Canvas で絶対位置に置く） ===== -->
  <Canvas x:Name="OverlayLayer" Grid.RowSpan="3" IsHitTestVisible="False">
    <Border x:Name="RangePopup" Visibility="Collapsed" Canvas.Left="790" Canvas.Top="120" Width="270"
            Background="{StaticResource Bg.FFFFFF}" BorderBrush="{StaticResource Border.D9DEE3}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.4}" Effect="{StaticResource Shadow.Small}" Padding="12">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <CheckBox Style="{StaticResource CheckBox.Tree}" IsChecked="True" IsEnabled="False" />
          <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource Font.UI}">
            <Run Text="本文" FontSize="12" Foreground="{StaticResource Ink.6B737D}" />
            <Run Text="　（常に対象）" FontSize="11" Foreground="{StaticResource Ink.6B737D}" />
          </TextBlock>
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
          <CheckBox x:Name="RangeCheck_Shape" Style="{StaticResource CheckBox.Tree}" IsChecked="True" />
          <TextBlock Text="図形" Margin="8,0,0,0" Style="{StaticResource Text.12}" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
          <CheckBox x:Name="RangeCheck_Comment" Style="{StaticResource CheckBox.Tree}" IsChecked="True" />
          <TextBlock Text="コメント" Margin="8,0,0,0" Style="{StaticResource Text.12}" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
          <CheckBox x:Name="RangeCheck_Note" Style="{StaticResource CheckBox.Tree}" IsChecked="True" />
          <TextBlock Text="ノート（PowerPoint）" Margin="8,0,0,0" Style="{StaticResource Text.12}" VerticalAlignment="Center" />
        </DockPanel>
        <Rectangle Height="1" Fill="{StaticResource Line.E0E2E5}" Margin="0,2,0,8" />
        <!-- 1 行に収める（diff_round3.md 12・小） -->
        <TextBlock Text="Excel・Word・PowerPoint のファイルが対象です" Style="{StaticResource Text.11.Muted}" TextWrapping="NoWrap" />
      </StackPanel>
    </Border>

    <Border x:Name="FastSearchTooltip" Visibility="Collapsed" Canvas.Left="900" Canvas.Top="118" MaxWidth="300" Style="{StaticResource Bubble}">
      <TextBlock x:Name="FastSearchTooltipText" Text="正規表現をオフにすると速く検索できます" Style="{StaticResource Text.Bubble}" />
    </Border>

    <Border x:Name="FullPathTooltip" Visibility="Collapsed" Canvas.Left="60" Canvas.Top="360" MaxWidth="420" Style="{StaticResource Bubble}">
      <TextBlock x:Name="FullPathTooltipText" Text="C:\Share\営業部\2024\見積もり\提案書_2024年度下期_大口顧客向け.xlsx" Style="{StaticResource Text.Bubble}" />
    </Border>

  </Canvas>

  <!-- 開くメニュー。Popup にし、PlacementTarget をボタン（PreviewOpenArrow）にして、
       その下に付けて出す（今はどの窓幅でも正しい位置に出る。diff_round3.md 3 ★） -->
  <Popup x:Name="ContextMenuPopup" IsOpen="False" AllowsTransparency="True" PopupAnimation="None" StaysOpen="True"
         PlacementTarget="{Binding ElementName=PreviewOpenArrow}" Placement="Bottom" HorizontalOffset="-140" VerticalOffset="2">
    <Border Width="180" Background="{StaticResource Bg.FFFFFF}" BorderBrush="{StaticResource Border.D9DEE3}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.4}" Effect="{StaticResource Shadow.Small}">
      <StackPanel>
        <!-- 項目は高さ 24・小さい文字（Micro＝Text.11。diff_round5.md 2） -->
        <Border Height="24" Padding="8,0">
          <TextBlock Text="開く" Style="{StaticResource Text.11}" VerticalAlignment="Center" />
        </Border>
        <Rectangle Height="1" Fill="{StaticResource Line.E0E2E5}" />
        <Border Height="24" Padding="8,0">
          <TextBlock Text="新規で開く" Style="{StaticResource Text.11}" VerticalAlignment="Center" />
        </Border>
        <Rectangle Height="1" Fill="{StaticResource Line.E0E2E5}" />
        <Border Height="24" Padding="8,0">
          <TextBlock Text="読み取り専用で開く" Style="{StaticResource Text.11}" VerticalAlignment="Center" />
        </Border>
      </StackPanel>
    </Border>
  </Popup>
</Grid>
