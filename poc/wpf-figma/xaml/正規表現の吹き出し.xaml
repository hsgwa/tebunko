<!-- 正規表現の吹き出し 300x28。単独の吹き出し（ツールチップ）だけの見本。 -->
<Grid x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="300" Height="28" Background="#FFFFFF">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Grid.Resources>
  <Border Style="{StaticResource Bubble}" Width="300" Height="28">
    <TextBlock Text="正規表現をオフにすると速く検索できます" Style="{StaticResource Text.Bubble}" HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Border>
</Grid>
