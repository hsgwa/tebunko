  <!-- ============ ボタン（主・危険・枠・開く＋分割） ============ -->
  <Style x:Key="Btn.Base" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="{StaticResource Pad.Button}" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource Radius.4}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
            </Trigger>
            <!-- 使えないときは地 #E8EAED、文字 #9FA4AA にする（diff_round3.md 7。H-E・E12 の検索ボタンなど） -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Disabled.E8EAED}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Disabled.E8EAED}" />
              <Setter TargetName="Bd" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="{StaticResource Disabled.9FA4AA}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{StaticResource Accent.0078D4}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
    <Setter Property="Foreground" Value="{StaticResource White}" />
  </Style>
  <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{StaticResource Danger.D13438}" />
    <Setter Property="BorderBrush" Value="{StaticResource Danger.D13438}" />
    <Setter Property="Foreground" Value="{StaticResource White}" />
  </Style>
  <Style x:Key="Btn.Outline" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{StaticResource Bg.FFFFFF}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border.D9DEE3}" />
    <Setter Property="Foreground" Value="{StaticResource Ink.202124}" />
  </Style>
  <!-- バナーの中のボタン。帯の色の枠と、帯の色の太字にする（diff_round2.md 2 回目指摘） -->
  <Style x:Key="Btn.BannerAccent" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{StaticResource Bg.FFFFFF}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
    <Setter Property="Foreground" Value="{StaticResource Accent.0078D4}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- 「開く ▾」分割ボタン。本体を押すと開く、▾ で候補（本体の枠線を共有する 1 つの Border にする）。
       左半分（本体）は薄い青の地、青い枠・青い文字にする（diff_round6.md 6・小） -->
  <Style x:Key="Btn.OpenSplitBody" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{StaticResource Select.E5F1FB}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
    <Setter Property="Foreground" Value="{StaticResource Accent.0078D4}" />
    <!-- 高さ 24（diff_round5.md 2） -->
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="16,4,10,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1,1,0,1" CornerRadius="4,0,0,4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- 「開く」単独ボタン（▾ なし。H-W など分割にしない見本で使う）。
       地は薄い青、高さ 24（diff_round7.md 3・小） -->
  <Style x:Key="Btn.OpenPlain" TargetType="Button" BasedOn="{StaticResource Btn.Outline}">
    <Setter Property="Background" Value="{StaticResource Select.E5F1FB}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
    <Setter Property="Foreground" Value="{StaticResource Accent.0078D4}" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="16,4,16,4" />
  </Style>
  <Style x:Key="Btn.OpenSplitArrow" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{StaticResource Bg.FFFFFF}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
    <Setter Property="Foreground" Value="{StaticResource Accent.0078D4}" />
    <!-- 高さ 24（diff_round5.md 2） -->
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="7,4,10,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="0,4,4,0" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ チェックボックス（中間状態＝ツリーの親の一部選択を含む） ============ -->
  <Style x:Key="CheckBox.Tree" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Box" Width="16" Height="16" CornerRadius="{StaticResource Radius.3}"
                  Background="{StaticResource Bg.FFFFFF}" BorderBrush="{StaticResource Border.D0D4D9}" BorderThickness="1">
            <Grid>
              <Path x:Name="Check" Visibility="Collapsed" Stretch="Uniform" Margin="3"
                    Stroke="{StaticResource White}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="{StaticResource Icon.Check}" />
              <Rectangle x:Name="Mid" Visibility="Collapsed" Width="8" Height="2" RadiusX="1" RadiusY="1"
                         Fill="{StaticResource White}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent.0078D4}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent.0078D4}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
              <Setter TargetName="Mid" Property="Visibility" Value="Visible" />
            </Trigger>
            <!-- 薄い青地にチェックを残す（Figma node 108:572）。チェック済み・操作不可の行（本文など。
                 diff_round3.md 12・小） -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True" />
                <Condition Property="IsEnabled" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Select.E5F1FB}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              <Setter TargetName="Check" Property="Stroke" Value="{StaticResource Accent.0078D4}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ ラベル付きチェックボックス（正規表現・大文字小文字など）。
       オンのとき地を青く塗り白い check、文字も青にする（diff_round2.md 2 回目指摘） ============ -->
  <Style x:Key="CheckBox.Label" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource Ink.202124}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="Box" Width="14" Height="14" CornerRadius="{StaticResource Radius.3}" Margin="0,0,5,0"
                    Background="{StaticResource Bg.FFFFFF}" BorderBrush="{StaticResource Border.D0D4D9}" BorderThickness="1">
              <Path x:Name="Check" Visibility="Collapsed" Stretch="Uniform" Margin="2.5"
                    Stroke="{StaticResource White}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="{StaticResource Icon.Check}" />
            </Border>
            <ContentPresenter x:Name="Cp" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent.0078D4}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource Accent.0078D4}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ File Kind Chip（ファイルの種類の絞り込み） ============ -->
  <!-- 丸い pill にする（diff_round2.md 2 回目指摘。前回は角丸 4px の四角だった） -->
  <CornerRadius x:Key="Radius.Pill">12</CornerRadius>
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4,8,4" />
  </Style>

  <!-- ============ Nav Badge（左ナビの数・ドットの印） ============ -->
  <Style x:Key="NavBadge.Count" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Bg.F3F3F4}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="6,1,6,1" />
  </Style>
  <Style x:Key="NavBadge.Dot" TargetType="Ellipse">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
  </Style>

  <!-- ============ Status Badge / Fast Search Indicator（3 状態） ============ -->
  <Style x:Key="StatusBadge" TargetType="Border">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,2,8,2" />
  </Style>

  <!-- ============ 吹き出し（ツールチップ風。ダーク地） ============ -->
  <Style x:Key="Bubble" TargetType="Border">
    <Setter Property="Background" Value="#333840" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.4}" />
    <Setter Property="Padding" Value="10,7,10,7" />
    <Setter Property="Effect" Value="{StaticResource Shadow.Small}" />
  </Style>
  <Style x:Key="Text.Bubble" TargetType="TextBlock" BasedOn="{StaticResource Text.12}">
    <Setter Property="Foreground" Value="{StaticResource White}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ============ ツールチップ（暗い地） ============ -->
  <!-- round11 項目3。overlays.md「ツールチップ（暗い地）の Style」。正規表現・ツリーの行の
       フルパス・ステータスバー・高速検索のバッジなどに使う。 -->
  <Style x:Key="Tooltip.Dark" TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource Tip.Bg}" />
    <Setter Property="Foreground" Value="{StaticResource Tip.Ink}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6,10,6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,0,6,6">
            <Border.Effect>
              <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.2" Color="#000000" />
            </Border.Effect>
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Banner（info/success/warning） ============ -->
  <Style x:Key="Banner" TargetType="Border">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.4}" />
    <Setter Property="Padding" Value="12,8,12,8" />
  </Style>

  <!-- ============ Inline Error（赤枠＋赤アイコン文字） ============ -->
  <Style x:Key="TextBox.Base" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Background" Value="{StaticResource Bg.FFFFFF}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border.D9DEE3}" />
    <Setter Property="Foreground" Value="{StaticResource Ink.202124}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource Radius.4}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
