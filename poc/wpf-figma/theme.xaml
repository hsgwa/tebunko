  <Style x:Key="Icon.InfoGlyph.S12.Style" TargetType="Path">
    <Setter Property="Data" Value="{StaticResource Icon.InfoGlyph.S12}" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
