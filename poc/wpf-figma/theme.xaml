<!-- poc/wpf-figma のトークン・部品定義。
     本体の scripts/shared/xaml/theme.xaml とは別物（読み込まない）。
     Figma は Variables・Styles が 0（直接の値）なので、材料の値をそのまま使い、近い値もまとめずに別のキーにする。
     欧文フォント（Rethink Sans）は show.ps1 / compare.ps1 が起動時に Font.UI を
     "file:///<fonts>/#Rethink Sans, Yu Gothic UI" で上書きする（インストールしない）。
     ここでの既定値は Yu Gothic UI（フォントファイルを読む前のフォールバック）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <FontFamily x:Key="Font.UI">Yu Gothic UI</FontFamily>

  <!-- ============ 色（Figma の値そのまま。用途が近くても値が違えば別キー） ============ -->
  <SolidColorBrush x:Key="Ink.202124" Color="#202124" />
  <SolidColorBrush x:Key="Ink.212126" Color="#212126" />
  <SolidColorBrush x:Key="Ink.5F6368" Color="#5F6368" />
  <SolidColorBrush x:Key="Ink.6B737D" Color="#6B737D" />
  <SolidColorBrush x:Key="Accent.0078D4" Color="#0078D4" />
  <SolidColorBrush x:Key="Bg.FFFFFF" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Bg.F0F2F4" Color="#F0F2F4" />
  <SolidColorBrush x:Key="Bg.F3F3F4" Color="#F3F3F4" />
  <SolidColorBrush x:Key="Bg.F0F0F0" Color="#F0F0F0" />
  <SolidColorBrush x:Key="Bg.EDF0F2" Color="#EDF0F2" />
  <SolidColorBrush x:Key="Bg.F5F7FA" Color="#F5F7FA" />
  <SolidColorBrush x:Key="Bg.FAFBFC" Color="#FAFBFC" />
  <!-- 結果一覧のファイルの行（畳んだ）の地。開いた行は Bg.F5F7FA（diff_round2.md 2 回目指摘） -->
  <SolidColorBrush x:Key="Bg.F9FAFA" Color="#F9FAFA" />
  <!-- 結果一覧の、場所のバッジ（パス表示）の灰色の地（diff_round2.md 2 回目指摘） -->
  <SolidColorBrush x:Key="Bg.PathBadge" Color="#EEF0F2" />
  <SolidColorBrush x:Key="Select.E1F2FF" Color="#E1F2FF" />
  <SolidColorBrush x:Key="Select.E5F1FB" Color="#E5F1FB" />
  <SolidColorBrush x:Key="Line.E0E2E5" Color="#E0E2E5" />
  <SolidColorBrush x:Key="Border.D9DEE3" Color="#D9DEE3" />
  <SolidColorBrush x:Key="Border.D0D4D9" Color="#D0D4D9" />
  <SolidColorBrush x:Key="Ok.218A21" Color="#218A21" />
  <SolidColorBrush x:Key="Ok.E0F7E0" Color="#E0F7E0" />
  <SolidColorBrush x:Key="Warn.BA7D00" Color="#BA7D00" />
  <SolidColorBrush x:Key="Warn.FFF5E0" Color="#FFF5E0" />
  <SolidColorBrush x:Key="Danger.D13438" Color="#D13438" />
  <SolidColorBrush x:Key="Danger.FFE6E6" Color="#FFE6E6" />
  <SolidColorBrush x:Key="Chip.0B5CAD" Color="#0B5CAD" />
  <SolidColorBrush x:Key="Hit.FFF176" Color="#FFF176" />
  <!-- プレビューの一致セルの地色（一覧側の一致ハイライト Hit.FFF176 とは別の値。diff_round2.md 2 回目指摘） -->
  <SolidColorBrush x:Key="Match.FFF3CD" Color="#FFF3CD" />
  <!-- タイトルバー下・ステータスバー地などの枠色（diff_round2.md 2 回目指摘） -->
  <SolidColorBrush x:Key="Border.Window" Color="#999999" />
  <SolidColorBrush x:Key="Folder.E8A020" Color="#E8A020" />
  <SolidColorBrush x:Key="Excel.107C41" Color="#107C41" />
  <!-- figma_theme_tokens.md の File/Word・File/PowerPoint に合わせて追加（前は Accent.0078D4・直書きの #B7472A を仮で使っていた） -->
  <SolidColorBrush x:Key="Word.185ABD" Color="#185ABD" />
  <SolidColorBrush x:Key="PowerPoint.C43E1C" Color="#C43E1C" />
  <!-- figma_wpf_map.md の Illust.Line（H0 のイラスト illust_first_run.svg の線色） -->
  <SolidColorBrush x:Key="Illust.D1D6DE" Color="#D1D6DE" />
  <SolidColorBrush x:Key="Disabled.99A1AB" Color="#99A1AB" />
  <SolidColorBrush x:Key="Disabled.9AA0A6" Color="#9AA0A6" />
  <SolidColorBrush x:Key="Disabled.8C949E" Color="#8C949E" />
  <!-- 使えないボタンの地・文字（diff_round3.md 7。使えない［検索］は地 #E8EAED、文字 #9FA4AA） -->
  <SolidColorBrush x:Key="Disabled.E8EAED" Color="#E8EAED" />
  <SolidColorBrush x:Key="Disabled.9FA4AA" Color="#9FA4AA" />
  <SolidColorBrush x:Key="White" Color="#FFFFFF" />

  <!-- ============ 余白・間隔・角丸 ============ -->
  <Thickness x:Key="Pad.0808" >0,8,0,8</Thickness>
  <Thickness x:Key="Pad.1212">0,12,0,12</Thickness>
  <Thickness x:Key="Pad.51051">5,10,5,10</Thickness>
  <Thickness x:Key="Pad.Button">16,7,16,7</Thickness>
  <Thickness x:Key="Pad.Badge">6,1,6,1</Thickness>
  <sys:Double x:Key="Gap.4">4</sys:Double>
  <sys:Double x:Key="Gap.8">8</sys:Double>
  <CornerRadius x:Key="Radius.3">3</CornerRadius>
  <CornerRadius x:Key="Radius.4">4</CornerRadius>

  <!-- ============ 影（Figma のぼかしの値をそのまま BlurRadius に当てた。
       計算の仕方が Figma と違うため、広がり方は一致しない見込み＝README に記載） ============ -->
  <DropShadowEffect x:Key="Shadow.Card" Color="#000000" Opacity="0.10" BlurRadius="16" ShadowDepth="6" Direction="270" />
  <DropShadowEffect x:Key="Shadow.Dialog" Color="#000000" Opacity="0.18" BlurRadius="20" ShadowDepth="4" Direction="270" />
  <DropShadowEffect x:Key="Shadow.Small" Color="#000000" Opacity="0.15" BlurRadius="8" ShadowDepth="2" Direction="270" />

  <!-- ============ アイコン（Lucide（lucide-icons/lucide、lucide-static v1.50.0、ISC ライセンス）の
       公式 SVG を正本にして Path Data（Geometry）に変換。24x24 の viewBox・線の太さ 2 の座標をそのまま使う。
       色・塗り・不透明度は使う側（xaml/*.xaml）のまま変えていない。
       Icon.Save は見た目は保存ボタンのままだが、Figma の確定表に合わせ Lucide の download（下矢印）の
       形にしている。Icon.AppBook・Icon.AppMag（起動画面のロゴ）は Lucide 化しない対象（アプリのアイコン）
       として、手で近似した元の形のまま残している。ナビの空状態（Icon.FolderEmptyState）は、本物の
       Figma 書き出し（folder-search）が結果一覧側の H0 イラスト用に限られるため、手近似のまま残している） ============ -->
  <Geometry x:Key="Icon.Folder">M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z</Geometry>
  <Geometry x:Key="Icon.FolderClosed">M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z M2 10h20</Geometry>
  <!-- ナビの空状態（橙の線の folder-open。lucide-static v1.50.0・ISC の folder-open.svg） -->
  <Geometry x:Key="Icon.FolderEmptyState">m6 14 1.45-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.55 6a2 2 0 0 1-1.94 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2</Geometry>
  <Geometry x:Key="Icon.ChevronDown">M6 9 L12 15 L18 9</Geometry>
  <Geometry x:Key="Icon.ChevronRight">M9 18 L15 12 L9 6</Geometry>
  <Geometry x:Key="Icon.RefreshCw">M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M8 16H3v5</Geometry>
  <!-- 正規表現エラーの文の頭に付ける三角の注意（文字の「⚠」から差し替え） -->
  <Geometry x:Key="Icon.TriangleAlert">M21.73 18 L13.73 4a2 2 0 0 0-3.48 0 L2.27 18A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z M12 9v4 M12 17h.01</Geometry>
  <!-- テキストファイル（.txt・.md）用。中の横線が無い、Lucide の file そのもの -->
  <Geometry x:Key="Icon.File">M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z M14 2v5a1 1 0 0 0 1 1h5</Geometry>
  <Geometry x:Key="Icon.FileText">M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z M14 2v5a1 1 0 0 0 1 1h5 M10 9H8 M16 13H8 M16 17H8</Geometry>
  <!-- H0（インデックス未作成）のイラスト。lucide/folder-search.svg -->
  <Geometry x:Key="Icon.FolderSearch">M10.7 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v4.1 M21 21 L19.1 19.1 M17 14a3 3 0 1 0 0.0001 0Z</Geometry>
  <Geometry x:Key="Icon.FileSpreadsheet">M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z M14 2v5a1 1 0 0 0 1 1h5 M8 13h2 M14 13h2 M8 17h2 M14 17h2</Geometry>
  <Geometry x:Key="Icon.Presentation">M2 3h20 M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3 M7 21 L12 16 L17 21</Geometry>
  <Geometry x:Key="Icon.ChartColumn">M3 3v16a2 2 0 0 0 2 2h16 M18 17V9 M13 17V5 M8 17v-3</Geometry>
  <Geometry x:Key="Icon.Save">M12 15V3 M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10 L12 15 L17 10</Geometry>
  <Geometry x:Key="Icon.StopCircle">M12 2a10 10 0 1 0 0.0001 0Z M10 9 L14 9 A1 1 0 0 1 15 10 L15 14 A1 1 0 0 1 14 15 L10 15 A1 1 0 0 1 9 14 L9 10 A1 1 0 0 1 10 9 Z</Geometry>
  <Geometry x:Key="Icon.Close">M18 6 L6 18 M6 6 L18 18</Geometry>
  <!-- タイトルバーの閉じるボタン（文字の × から差し替え） -->
  <Geometry x:Key="Icon.CircleX">M12 2a10 10 0 1 0 0.0001 0Z M15 9 L9 15 M9 9 L15 15</Geometry>
  <Geometry x:Key="Icon.Search">M11 3a8 8 0 1 0 0.0001 0Z M21 21 L16.66 16.66</Geometry>
  <!-- 今回の PoC では使う場所が無いが、対応表どおり Geometry だけ用意しておく（ヘルプボタンは Stage 1 に無い） -->
  <Geometry x:Key="Icon.CircleQuestionMark">M12 2a10 10 0 1 0 0.0001 0Z M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3 M12 17h.01</Geometry>
  <!-- チェックボックスのチェック本体（Lucide の check） -->
  <Geometry x:Key="Icon.Check">M20 6 L9 17 L4 12</Geometry>
  <!-- SP の見本 png/SP.png に合わせた開いた本の形（diff_round3.md 10。Lucide の book-open） -->
  <Geometry x:Key="Icon.AppBook">M12 7v14 M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z</Geometry>
  <Geometry x:Key="Icon.AppMag">M17.3 20a2.7 2.7 0 1 0 0.0001 0Z M19.3 19.3 L23 23</Geometry>
  <!-- 高速検索バッジの絵文字（⚡）を置き換えた Lucide の zap（lucide-static v1.50.0・ISC）。
       塗りつぶしではなく線（Stroke）で使う（使う側で Width/Height=12、StrokeThickness=1.5、
       StrokeStartLineCap/StrokeEndLineCap/StrokeLineJoin=Round、色は文字と同じにする）。 -->
  <Geometry x:Key="Icon.Zap">M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z</Geometry>
  <Geometry x:Key="Icon.Info">M12 2a10 10 0 1 0 0.0001 0Z M12 16v-4 M12 8h.01</Geometry>
  <!-- 塗り丸のバッジ（Banner・ContentBanner）の中に白で描く 4 種の線（lucide-static v1.50.0・ISC の
       circle-info／circle-alert／circle-x／circle-check から、外側の丸を除いた内側の線だけを取った）。
       外側の丸は Ellipse で塗って表す。メンテナ指摘（2026-10-03・動作確認で）の i・!・×・✓ に対応。 -->
  <Geometry x:Key="Icon.BadgeGlyphInfo">M12 16v-4 M12 8h.01</Geometry>
  <Geometry x:Key="Icon.BadgeGlyphWarn">M12 8v4 M12 16h.01</Geometry>
  <!-- Stage 1 の 26 枚には赤（エラー）色の Banner・ContentBanner を使うフレームが無く、今は出番が無い。
       対応表の完全性のため Geometry だけ用意しておく（Icon.CircleQuestionMark と同じ扱い）。 -->
  <Geometry x:Key="Icon.BadgeGlyphError">M15 9 L9 15 M9 9 L15 15</Geometry>
  <Geometry x:Key="Icon.BadgeGlyphOk">M9 12 L11 14 L15 10</Geometry>
  <Geometry x:Key="Icon.Dots3">M12 12a1 1 0 1 0 0.0001 0Z M19 12a1 1 0 1 0 0.0001 0Z M5 12a1 1 0 1 0 0.0001 0Z</Geometry>

  <!-- ============ 文字（Figma のサイズをそのまま。太さは Regular/Medium/Bold） ============ -->
  <Style x:Key="Text.10" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource Ink.5F6368}" />
  </Style>
  <Style x:Key="Text.11" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource Ink.202124}" />
  </Style>
  <Style x:Key="Text.11.Medium" TargetType="TextBlock" BasedOn="{StaticResource Text.11}">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="Text.11.Bold" TargetType="TextBlock" BasedOn="{StaticResource Text.11}">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="Text.11.Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.11}">
    <Setter Property="Foreground" Value="{StaticResource Ink.6B737D}" />
  </Style>
  <!-- 一覧の行の「場所」「種別」専用。4 回目は Ink.Muted にしたが、これは誤りで Ink.Body が正しい
       （diff_round5.md の訂正。10-04 に決定） -->
  <Style x:Key="Text.11.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.11}">
    <Setter Property="Foreground" Value="{StaticResource Ink.5F6368}" />
  </Style>
  <Style x:Key="Text.12" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Ink.202124}" />
  </Style>
  <Style x:Key="Text.12.Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.12}">
    <Setter Property="Foreground" Value="{StaticResource Ink.5F6368}" />
  </Style>
  <Style x:Key="Text.13" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Ink.212126}" />
  </Style>
  <!-- ナビの項目・検索ボタンの文字など（diff_round2.md 2 回目指摘。太さを Medium にそろえる） -->
  <Style x:Key="Text.13.Medium" TargetType="TextBlock" BasedOn="{StaticResource Text.13}">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="Text.14.Bold" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Ink.202124}" />
  </Style>
  <Style x:Key="Text.16" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource Ink.202124}" />
  </Style>
  <Style x:Key="Text.18" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource Ink.202124}" />
  </Style>
  <Style x:Key="Text.20" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Foreground" Value="{StaticResource Ink.202124}" />
  </Style>
  <Style x:Key="Text.22" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Ink.202124}" />
  </Style>
  <Style x:Key="Text.28" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Ink.202124}" />
  </Style>
  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.13}" />

  <!-- ============ ボタン（主・危険・枠・開く＋分割） ============ -->
  <Style x:Key="Btn.Base" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="{StaticResource Pad.Button}" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource Radius.4}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
            </Trigger>
            <!-- 使えないときは地 #E8EAED、文字 #9FA4AA にする（diff_round3.md 7。H-E・E12 の検索ボタンなど） -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Disabled.E8EAED}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Disabled.E8EAED}" />
              <Setter TargetName="Bd" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="{StaticResource Disabled.9FA4AA}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{StaticResource Accent.0078D4}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
    <Setter Property="Foreground" Value="{StaticResource White}" />
  </Style>
  <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{StaticResource Danger.D13438}" />
    <Setter Property="BorderBrush" Value="{StaticResource Danger.D13438}" />
    <Setter Property="Foreground" Value="{StaticResource White}" />
  </Style>
  <Style x:Key="Btn.Outline" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{StaticResource Bg.FFFFFF}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border.D9DEE3}" />
    <Setter Property="Foreground" Value="{StaticResource Ink.202124}" />
  </Style>
  <!-- バナーの中のボタン。帯の色の枠と、帯の色の太字にする（diff_round2.md 2 回目指摘） -->
  <Style x:Key="Btn.BannerAccent" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{StaticResource Bg.FFFFFF}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
    <Setter Property="Foreground" Value="{StaticResource Accent.0078D4}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- 「開く ▾」分割ボタン。本体を押すと開く、▾ で候補（本体の枠線を共有する 1 つの Border にする）。
       白地に青い枠・青い文字にする（diff_round2.md 2 回目指摘。前回は塗りの青だった） -->
  <Style x:Key="Btn.OpenSplitBody" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{StaticResource Bg.FFFFFF}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
    <Setter Property="Foreground" Value="{StaticResource Accent.0078D4}" />
    <!-- 高さ 24（diff_round5.md 2） -->
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="16,4,10,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1,1,0,1" CornerRadius="4,0,0,4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- 「開く」単独ボタン（▾ なし。H-W など分割にしない見本で使う）。split なしは青い枠だけ -->
  <Style x:Key="Btn.OpenPlain" TargetType="Button" BasedOn="{StaticResource Btn.Outline}">
    <Setter Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
    <Setter Property="Foreground" Value="{StaticResource Accent.0078D4}" />
  </Style>
  <Style x:Key="Btn.OpenSplitArrow" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{StaticResource Bg.FFFFFF}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
    <Setter Property="Foreground" Value="{StaticResource Accent.0078D4}" />
    <!-- 高さ 24（diff_round5.md 2） -->
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="7,4,10,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="0,4,4,0" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ チェックボックス（中間状態＝ツリーの親の一部選択を含む） ============ -->
  <Style x:Key="CheckBox.Tree" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Box" Width="16" Height="16" CornerRadius="{StaticResource Radius.3}"
                  Background="{StaticResource Bg.FFFFFF}" BorderBrush="{StaticResource Border.D0D4D9}" BorderThickness="1">
            <Grid>
              <Path x:Name="Check" Visibility="Collapsed" Stretch="Uniform" Margin="3"
                    Stroke="{StaticResource White}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="{StaticResource Icon.Check}" />
              <Rectangle x:Name="Mid" Visibility="Collapsed" Width="8" Height="2" RadiusX="1" RadiusY="1"
                         Fill="{StaticResource White}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent.0078D4}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent.0078D4}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
              <Setter TargetName="Mid" Property="Visibility" Value="Visible" />
            </Trigger>
            <!-- 薄い青地にチェックを残す（Figma node 108:572）。チェック済み・操作不可の行（本文など。
                 diff_round3.md 12・小） -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True" />
                <Condition Property="IsEnabled" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Select.E5F1FB}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              <Setter TargetName="Check" Property="Stroke" Value="{StaticResource Accent.0078D4}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ ラベル付きチェックボックス（正規表現・大文字小文字など）。
       オンのとき地を青く塗り白い check、文字も青にする（diff_round2.md 2 回目指摘） ============ -->
  <Style x:Key="CheckBox.Label" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource Ink.202124}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="Box" Width="14" Height="14" CornerRadius="{StaticResource Radius.3}" Margin="0,0,5,0"
                    Background="{StaticResource Bg.FFFFFF}" BorderBrush="{StaticResource Border.D0D4D9}" BorderThickness="1">
              <Path x:Name="Check" Visibility="Collapsed" Stretch="Uniform" Margin="2.5"
                    Stroke="{StaticResource White}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="{StaticResource Icon.Check}" />
            </Border>
            <ContentPresenter x:Name="Cp" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent.0078D4}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent.0078D4}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource Accent.0078D4}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ File Kind Chip（ファイルの種類の絞り込み） ============ -->
  <!-- 丸い pill にする（diff_round2.md 2 回目指摘。前回は角丸 4px の四角だった） -->
  <CornerRadius x:Key="Radius.Pill">12</CornerRadius>
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4,8,4" />
  </Style>

  <!-- ============ Nav Badge（左ナビの数・ドットの印） ============ -->
  <Style x:Key="NavBadge.Count" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Bg.F3F3F4}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="6,1,6,1" />
  </Style>
  <Style x:Key="NavBadge.Dot" TargetType="Ellipse">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
  </Style>

  <!-- ============ Status Badge / Fast Search Indicator（3 状態） ============ -->
  <Style x:Key="StatusBadge" TargetType="Border">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,2,8,2" />
  </Style>

  <!-- ============ 吹き出し（ツールチップ風。ダーク地） ============ -->
  <Style x:Key="Bubble" TargetType="Border">
    <Setter Property="Background" Value="#333840" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.4}" />
    <Setter Property="Padding" Value="10,7,10,7" />
    <Setter Property="Effect" Value="{StaticResource Shadow.Small}" />
  </Style>
  <Style x:Key="Text.Bubble" TargetType="TextBlock" BasedOn="{StaticResource Text.12}">
    <Setter Property="Foreground" Value="{StaticResource White}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ============ Banner（info/success/warning） ============ -->
  <Style x:Key="Banner" TargetType="Border">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.4}" />
    <Setter Property="Padding" Value="12,8,12,8" />
  </Style>

  <!-- ============ Inline Error（赤枠＋赤アイコン文字） ============ -->
  <Style x:Key="TextBox.Base" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Background" Value="{StaticResource Bg.FFFFFF}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border.D9DEE3}" />
    <Setter Property="Foreground" Value="{StaticResource Ink.202124}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource Radius.4}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Base}" />
  <Style x:Key="TextBox.Error" TargetType="TextBox" BasedOn="{StaticResource TextBox.Base}">
    <Setter Property="BorderBrush" Value="{StaticResource Danger.D13438}" />
  </Style>

  <!-- ============ Empty State（「?」は文字で出す） ============ -->
  <Style x:Key="EmptyIconRing" TargetType="Border">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Background" Value="{StaticResource Bg.F3F3F4}" />
  </Style>

  <!-- ============ ツリー（検索対象） ============ -->
  <Style x:Key="TreeChevron" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent" Width="16" Height="16">
            <Path x:Name="Arrow" Width="8" Height="8" Stretch="Uniform" Data="{StaticResource Icon.ChevronRight}"
                  Stroke="{StaticResource Ink.5F6368}" StrokeThickness="1.6" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Arrow" Property="Data" Value="{StaticResource Icon.ChevronDown}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="#CBD0D6" CornerRadius="4" Margin="3" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollHidden" TargetType="RepeatButton">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageUpCommand" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageDownCommand" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- 横向き（プレビューの表の下など）は幅いっぱいに伸ばし、高さだけ 10 にする -->
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageLeftCommand" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageRightCommand" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
