<!-- 確認ダイアログ。「押すと何が起きるか」を見出し・結果・ボタンの文言で見せる。gui.ps1 の showConfirm が読み込む。
     色・文字・コントロールの形は scripts/shared/xaml/theme.xaml にまとめてある。 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="確認" Width="560" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Background="White" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- 下部のボタンは gui.ps1 が並べるため、間隔はここで付ける -->
      <Style TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="8,0,0,0" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="22,20,22,18">
    <!-- 下部：選択肢が 1 つのときは［実行］＋［キャンセル］、2 つ以上のときは［キャンセル］だけを置く -->
    <StackPanel x:Name="ButtonPanel" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0" />

    <StackPanel>
      <!-- 見出し：これから何をするか（1 行で読み切れる長さにする） -->
      <TextBlock x:Name="HeadingText" Style="{StaticResource DialogHeading}" />

      <!-- 結果：実行すると何が消えて何が残るか -->
      <Border x:Name="FactsPanel" Visibility="Collapsed" Margin="0,14,0,0"
              Background="#FAFBFC" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1" CornerRadius="8" Padding="14,10">
        <ItemsControl x:Name="FactsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,5">
                <TextBlock DockPanel.Dock="Left" Width="22" VerticalAlignment="Top" FontWeight="SemiBold"
                           Text="{Binding Mark}" Foreground="{Binding MarkBrush}" />
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Foreground="{StaticResource Ink.Strong}" TextWrapping="Wrap" />
                  <TextBlock x:Name="FactDetail" Style="{StaticResource Meta}" Text="{Binding Detail}" Margin="0,3,0,0" />
                </StackPanel>
              </DockPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Detail}" Value="">
                  <Setter TargetName="FactDetail" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- 選択肢が 2 つ以上のときのボタン（gui.ps1 が組み立てる） -->
      <StackPanel x:Name="ChoicePanel" Margin="0,14,0,0" />

      <!-- 補足：読まなくても操作できる内容だけを書く -->
      <TextBlock x:Name="HintText" Style="{StaticResource Meta}" Visibility="Collapsed" Margin="0,14,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
