<!-- ［9 プロセス停止］タブの中身（どのツールからも使う）。ウィンドウの KillTab に入れる -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Grid.Resources>
    <Border Style="{StaticResource Card}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
          <TextBlock Style="{StaticResource Heading}" Text="残っている Office のプロセス" />
          <TextBlock Style="{StaticResource Meta}" Margin="0,6,0,0"
                     Text="取り込み・比較を中断したときなどに残った Excel・Word・PowerPoint のプロセスを終了します。" />
        </StackPanel>
  
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="KillAllButton" Style="{StaticResource Danger}" Content="すべて終了" Height="34" />
            <Button x:Name="KillSelectedButton" Content="選択したプロセスを終了" Height="34" MinWidth="170" Margin="8,0,0,0" />
            <Button x:Name="KillBackgroundButton" Style="{StaticResource Primary}" Content="バックグラウンドのみ終了" Height="34" MinWidth="190" Margin="8,0,0,0" />
          </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Micro}" Margin="2,12,0,0"
                   Text="バックグラウンド：画面にウィンドウが無いプロセス（取り込みで起動したものなど）。&#x0a;画面に表示中のプロセスを終了すると、保存していない内容は失われます。" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <Button x:Name="RefreshProcessButton" DockPanel.Dock="Right" Content="更新" />
          <TextBlock x:Name="ProcessSummaryText" Style="{StaticResource Focal}" VerticalAlignment="Center" />
        </DockPanel>
        <DataGrid x:Name="ProcessGrid" CanUserSortColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="種類" Binding="{Binding AppName}" Width="110" ElementStyle="{StaticResource Cell.Key}" />
            <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="80" ElementStyle="{StaticResource Cell.Number}" />
            <DataGridTextColumn Header="起動時刻" Binding="{Binding StartText}" Width="100" ElementStyle="{StaticResource Cell.Meta}" />
            <DataGridTextColumn Header="メモリ" Binding="{Binding MemoryText}" Width="100" ElementStyle="{StaticResource Cell.Number}" />
            <DataGridTextColumn Header="ウィンドウ" Binding="{Binding TitleText}" Width="*" ElementStyle="{StaticResource Cell.Meta}" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
</Grid>
