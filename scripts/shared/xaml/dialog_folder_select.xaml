<!-- エクスプローラー風のフォルダ選択ダイアログ（［参照…］・元のファイルの場所の指定）。config_gui.ps1 が読み込む。
     色・文字・コントロールの形は scripts/shared/xaml/theme.xaml にまとめてある。 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="フォルダの選択" Width="900" Height="600" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Background="White" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- フォルダ・ファイルの絵（画像ファイルを持たずに済むよう図形で描く） -->
      <Geometry x:Key="FolderGeometry">M1,3.2 L6.2,3.2 L7.6,5.2 L15,5.2 L15,13.2 L1,13.2 Z</Geometry>
      <Geometry x:Key="FileGeometry">M3.5,1.2 L9.6,1.2 L12.5,4.2 L12.5,14.8 L3.5,14.8 Z M9.6,1.2 L9.6,4.2 L12.5,4.2</Geometry>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="16,14,16,14">
    <TextBlock x:Name="DescriptionText" DockPanel.Dock="Top" Style="{StaticResource Meta}" Margin="0,0,0,10" />

    <!-- アドレスバー（エクスプローラーと同じく、戻る・進む・1つ上へ・パスの入力ができる） -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="←"
              ToolTip="前に見ていたフォルダへ戻る（Alt+←）" />
      <Button x:Name="ForwardButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="→"
              ToolTip="次のフォルダへ進む（Alt+→）" />
      <Button x:Name="UpButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="↑"
              ToolTip="1つ上のフォルダへ（Alt+↑・BackSpace）" Margin="0,0,10,0" />
      <TextBox x:Name="AddressBox" FontSize="12"
               ToolTip="フォルダのパスを入力・貼り付けして Enter で移動します（\\server\share も指定できます）。F5 で読み直します" />
    </DockPanel>

    <!-- 選んだフォルダと決定 -->
    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="フォルダー" Margin="0,0,10,0" />
      <TextBox x:Name="FolderBox" Grid.Row="0" Grid.Column="1" AllowDrop="True"
               ToolTip="ここに書かれたフォルダを選びます（パスの入力・貼り付け・フォルダのドラッグ＆ドロップもできます）" />
      <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
        <Button x:Name="OkButton" Style="{StaticResource Primary}" Content="選択" IsDefault="True" MinWidth="104" />
        <Button x:Name="CancelButton" Content="キャンセル" IsCancel="True" MinWidth="104" Margin="8,0,0,0" />
      </StackPanel>

      <TextBlock x:Name="ErrorText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ErrorText}"
                 Margin="0,8,0,0" Visibility="Collapsed" />
    </Grid>

    <!-- 左：フォルダのツリー／右：中身の一覧 -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" MinWidth="140" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" MinWidth="260" />
      </Grid.ColumnDefinitions>

      <TreeView x:Name="FolderTree" Grid.Column="0">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem" BasedOn="{StaticResource TreeViewItem.Base}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}" Margin="0,1">
              <Path x:Name="Icon" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                    Data="{StaticResource FolderGeometry}" Fill="#F5C26B" Stroke="#B8842A" StrokeThickness="0.8" />
              <TextBlock x:Name="Label" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <HierarchicalDataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Ink.Faint}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsHeader}" Value="True">
                <Setter TargetName="Icon" Property="Fill" Value="#CBD5E1" />
                <Setter TargetName="Icon" Property="Stroke" Value="#64748B" />
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Ink.Strong}" />
              </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

      <DockPanel Grid.Column="2">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource Micro}" Margin="2,8,0,0" />

        <Grid>
          <ListView x:Name="EntryList" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                <Style.Triggers>
                  <!-- ファイルは「目的のフォルダかどうか」を確かめるために出すだけで、選べない -->
                  <DataTrigger Binding="{Binding IsFolder}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView>
                <GridViewColumn Header="名前" Width="330">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                        <Path x:Name="Icon" Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                              Data="{StaticResource FolderGeometry}" Fill="#F5C26B" Stroke="#B8842A" StrokeThickness="0.8" />
                        <TextBlock x:Name="Label" Style="{StaticResource Cell.Key}" Text="{Binding Name}" VerticalAlignment="Center" />
                      </StackPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsFolder}" Value="False">
                          <Setter TargetName="Icon" Property="Data" Value="{StaticResource FileGeometry}" />
                          <Setter TargetName="Icon" Property="Fill" Value="#EDEFF2" />
                          <Setter TargetName="Icon" Property="Stroke" Value="#A3ABB5" />
                          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Ink.Muted}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsOffice}" Value="True">
                          <Setter TargetName="Icon" Property="Fill" Value="#C9EFD7" />
                          <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource Ok}" />
                          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Ok}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="種類" Width="150">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource Cell.Meta}" Text="{Binding Kind}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="更新日時" Width="130">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource Cell.Meta}" Text="{Binding UpdatedText}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <!-- 上は列見出しの高さ分あける（見出しに重ねない） -->
          <TextBlock x:Name="EntryPlaceholder" Style="{StaticResource Placeholder}" Margin="12,44,12,0"
                     VerticalAlignment="Top" TextWrapping="Wrap" Visibility="Collapsed" />
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
