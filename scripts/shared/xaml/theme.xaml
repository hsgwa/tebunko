  <Geometry x:Key="Icon.Close">M18 6 L6 18 M6 6 L18 18</Geometry>
  <Geometry x:Key="Icon.CircleX">M12 2a10 10 0 1 0 0.0001 0Z M15 9 L9 15 M9 9 L15 15</Geometry>
  <Geometry x:Key="Icon.Search">M11 3a8 8 0 1 0 0.0001 0Z M21 21 L16.66 16.66</Geometry>
  <Geometry x:Key="Icon.CircleQuestionMark">M12 2a10 10 0 1 0 0.0001 0Z M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3 M12 17h.01</Geometry>
