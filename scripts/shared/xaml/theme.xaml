<!-- 画面の見た目の定義（色・文字・コントロールの形）。gui.ps1 の loadWindow が各画面に読み込む。

     文字の設計:
       大きさ  16 / 14 / 13 / 12 / 11。ダイアログの見出し 16、主役の値 14、本文 13、補助 12、細目 11。
       太さ    Normal・Medium・SemiBold・Bold。Medium は項目の名前（ナビ・インデックス名・種別の札）、SemiBold は見出し・主ボタン・その画面の主役の値、Bold は件数・一致した文字などの強調に使う。
       濃さ    Ink.Strong（見出し・主キー）＞ Ink.Body（本文）＞ Ink.Muted（補助）＞ Ink.Faint（入力前の案内）。
               すべてを黒にすると重要度が伝わらないため、本文は真っ黒にしない。

     Windows 既定のコントロールは立体的で古いため、Button・TextBox・CheckBox・TabItem・DataGrid・
     TreeViewItem・ScrollBar・ComboBox・MenuItem は独自のテンプレートにする。
     既定テンプレートを置き換えると既定のフォーカス表示も消えるため、キーボードで操作する箇所には
     必ずフォーカスの枠（Accent.Ring）を出す。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ 色のトークン（色を変えるのはここだけ） ============ -->
  <!-- 値は Figma の設計（theme の Variables）に合わせる。近い色はキーにまとめてある -->
  <!-- 背景 -->
  <SolidColorBrush x:Key="Bg.Window"      Color="#F5F7FA" />
  <SolidColorBrush x:Key="Bg.Surface"     Color="#FFFFFF" />
  <SolidColorBrush x:Key="Bg.Subtle"      Color="#F9FAFA" />
  <SolidColorBrush x:Key="Bg.Stripe"      Color="#FAFBFC" />
  <SolidColorBrush x:Key="Bg.Hover"       Color="#F3F3F4" />
  <SolidColorBrush x:Key="Bg.Pressed"     Color="#E8EBEF" />
  <SolidColorBrush x:Key="Bg.Pane"        Color="#F0F2F4" />
  <SolidColorBrush x:Key="Bg.Tag"         Color="#F1F3F4" />
  <SolidColorBrush x:Key="Bg.Button"      Color="#F2F2F5" />
  <SolidColorBrush x:Key="Bg.Summary"     Color="#F7FAFC" />
  <SolidColorBrush x:Key="Bg.Section"     Color="#E8EBF0" />
  <SolidColorBrush x:Key="Bg.TitleBar"    Color="#F0F0F0" />

  <!-- 枠・線 -->
  <SolidColorBrush x:Key="Border.Soft"      Color="#E0E2E5" />
  <SolidColorBrush x:Key="Border.Normal"    Color="#D9DEE3" />
  <SolidColorBrush x:Key="Border.Input"     Color="#D1D1D1" />
  <SolidColorBrush x:Key="Border.Strong"    Color="#C9CED4" />
  <SolidColorBrush x:Key="Border.Separator" Color="#D5D9DE" />
  <SolidColorBrush x:Key="Border.Splitter"  Color="#D0D4D9" />
  <SolidColorBrush x:Key="Border.Grip"      Color="#A9AFB6" />
  <SolidColorBrush x:Key="Border.Divider"   Color="#E5E8ED" />
  <SolidColorBrush x:Key="Border.Row"       Color="#EDF0F2" />
  <SolidColorBrush x:Key="Border.Dialog"    Color="#D1D6E0" />
  <SolidColorBrush x:Key="Border.Check"     Color="#9EA3AB" />
  <SolidColorBrush x:Key="Border.Window"    Color="#999999" />

  <!-- ダイアログの後ろの暗幕（窓いっぱいに掛ける） -->
  <SolidColorBrush x:Key="Overlay.Scrim"  Color="#000000" Opacity="0.35" />

  <!-- 文字・アイコン -->
  <SolidColorBrush x:Key="Ink.Strong"      Color="#202124" />
  <SolidColorBrush x:Key="Ink.Value"       Color="#212126" />
  <SolidColorBrush x:Key="Ink.Body"        Color="#5F6368" />
  <SolidColorBrush x:Key="Ink.Muted"       Color="#6B737D" />
  <SolidColorBrush x:Key="Ink.Subtle"      Color="#80868B" />
  <SolidColorBrush x:Key="Ink.Placeholder" Color="#9AA0A6" />
  <SolidColorBrush x:Key="Ink.Faint"       Color="#99A1AB" />
  <SolidColorBrush x:Key="Ink.Note"        Color="#8C949E" />
  <SolidColorBrush x:Key="Ink.OnAccent"    Color="#FFFFFF" />
  <SolidColorBrush x:Key="Button.Text"     Color="#4D4D4D" />
  <SolidColorBrush x:Key="Button.Icon"     Color="#666666" />

  <!-- 強調・状態 -->
  <SolidColorBrush x:Key="Accent"         Color="#0078D4" />
  <SolidColorBrush x:Key="Accent.Hover"   Color="#0B5CAD" />
  <SolidColorBrush x:Key="Accent.Soft"    Color="#E5F1FB" />
  <SolidColorBrush x:Key="Accent.Ring"    Color="#BFD3FE" />
  <SolidColorBrush x:Key="Select.Soft"    Color="#E1F2FF" />
  <SolidColorBrush x:Key="Hit"            Color="#FFF176" />
  <SolidColorBrush x:Key="Hit.Cell"       Color="#FFF3CD" />
  <SolidColorBrush x:Key="Ok"             Color="#218A21" />
  <SolidColorBrush x:Key="Ok.Strong"      Color="#1E8E3E" />
  <SolidColorBrush x:Key="Ok.Soft"        Color="#E0F7E0" />
  <SolidColorBrush x:Key="Warn"           Color="#BA7D00" />
  <SolidColorBrush x:Key="Warn.Dot"       Color="#E8A400" />
  <SolidColorBrush x:Key="Warn.Soft"      Color="#FFF5E0" />
  <SolidColorBrush x:Key="Warn.Note"      Color="#FFF7E0" />
  <SolidColorBrush x:Key="Warn.Line"      Color="#F0C36D" />
  <SolidColorBrush x:Key="Warn.Strong"    Color="#6B4E00" />
  <SolidColorBrush x:Key="Danger.Text"    Color="#D13438" />
  <SolidColorBrush x:Key="Danger.Dot"     Color="#D93025" />
  <SolidColorBrush x:Key="Danger.Line"    Color="#E9B8A3" />
  <SolidColorBrush x:Key="Danger.Soft"    Color="#FFE6E6" />

  <!-- ファイルの種類のアイコン・フォルダ・進み具合のバー -->
  <SolidColorBrush x:Key="File.Excel"      Color="#107C41" />
  <SolidColorBrush x:Key="File.Word"       Color="#185ABD" />
  <SolidColorBrush x:Key="File.PowerPoint" Color="#C43E1C" />
  <SolidColorBrush x:Key="File.Folder"     Color="#E8A020" />

  <!-- イラストの線 -->
  <SolidColorBrush x:Key="Illust.Line"    Color="#D1D6DE" />

  <!-- 一覧の状態バッジ（4 段階）の色。背景と文字の組で、どの画面の状態表示にも使えるようにする -->
  <SolidColorBrush x:Key="Badge.Ok.Bg"     Color="#E0F7E0" />
  <SolidColorBrush x:Key="Badge.Ok.Text"   Color="#218A21" />
  <SolidColorBrush x:Key="Badge.Wait.Bg"   Color="#FFF5E0" />
  <SolidColorBrush x:Key="Badge.Wait.Text" Color="#BA7D00" />
  <SolidColorBrush x:Key="Badge.Ng.Bg"     Color="#FFE6E6" />
  <SolidColorBrush x:Key="Badge.Ng.Text"   Color="#D13438" />
  <SolidColorBrush x:Key="Badge.None.Bg"   Color="#F1F3F4" />
  <SolidColorBrush x:Key="Badge.None.Text" Color="#5F6368" />

  <CornerRadius x:Key="Radius.Control">6</CornerRadius>
  <CornerRadius x:Key="Radius.Card">10</CornerRadius>

  <!-- ============ 文字 ============ -->
  <!-- 既定＝本文。真っ黒にせず、見出しとの差を残す -->
  <Style TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Ink.Body}" />
  </Style>

  <!-- 区画の見出し -->
  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
  </Style>

  <!-- ダイアログの見出し（これから何をするか） -->
  <Style x:Key="DialogHeading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- 入力欄の見出し -->
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- その画面の主役の値（件数など）。画面に 1 つだけ -->
  <Style x:Key="Focal" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
  </Style>

  <!-- 補助（説明文・ラベル） -->
  <Style x:Key="Meta" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource Ink.Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- 旧名。既存の画面が Hint を参照しているため残す -->
  <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Meta}" />

  <!-- 細目（常時は読まない情報） -->
  <Style x:Key="Micro" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource Ink.Faint}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Figma の Text styles（フォントはすべて Rethink Sans。太さも Figma の指定どおり。Rethink Sans は可変フォントで、Medium・SemiBold・Bold の実体がそのまま出る）。
       色は使う所で決める。下の既定は、その文字が一番よく使われる色。行の高さは書いてあるものだけ指定する
       （Brand の字間 0.2 は TextBlock に無いので付けない） -->
  <Style x:Key="ColumnHeader" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Ink.Muted}" />
  </Style>
  <Style x:Key="Meta.Tall" TargetType="TextBlock" BasedOn="{StaticResource Meta}">
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>
  <Style x:Key="Meta.Strong" TargetType="TextBlock" BasedOn="{StaticResource Meta}">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="Meta.Key" TargetType="TextBlock" BasedOn="{StaticResource Meta.Tall}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Note" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="17.6" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Foreground" Value="{StaticResource Ink.Note}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Chip" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Accent.Hover}" />
  </Style>
  <Style x:Key="Link.Text" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
  </Style>
  <Style x:Key="Label.Strong" TargetType="TextBlock" BasedOn="{StaticResource Label}">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="Brand" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
  </Style>
  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
  </Style>
  <Style x:Key="Body.Strong" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="Nav" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
  </Style>
  <Style x:Key="Nav.Tall" TargetType="TextBlock" BasedOn="{StaticResource Nav}">
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
  </Style>
  <Style x:Key="Title" TargetType="TextBlock">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
  </Style>
  <Style x:Key="AppTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
  </Style>

  <!-- ============ アイコン（Lucide v1.50.0・ISC ライセンスの SVG を Geometry にしたもの。24x24 の座標のまま。
       使う側で Stretch=Uniform・Stroke・StrokeThickness（表示の大きさ × 2/24）・丸い端を指定する。
       Icon.Save は Lucide の download の形。ライセンスは scripts/shared/fonts/ にある ============ -->
  <Geometry x:Key="Icon.Folder">M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z</Geometry>
  <Geometry x:Key="Icon.FolderClosed">M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z M2 10h20</Geometry>
