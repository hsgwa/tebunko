<!-- モダンなデザインのサンプル画面。theme_sample.ps1 が読み込んで表示する（動作はしない。見た目だけの見本）。 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="win_grep（モダン案）" Width="1000" Height="720" MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        Background="#F6F7F9" UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.Resources>

    <!-- ============ 色・角丸・余白のトークン（変えるのはここだけ） ============ -->
    <SolidColorBrush x:Key="Bg.Window"     Color="#F6F7F9" />
    <SolidColorBrush x:Key="Bg.Surface"    Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.Subtle"     Color="#F3F4F6" />
    <SolidColorBrush x:Key="Bg.Hover"      Color="#F1F3F5" />
    <SolidColorBrush x:Key="Bg.Pressed"    Color="#E5E7EB" />
    <SolidColorBrush x:Key="Border.Soft"   Color="#E6E8EC" />
    <SolidColorBrush x:Key="Border.Normal" Color="#D4D8DE" />
    <SolidColorBrush x:Key="Text.Primary"  Color="#111827" />
    <SolidColorBrush x:Key="Text.Second"   Color="#6B7280" />
    <SolidColorBrush x:Key="Text.Faint"    Color="#9CA3AF" />
    <SolidColorBrush x:Key="Accent"        Color="#2563EB" />
    <SolidColorBrush x:Key="Accent.Hover"  Color="#1D4ED8" />
    <SolidColorBrush x:Key="Accent.Soft"   Color="#EFF4FF" />
    <SolidColorBrush x:Key="Accent.Ring"   Color="#BFD3FE" />
    <SolidColorBrush x:Key="Danger.Text"   Color="#DC2626" />
    <SolidColorBrush x:Key="Danger.Soft"   Color="#FEF2F2" />
    <SolidColorBrush x:Key="Warn"          Color="#B45309" />
    <SolidColorBrush x:Key="Hit"           Color="#FDE68A" />

    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Card">10</CornerRadius>

    <!-- ============ 文字 ============ -->
    <!-- 選択中のタブの文字色（アクセント色）が中身に受け継がれないよう、既定の文字色を決める -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text.Second}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ============ カード（区切りは影ではなく枠と背景の差で出す） ============ -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Bg.Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Soft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ============ ボタン（既定テンプレートを捨てて 1 つに統一） ============ -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
      <Border x:Name="Ring" CornerRadius="7" Padding="1" Background="Transparent">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Control}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Bd" Property="Opacity" Value="0.90" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="Bd" Property="Opacity" Value="0.78" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="Ring" Property="Background" Value="{StaticResource Accent.Ring}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 既定のボタン＝白地・薄枠。ホバーは背景色で示す（水色の立体にしない） -->
    <Style TargetType="Button">
      <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Background" Value="{StaticResource Bg.Surface}" />
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Normal}" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Bg.Hover}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{StaticResource Bg.Pressed}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Accent.Hover}" />
          <Setter Property="BorderBrush" Value="{StaticResource Accent.Hover}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource Danger.Text}" />
      <Setter Property="BorderBrush" Value="#F0B5B5" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Danger.Soft}" />
          <Setter Property="BorderBrush" Value="{StaticResource Danger.Text}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="T" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 入力欄（フォーカスをリングで示す） ============ -->
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
      <Setter Property="Background" Value="{StaticResource Bg.Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Normal}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Ring" CornerRadius="7" Padding="1" Background="Transparent">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource Radius.Control}">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" />
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Text.Faint}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Ring" Property="Background" Value="{StaticResource Accent.Ring}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ チェックボックス（フラット・チェックは Path） ============ -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                      Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Normal}" BorderThickness="1">
                <Grid>
                  <Path x:Name="Check" Visibility="Collapsed" Stretch="Uniform" Margin="3"
                        Stroke="White" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                        Data="M 0,4 L 3.2,7.2 L 9,1" />
                  <Rectangle x:Name="Mid" Visibility="Collapsed" Width="8" Height="2" RadiusX="1" RadiusY="1" Fill="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ContentPresenter x:Name="Label" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Mid" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ スクロールバー（細身・角丸・トラック透明） ============ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="T" Background="#C4C8CE" CornerRadius="4" Margin="3" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="T" Property="Background" Value="#9CA3AF" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="T" Property="Background" Value="#6B7280" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollHidden" TargetType="RepeatButton">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="12" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageLeftCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageRightCommand" />
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ============ タブ（立体をやめ、選択タブは下線で示す） ============ -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Text.Second}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid x:Name="Root" Background="Transparent" Margin="0,0,4,0">
              <Border x:Name="Bd" Background="Transparent" CornerRadius="8,8,0,0" Padding="16,9">
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
              </Border>
              <Border x:Name="Line" Height="2" VerticalAlignment="Bottom" Margin="8,0" CornerRadius="1" Background="Transparent" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Line" Property="Background" Value="{StaticResource Accent}" />
                <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <DockPanel>
              <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,0,0,1">
                <TabPanel IsItemsHost="True" Panel.ZIndex="1" Margin="0,0,0,-1" />
              </Border>
              <ContentPresenter ContentSource="SelectedContent" Margin="0,16,0,0" />
            </DockPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 表（縦罫線を消し、行ホバーを付ける） ============ -->
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Soft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{StaticResource Bg.Surface}" />
      <Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="RowHeight" Value="30" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="SelectionMode" Value="Extended" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="EnableRowVirtualization" Value="True" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource Bg.Subtle}" />
      <Setter Property="Foreground" Value="{StaticResource Text.Second}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Soft}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="{StaticResource Bg.Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Soft}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Bg.Hover}" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource Accent.Soft}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RightCell" TargetType="TextBlock">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <!-- ============ ツリー（▷ をシェブロンに） ============ -->
    <Style x:Key="TreeChevron" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" Width="18" Height="18">
              <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8" Stroke="{StaticResource Text.Faint}" StrokeThickness="1.6"
                    StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.4,0.5" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Arrow" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="90" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource Text.Primary}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <StackPanel>
              <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="2,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ToggleButton x:Name="Expander" Grid.Column="0" Style="{StaticResource TreeChevron}"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press" />
                  <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent.Soft}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TreeView">
      <Setter Property="Background" Value="{StaticResource Bg.Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Soft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6" />
    </Style>

    <!-- ============ 進捗バー（光沢チャンクをやめる） ============ -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="Background" Value="{StaticResource Bg.Pressed}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
              <Grid>
                <Rectangle x:Name="PART_Track" />
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 区切り ============ -->
    <Style TargetType="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#1F2937" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- ==================== 画面 ==================== -->
  <DockPanel Margin="20,14,20,14">

    <!-- 下部：ステータス -->
    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Background="Transparent">
      <TextBlock Style="{StaticResource Hint}" Text="前回の変換: 2026-09-19 18:42／12 件を変換しました。" VerticalAlignment="Center" />
    </Border>

    <TabControl x:Name="Tabs">

      <!-- ========== 1 インデックス管理 ========== -->
      <TabItem Header="1 インデックス管理">
        <DockPanel>

          <!-- 下部：変換の開始と進捗 -->
          <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,12">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="変換を開始" MinWidth="150" Height="34" />
                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,14,0"
                           Text="押すと、何件変換するかを確認してから、新しいファイル・変わったファイルだけを変換します。" />
              </DockPanel>
              <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Content="中止" Margin="12,0,0,0" MinWidth="72" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="ログを開く" Margin="12,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center" Text="残り 約 2 分 10 秒" />
                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="変換中 38 / 120 件" />
              </DockPanel>
              <ProgressBar Value="0.32" Maximum="1" Margin="0,8,0,0" />
              <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                         Text="見積書\2026\04_見積_東日本支社.xlsx を変換しています…" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Style="{StaticResource Heading}" Text="インデックス一覧（チェックを付けたインデックスを変換します）" />

              <DockPanel Grid.Row="1" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" Width="150">
                  <Button Content="新規作成…" />
                  <Button Content="編集…" Margin="0,8,0,0" />
                  <Button Style="{StaticResource Danger}" Content="削除" Margin="0,8,0,0" />
                  <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0" Text="一覧にフォルダをドラッグ＆ドロップしても作成できます。" />
                </StackPanel>

                <DataGrid x:Name="IndexGrid" SelectionMode="Single" CanUserSortColumns="False">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="変換" Width="52">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="インデックス名" Binding="{Binding Name}" Width="150" />
                    <DataGridTextColumn Header="元のフォルダ" Binding="{Binding Path}" Width="*" />
                    <DataGridTextColumn Header="フォルダの状態" Binding="{Binding StatusText}" Width="140" />
                    <DataGridTextColumn Header="ファイル" Binding="{Binding FileCountText}" Width="76" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="最終変換" Binding="{Binding LastConvertedText}" Width="100" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>

              <TextBlock Grid.Row="2" Style="{StaticResource Heading}" Text="インデックスの状態（すべてのインデックスの合計）" Margin="0,18,0,6" />
              <StackPanel Grid.Row="3">
                <TextBlock Text="3 インデックス／412 ファイル／変換済み 400 件・未変換 9 件・失敗 3 件" />
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Warn}" FontSize="12"
                           Text="9 件が未変換です。［変換を開始］を押すと変換します。" />
              </StackPanel>
            </Grid>
          </Border>
        </DockPanel>
      </TabItem>

      <!-- ========== 2 検索 ========== -->
      <TabItem Header="2 検索" IsSelected="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" MinWidth="150" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="420" />
          </Grid.ColumnDefinitions>

          <!-- 左：検索対象 -->
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="検索対象" Margin="0,0,0,10" />
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="すべて選択" MinWidth="0" Height="28" Padding="10,0" />
                <Button Content="すべて解除" MinWidth="0" Height="28" Padding="10,0" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,10,0,0"
                         Text="チェックしたインデックス・フォルダだけを検索します。" />
              <TreeView>
                <TreeViewItem IsExpanded="True">
                  <TreeViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox IsChecked="True" Focusable="False" />
                      <TextBlock Text="見積書" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </TreeViewItem.Header>
                  <TreeViewItem>
                    <TreeViewItem.Header>
                      <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="True" Focusable="False" />
                        <TextBlock Text="2026" Margin="7,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                    </TreeViewItem.Header>
                  </TreeViewItem>
                  <TreeViewItem>
                    <TreeViewItem.Header>
                      <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="False" Focusable="False" />
                        <TextBlock Text="2025" Margin="7,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                    </TreeViewItem.Header>
                  </TreeViewItem>
                </TreeViewItem>
                <TreeViewItem IsExpanded="False">
                  <TreeViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox IsThreeState="True" Focusable="False" />
                      <TextBlock Text="議事録" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </TreeViewItem.Header>
                  <TreeViewItem Header="2026" />
                </TreeViewItem>
                <TreeViewItem>
                  <TreeViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox IsChecked="False" Focusable="False" />
                      <TextBlock Text="提案資料（フォルダが見つかりません）" Margin="7,0,0,0" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" MaxWidth="150" Foreground="{StaticResource Warn}" />
                    </StackPanel>
                  </TreeViewItem.Header>
                </TreeViewItem>
              </TreeView>
            </DockPanel>
          </Border>

          <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" />

          <!-- 右：検索ワードと結果 -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,14">
              <StackPanel>
                <DockPanel>
                  <TextBlock Style="{StaticResource Heading}" Text="検索ワード" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="検索" MinWidth="110" Height="34" Margin="10,0,0,0" />
                  <TextBox Height="34" FontSize="14" Text="消費税" />
                </DockPanel>
                <DockPanel Margin="0,12,0,0">
                  <CheckBox DockPanel.Dock="Left" Content="大文字と小文字を区別" VerticalAlignment="Center" Margin="0,0,18,0" />
                  <CheckBox DockPanel.Dock="Left" Content="正規表現を使う" IsChecked="True" VerticalAlignment="Center" Margin="0,0,18,0" />
                  <TextBlock DockPanel.Dock="Left" Text="対象ファイル" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox MaxWidth="320" HorizontalAlignment="Stretch" Text="*.xlsx;見積;!*old*" />
                </DockPanel>
              </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,14">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                  <Grid DockPanel.Dock="Right" Width="220">
                    <TextBox />
                    <TextBlock IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Text.Faint}" Text="結果の中から探す" />
                  </Grid>
                  <TextBlock DockPanel.Dock="Right" Text="絞り込み" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="47 件（12 ファイル）" />
                </DockPanel>

                <DataGrid x:Name="ResultGrid">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="フォルダ" Binding="{Binding RelDir}" Width="130" />
                    <DataGridTextColumn Header="ファイル名" Binding="{Binding Book}" Width="170" />
                    <DataGridTextColumn Header="場所" Binding="{Binding Location}" Width="100" />
                    <DataGridTextColumn Header="行" Binding="{Binding LineNumber}" Width="46" ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="セル" Binding="{Binding CellText}" Width="70" />
                    <DataGridTextColumn Header="該当行" Binding="{Binding Line}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ========== 9 プロセス停止 ========== -->
      <TabItem Header="9 プロセス停止">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="残っている Office のプロセス" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="変換が異常終了すると、画面に出ない Excel・Word・PowerPoint が残ることがあります。" />
            <Button Style="{StaticResource Danger}" Content="停止する" HorizontalAlignment="Left" Margin="0,14,0,0" />
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
