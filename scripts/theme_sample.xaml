<!-- モダンなデザインのサンプル画面。theme_sample.ps1 が読み込んで表示する（動作はしない。見た目だけの見本）。

     文字の設計:
       大きさ  16 / 13 / 12 / 11 の 4 段。見出し 13、本文 13、補助 12、細目 11。
       太さ    Normal と SemiBold の 2 段だけ。SemiBold は「その画面で今いちばん見るもの」に限る。
       濃さ    Ink.Strong（見出し・主役の値）＞ Ink.Body（本文）＞ Ink.Muted（補助）＞ Ink.Faint（入力前の案内）。
               すべてを黒にすると重要度が伝わらないため、本文は真っ黒にしない。
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="win_grep（モダン案）" Width="1000" Height="720" MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Background="#F6F7F9" UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.Resources>

    <!-- ============ 色のトークン（変えるのはここだけ） ============ -->
    <SolidColorBrush x:Key="Bg.Window"     Color="#F6F7F9" />
    <SolidColorBrush x:Key="Bg.Surface"    Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.Subtle"     Color="#FAFBFC" />
    <SolidColorBrush x:Key="Bg.Hover"      Color="#F3F5F7" />
    <SolidColorBrush x:Key="Bg.Pressed"    Color="#E8EBEF" />
    <SolidColorBrush x:Key="Border.Soft"   Color="#E9ECF0" />
    <SolidColorBrush x:Key="Border.Normal" Color="#D7DBE0" />

    <!-- 文字の濃さ 4 段。用途を混ぜない -->
    <SolidColorBrush x:Key="Ink.Strong"    Color="#1F2937" />
    <SolidColorBrush x:Key="Ink.Body"      Color="#414B5A" />
    <SolidColorBrush x:Key="Ink.Muted"     Color="#78828F" />
    <SolidColorBrush x:Key="Ink.Faint"     Color="#A3ABB5" />

    <SolidColorBrush x:Key="Accent"        Color="#2563EB" />
    <SolidColorBrush x:Key="Accent.Hover"  Color="#1D4ED8" />
    <SolidColorBrush x:Key="Accent.Soft"   Color="#EFF4FF" />
    <SolidColorBrush x:Key="Accent.Ring"   Color="#BFD3FE" />
    <SolidColorBrush x:Key="Danger.Text"   Color="#C2410C" />
    <SolidColorBrush x:Key="Danger.Line"   Color="#E9B8A3" />
    <SolidColorBrush x:Key="Danger.Soft"   Color="#FEF4EF" />
    <SolidColorBrush x:Key="Warn"          Color="#A16207" />
    <SolidColorBrush x:Key="Hit"           Color="#FDE68A" />

    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Card">10</CornerRadius>

    <!-- ============ 文字のスタイル ============ -->
    <!-- 既定＝本文。真っ黒にせず、見出しとの差を残す -->
    <Style TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Ink.Body}" />
    </Style>

    <!-- 区画の見出し。太さで区切りを作る -->
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
    </Style>

    <!-- 主役の値。画面で 1 つだけ（例: 進捗の件数、検索の件数） -->
    <Style x:Key="Focal" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
    </Style>

    <!-- 補助。説明文・ラベル -->
    <Style x:Key="Meta" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Ink.Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 細目。常時は読まない情報（進捗の内訳・ステータスバー） -->
    <Style x:Key="Micro" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource Ink.Faint}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 注意・エラー。色だけで区別し、太さは上げない -->
    <Style x:Key="WarnText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Warn}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 入力前の案内 -->
    <Style x:Key="Placeholder" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Ink.Faint}" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="10,0" />
    </Style>

    <!-- 表のセル。主キー列だけ濃く、他は落とす -->
    <Style x:Key="Cell" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Ink.Body}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Cell.Key" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
    </Style>
    <Style x:Key="Cell.Meta" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="Foreground" Value="{StaticResource Ink.Muted}" />
    </Style>
    <Style x:Key="Cell.Number" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Foreground" Value="{StaticResource Ink.Muted}" />
    </Style>

    <!-- ============ カード（区切りは影ではなく枠と背景の差で出す） ============ -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Bg.Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Soft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ============ ボタン ============ -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
      <Border x:Name="Ring" CornerRadius="7" Padding="1" Background="Transparent">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Control}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="Ring" Property="Background" Value="{StaticResource Accent.Ring}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 普通のボタンは太字にしない。押す先が 1 つに見えなくなるため -->
    <Style TargetType="Button">
      <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{StaticResource Bg.Surface}" />
      <Setter Property="Foreground" Value="{StaticResource Ink.Body}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Normal}" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Bg.Hover}" />
          <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{StaticResource Bg.Pressed}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- 主ボタンだけ太字＋塗り。画面で 1 つ -->
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Accent.Hover}" />
          <Setter Property="BorderBrush" Value="{StaticResource Accent.Hover}" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- 消す操作。赤は文字と枠だけに使い、面で塗らない -->
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource Danger.Text}" />
      <Setter Property="BorderBrush" Value="{StaticResource Danger.Line}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Danger.Soft}" />
          <Setter Property="BorderBrush" Value="{StaticResource Danger.Text}" />
          <Setter Property="Foreground" Value="{StaticResource Danger.Text}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="T" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                       FontSize="{TemplateBinding FontSize}"
                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 入力欄 ============ -->
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
      <Setter Property="CaretBrush" Value="{StaticResource Ink.Strong}" />
      <Setter Property="Background" Value="{StaticResource Bg.Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Normal}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Ring" CornerRadius="7" Padding="1" Background="Transparent">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource Radius.Control}">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" />
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink.Faint}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Ring" Property="Background" Value="{StaticResource Accent.Ring}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ チェックボックス ============ -->
    <Style TargetType="CheckBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Ink.Body}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Ring" CornerRadius="6" Padding="1" Background="Transparent" VerticalAlignment="Center">
                <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                        Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Normal}" BorderThickness="1">
                  <Grid>
                    <Path x:Name="Check" Visibility="Collapsed" Stretch="Uniform" Margin="3"
                          Stroke="White" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                          Data="M 0,4 L 3.2,7.2 L 9,1" />
                    <Rectangle x:Name="Mid" Visibility="Collapsed" Width="8" Height="2" RadiusX="1" RadiusY="1" Fill="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </Border>
              <ContentPresenter x:Name="Label" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Mid" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
              </Trigger>
              <!-- キーボードだけで操作する人に、今どこにいるかを見せる -->
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Background" Value="{StaticResource Accent.Ring}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ スクロールバー ============ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="T" Background="#CBD0D6" CornerRadius="4" Margin="3" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="T" Property="Background" Value="#A3ABB5" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="T" Property="Background" Value="#78828F" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollHidden" TargetType="RepeatButton">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="12" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageLeftCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageRightCommand" />
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ============ タブ ============ -->
    <Style TargetType="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Ink.Muted}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid x:Name="Root" Background="Transparent" Margin="0,0,4,0">
              <Border x:Name="Bd" Background="Transparent" CornerRadius="8,8,0,0" Padding="16,9">
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
              </Border>
              <Border x:Name="Line" Height="2" VerticalAlignment="Bottom" Margin="8,0" CornerRadius="1" Background="Transparent" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}" />
                <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Line" Property="Background" Value="{StaticResource Accent}" />
                <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent.Ring}" />
                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <DockPanel>
              <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,0,0,1">
                <TabPanel IsItemsHost="True" Panel.ZIndex="1" Margin="0,0,0,-1" />
              </Border>
              <ContentPresenter ContentSource="SelectedContent" Margin="0,16,0,0" />
            </DockPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 表 ============ -->
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Soft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{StaticResource Bg.Surface}" />
      <Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="RowHeight" Value="30" />
      <Setter Property="SelectionMode" Value="Extended" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="EnableRowVirtualization" Value="True" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>
    <!-- 列見出しは「読むもの」ではなく「位置を示す札」。小さく・薄く・太らせない -->
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource Bg.Subtle}" />
      <Setter Property="Foreground" Value="{StaticResource Ink.Muted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Soft}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="{StaticResource Bg.Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Soft}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Bg.Hover}" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource Accent.Soft}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Ink.Body}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ ツリー ============ -->
    <Style x:Key="TreeChevron" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" Width="18" Height="18">
              <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8" Stroke="{StaticResource Ink.Faint}" StrokeThickness="1.6"
                    StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.4,0.5" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Arrow" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="90" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource Ink.Strong}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="{StaticResource Ink.Body}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <StackPanel>
              <Border x:Name="Bd" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="2,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ToggleButton x:Name="Expander" Grid.Column="0" Style="{StaticResource TreeChevron}"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press" />
                  <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent.Soft}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent.Ring}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TreeView">
      <Setter Property="Background" Value="{StaticResource Bg.Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border.Soft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6" />
    </Style>

    <!-- ============ 進捗バー ============ -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="Background" Value="#E8EBEF" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
              <Grid>
                <Rectangle x:Name="PART_Track" />
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#1F2937" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- ==================== 画面 ==================== -->
  <DockPanel Margin="20,14,20,14">

    <!-- 下部：ステータス。常時は読まない情報なので一番小さく薄く -->
    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Micro}" Margin="2,12,0,0"
               Text="前回の変換: 2026-09-19 18:42／12 件を変換しました。" />

    <TabControl x:Name="Tabs">

      <!-- ========== 1 インデックス管理 ========== -->
      <TabItem Header="1 インデックス管理">
        <DockPanel>

          <!-- 下部：変換の開始と進捗 -->
          <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,13">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="変換を開始" MinWidth="150" Height="34" />
                <TextBlock Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="0,0,14,0"
                           Text="押すと、何件変換するかを確認してから、新しいファイル・変わったファイルだけを変換します。" />
              </DockPanel>
              <DockPanel Margin="0,14,0,0">
                <Button DockPanel.Dock="Right" Content="中止" Margin="12,0,0,0" MinWidth="72" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="ログを開く" Margin="12,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Meta}" VerticalAlignment="Center" Text="残り 約 2 分 10 秒" />
                <!-- この画面で今いちばん見る値。ここだけ大きく太く濃い -->
                <TextBlock Style="{StaticResource Focal}" VerticalAlignment="Center" Text="変換中 38 / 120 件" />
              </DockPanel>
              <ProgressBar Value="0.32" Maximum="1" Margin="0,9,0,0" />
              <TextBlock Style="{StaticResource Micro}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                         Text="見積書\2026\04_見積_東日本支社.xlsx を変換しています…" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- 見出しは太さで示し、補足は同じ行に小さく置く -->
              <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource Heading}" Text="インデックス一覧" />
                <TextBlock Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="10,0,0,0"
                           Text="チェックを付けたインデックスを変換します" />
              </StackPanel>

              <DockPanel Grid.Row="1" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" Width="150">
                  <Button Content="新規作成…" />
                  <Button Content="編集…" Margin="0,8,0,0" />
                  <Button Style="{StaticResource Danger}" Content="削除" Margin="0,8,0,0" />
                  <TextBlock Style="{StaticResource Micro}" Margin="2,14,0,0" Text="一覧にフォルダをドラッグ＆ドロップしても作成できます。" />
                </StackPanel>

                <DataGrid x:Name="IndexGrid" SelectionMode="Single" CanUserSortColumns="False">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="変換" Width="52">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- 主キーの列だけ濃くする。目で追う列を 1 本に絞る -->
                    <DataGridTextColumn Header="インデックス名" Binding="{Binding Name}" Width="150"
                                        ElementStyle="{StaticResource Cell.Key}" />
                    <DataGridTextColumn Header="元のフォルダ" Binding="{Binding Path}" Width="*"
                                        ElementStyle="{StaticResource Cell.Meta}" />
                    <DataGridTextColumn Header="フォルダの状態" Binding="{Binding StatusText}" Width="140"
                                        ElementStyle="{StaticResource Cell}" />
                    <DataGridTextColumn Header="ファイル" Binding="{Binding FileCountText}" Width="76"
                                        ElementStyle="{StaticResource Cell.Number}" />
                    <DataGridTextColumn Header="最終変換" Binding="{Binding LastConvertedText}" Width="100"
                                        ElementStyle="{StaticResource Cell.Meta}" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>

              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,6">
                <TextBlock Style="{StaticResource Heading}" Text="インデックスの状態" />
                <TextBlock Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="10,0,0,0"
                           Text="すべてのインデックスの合計" />
              </StackPanel>
              <StackPanel Grid.Row="3">
                <TextBlock Text="3 インデックス／412 ファイル／変換済み 400 件・未変換 9 件・失敗 3 件" />
                <TextBlock Style="{StaticResource WarnText}" Margin="0,6,0,0"
                           Text="9 件が未変換です。［変換を開始］を押すと変換します。" />
              </StackPanel>
            </Grid>
          </Border>
        </DockPanel>
      </TabItem>

      <!-- ========== 2 検索 ========== -->
      <TabItem Header="2 検索" IsSelected="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" MinWidth="150" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="420" />
          </Grid.ColumnDefinitions>

          <!-- 左：検索対象 -->
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="検索対象" Margin="0,0,0,10" />
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="すべて選択" MinWidth="0" Height="28" Padding="10,0" />
                <Button Content="すべて解除" MinWidth="0" Height="28" Padding="10,0" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Micro}" Margin="2,10,0,0"
                         Text="チェックしたインデックス・フォルダだけを検索します。" />
              <TreeView>
                <TreeViewItem IsExpanded="True">
                  <TreeViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox IsChecked="True" Focusable="False" />
                      <TextBlock Text="見積書" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Ink.Strong}" />
                    </StackPanel>
                  </TreeViewItem.Header>
                  <TreeViewItem>
                    <TreeViewItem.Header>
                      <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="True" Focusable="False" />
                        <TextBlock Text="2026" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" />
                      </StackPanel>
                    </TreeViewItem.Header>
                  </TreeViewItem>
                  <TreeViewItem>
                    <TreeViewItem.Header>
                      <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="False" Focusable="False" />
                        <TextBlock Text="2025" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" />
                      </StackPanel>
                    </TreeViewItem.Header>
                  </TreeViewItem>
                </TreeViewItem>
                <TreeViewItem IsExpanded="False">
                  <TreeViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox IsThreeState="True" Focusable="False" />
                      <TextBlock Text="議事録" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Ink.Strong}" />
                    </StackPanel>
                  </TreeViewItem.Header>
                  <TreeViewItem Header="2026" />
                </TreeViewItem>
                <TreeViewItem>
                  <TreeViewItem.Header>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox IsChecked="False" Focusable="False" />
                      <TextBlock Text="提案資料（見つかりません）" Margin="7,0,0,0" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" MaxWidth="160" Foreground="{StaticResource Warn}" />
                    </StackPanel>
                  </TreeViewItem.Header>
                </TreeViewItem>
              </TreeView>
            </DockPanel>
          </Border>

          <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" />

          <!-- 右：検索ワードと結果 -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,14">
              <StackPanel>
                <DockPanel>
                  <TextBlock Style="{StaticResource Heading}" Text="検索ワード" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="検索" MinWidth="110" Height="34" Margin="10,0,0,0" />
                  <TextBox Height="34" Text="消費税" />
                </DockPanel>
                <DockPanel Margin="0,12,0,0">
                  <CheckBox DockPanel.Dock="Left" Content="大文字と小文字を区別" VerticalAlignment="Center" Margin="0,0,18,0" />
                  <CheckBox DockPanel.Dock="Left" Content="正規表現を使う" IsChecked="True" VerticalAlignment="Center" Margin="0,0,18,0" />
                  <TextBlock DockPanel.Dock="Left" Text="対象ファイル" Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox MaxWidth="320" HorizontalAlignment="Stretch" FontSize="12" Text="*.xlsx;見積;!*old*" />
                </DockPanel>
              </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,14">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                  <Grid DockPanel.Dock="Right" Width="220">
                    <TextBox FontSize="12" />
                    <TextBlock Style="{StaticResource Placeholder}" FontSize="12" Text="結果の中から探す" />
                  </Grid>
                  <TextBlock DockPanel.Dock="Right" Text="絞り込み" Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <!-- 検索画面の主役の値 -->
                  <TextBlock Style="{StaticResource Focal}" VerticalAlignment="Center" Text="47 件（12 ファイル）" />
                </DockPanel>

                <DataGrid x:Name="ResultGrid">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="フォルダ" Binding="{Binding RelDir}" Width="130"
                                        ElementStyle="{StaticResource Cell.Meta}" />
                    <DataGridTextColumn Header="ファイル名" Binding="{Binding Book}" Width="170"
                                        ElementStyle="{StaticResource Cell.Key}" />
                    <DataGridTextColumn Header="場所" Binding="{Binding Location}" Width="100"
                                        ElementStyle="{StaticResource Cell.Meta}" />
                    <DataGridTextColumn Header="行" Binding="{Binding LineNumber}" Width="46"
                                        ElementStyle="{StaticResource Cell.Number}" />
                    <DataGridTextColumn Header="セル" Binding="{Binding CellText}" Width="70"
                                        ElementStyle="{StaticResource Cell.Meta}" />
                    <DataGridTextColumn Header="該当行" Binding="{Binding Line}" Width="*"
                                        ElementStyle="{StaticResource Cell}" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ========== 9 プロセス停止 ========== -->
      <TabItem Header="9 プロセス停止">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="残っている Office のプロセス" />
            <TextBlock Style="{StaticResource Meta}" Margin="0,6,0,0"
                       Text="変換が異常終了すると、画面に出ない Excel・Word・PowerPoint が残ることがあります。" />
            <Button Style="{StaticResource Danger}" Content="停止する" HorizontalAlignment="Left" Margin="0,14,0,0" />
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
