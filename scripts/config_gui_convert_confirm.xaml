<!-- 変換の確認ダイアログ（［変換を開始］を押した後、変換対象を数え終えたときに開く）。config_gui.ps1 が読み込む -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="変換の確認" Width="880" Height="500" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="13"
        Background="White" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}" />
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#1D4ED8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#6B7280" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB" />
      <Setter Property="BorderBrush" Value="#9CA3AF" />
      <Setter Property="Background" Value="White" />
      <Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="CanUserSortColumns" Value="False" />
      <Setter Property="CanUserReorderColumns" Value="False" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#F3F4F6" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="StartButton" Style="{StaticResource Primary}" Content="変換を開始" IsDefault="True" MinWidth="130" />
      <Button x:Name="CancelButton" Content="キャンセル" IsCancel="True" Margin="8,0,0,0" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <CheckBox x:Name="RetryCheck" Visibility="Collapsed" Margin="0,0,0,8" />
      <TextBlock x:Name="TotalText" FontWeight="SemiBold" Foreground="#1F2937" TextWrapping="Wrap" />
      <TextBlock x:Name="NoteText" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="Collapsed" />
    </StackPanel>

    <TextBlock x:Name="IntroText" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10" />

    <DataGrid x:Name="PlanGrid" MinHeight="120" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="インデックス" Width="140">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="変換対象" Width="110">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding TargetText}" FontWeight="SemiBold" Foreground="{Binding TargetBrush}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="内訳" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Office ファイル" Width="105">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding TotalText}" TextAlignment="Right" HorizontalAlignment="Stretch" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="元のフォルダ" Width="180">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Foreground="#6B7280" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
