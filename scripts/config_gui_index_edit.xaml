<!-- インデックスの新規作成・編集ダイアログ（［1 インデックス管理］タブ）。config_gui.ps1 が読み込む -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="インデックス" Width="620" Height="360" MinWidth="520" MinHeight="330"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="13"
        Background="White" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="BorderBrush" Value="#9CA3AF" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1F2937" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#6B7280" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="OK" IsDefault="True" />
      <Button x:Name="CancelButton" Content="キャンセル" IsCancel="True" Margin="8,0,0,0" />
    </StackPanel>

    <StackPanel>
      <TextBlock x:Name="IntroText" Style="{StaticResource Hint}" Margin="0,0,0,4" />

      <TextBlock Style="{StaticResource Label}" Text="元のフォルダ（Office ファイルのある場所）" />
      <DockPanel>
        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="参照…" Margin="6,0,0,0" />
        <TextBox x:Name="FolderBox" AllowDrop="True" />
      </DockPanel>
      <TextBlock x:Name="FolderHint" Style="{StaticResource Hint}"
                 Text="パスの入力・貼り付け・フォルダのドラッグ＆ドロップで指定できます。" />

      <TextBlock Style="{StaticResource Label}" Text="インデックス名" />
      <TextBox x:Name="NameBox" />
      <TextBlock x:Name="NameHint" Style="{StaticResource Hint}"
                 Text="検索対象の一覧と検索結果に、この名前が出ます。\ / : * ? &quot; &lt; &gt; | は使えません。" />

      <TextBlock x:Name="NoticeText" Style="{StaticResource Hint}" Foreground="#B45309" Margin="0,12,0,0" Visibility="Collapsed" />
      <TextBlock x:Name="ErrorText" Style="{StaticResource Hint}" Foreground="#B91C1C" Margin="0,10,0,0" Visibility="Collapsed" />
    </StackPanel>
  </DockPanel>
</Window>
