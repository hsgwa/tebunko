<!-- 設定の画面（ワークスペース・設定ファイルの場所）。tebunko.xaml の ContentHost に入れる（gui_main.ps1）。
     節は枠つきのカード（Section.Card）で、上に見出しの帯（Section.Header）、その下に行（Section.Row。左に名前と説明、右に値と操作）を縦に並べる。
     中身の幅は最大 880 で左に寄せ、カードの間は 16（2 つ目からのカードに Margin="0,16,0,0" を付ける）。縦にスクロールできる。 -->
<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <ScrollViewer.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- 見せるだけの場所の読み取り専用の文字。共通の入力欄の見た目（枠・高さ 30・マウスや選択での枠の色）を持たず、折り返しても全部見える -->
      <Style x:Key="ReadOnlyValueText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Select.Text}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- 選択肢のラジオ。16×16 の丸で、枠は入力欄と同じ（Border.Input）、選ぶと Accent の枠と点。キーボードで選んだときは Accent.Ring の輪を出す -->
      <Style x:Key="OptionRadio" TargetType="RadioButton">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Ink.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <StackPanel Orientation="Horizontal" Background="Transparent">
                <Border x:Name="Ring" CornerRadius="10" Padding="1" Background="Transparent" VerticalAlignment="Center">
                  <Border x:Name="Circle" Width="16" Height="16" CornerRadius="8" Background="{StaticResource Bg.Surface}"
                          BorderBrush="{StaticResource Border.Input}" BorderThickness="1">
                    <Ellipse x:Name="Dot" Visibility="Collapsed" Width="8" Height="8" Fill="{StaticResource Accent}" />
                  </Border>
                </Border>
                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource Accent}" />
                  <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource Accent}" />
                  <Setter Property="Foreground" Value="{StaticResource Ink.Strong}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Ring" Property="Background" Value="{StaticResource Accent.Ring}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </ScrollViewer.Resources>
  <Grid Margin="0,16,0,24">
    <!-- 幅は最大 880 で左に寄せる（StackPanel を左寄せにすると中身の幅に縮むため、列の最大幅で抑える） -->
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MaxWidth="880" />
    </Grid.ColumnDefinitions>
    <StackPanel>
      <!-- インデックス設定（ワークスペース。インデックス・取り込み一覧・ログを置くフォルダ。既定は work）。ツールのフォルダの外にも置ける -->
      <Border Style="{StaticResource Section.Card}">
        <StackPanel>
          <Border Style="{StaticResource Section.Header}">
            <TextBlock Style="{StaticResource Label.Strong}" VerticalAlignment="Center" Text="インデックス設定" />
          </Border>

          <Border Style="{StaticResource Section.Row}" BorderThickness="0">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Top">
                  <!-- パスは欄に直接入力して変えられる（Enter か欄から出たときに確定、Esc で取り消す）。［変更…］はフォルダを選ぶ画面から入れる -->
                  <TextBox x:Name="WorkspaceBox" Width="360" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="WorkspaceBox" AutomationProperties.Name="ワークスペースのパス" />
                  <Button x:Name="ChangeWorkspaceButton" Content="変更…" MinWidth="64" Margin="8,0,0,0"
                          ToolTip="空のフォルダを選んで、ワークスペースにします（今のワークスペースの中身は新しいフォルダへ移します）" />
                  <Button x:Name="ResetWorkspaceButton" Content="既定に戻す" MinWidth="80" Margin="8,0,0,0" Visibility="Collapsed"
                          ToolTip="設定ファイルと同じフォルダの work に戻します" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Foreground="{StaticResource Ink.Strong}" Text="ワークスペース" />
                  <TextBlock Style="{StaticResource Meta}" Margin="0,2,0,0" Text="インデックスとログの保存先" />
                </StackPanel>
              </DockPanel>
              <TextBlock x:Name="WorkspaceInputError" Style="{StaticResource ErrorText}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                         AutomationProperties.AutomationId="WorkspaceInputError" />
              <TextBlock x:Name="WorkspaceNote" Style="{StaticResource Micro}" Margin="0,8,0,0" TextWrapping="Wrap" />
              <!-- 注意（文字がそのまま入る・更新中は変えられない）を先に、やり方をあとに置く（文言は getWorkspaceCautionTexts） -->
              <TextBlock x:Name="WorkspaceCaution" Style="{StaticResource Meta}" Margin="0,8,0,0" TextWrapping="Wrap" />
              <TextBlock x:Name="WorkspaceHowTo" Style="{StaticResource Meta}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- 設定ファイルの場所（表示だけ。選んでコピーはできる） -->
          <Border Style="{StaticResource Section.Row}">
            <StackPanel>
              <DockPanel>
                <!-- 見せるだけの場所。押す欄に見えないよう枠を付けず、選んでコピーできる読み取り専用の TextBox にする -->
                <TextBox x:Name="SettingsFileText" Style="{StaticResource ReadOnlyValueText}" DockPanel.Dock="Right"
                         Margin="12,0,0,0" MaxWidth="360" VerticalAlignment="Top" TextAlignment="Right" />
                <StackPanel>
                  <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Foreground="{StaticResource Ink.Strong}" Text="設定ファイル" />
                  <TextBlock Style="{StaticResource Meta}" Margin="0,2,0,0" Text="設定の保存先（変更不可）" />
                </StackPanel>
              </DockPanel>
              <TextBlock x:Name="SettingsFileNote" Style="{StaticResource Micro}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- 検索結果の件数の上限（設定 searchLimit）。制限なしは 0。確定すると、次の検索から効く（文言と可否は settings_view.ps1 の getSearchLimit*） -->
      <Border Style="{StaticResource Section.Card}" Margin="0,16,0,0">
        <StackPanel>
          <Border Style="{StaticResource Section.Header}">
            <TextBlock Style="{StaticResource Label.Strong}" VerticalAlignment="Center" Text="検索結果" />
          </Border>

          <Border Style="{StaticResource Section.Row}" BorderThickness="0">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SearchLimitedRadio" GroupName="SearchLimit" Style="{StaticResource OptionRadio}" Content="制限あり" VerticalAlignment="Center"
                                 AutomationProperties.AutomationId="SearchLimitedRadio" />
                    <TextBox x:Name="SearchLimitBox" Width="96" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                             AutomationProperties.AutomationId="SearchLimitBox" AutomationProperties.Name="検索結果の件数の上限" />
                    <TextBlock Style="{StaticResource Body}" Margin="6,0,0,0" VerticalAlignment="Center" Text="件" />
                  </StackPanel>
                  <RadioButton x:Name="SearchNoneRadio" GroupName="SearchLimit" Style="{StaticResource OptionRadio}" Content="制限なし" Margin="0,10,0,0"
                               HorizontalAlignment="Left" AutomationProperties.AutomationId="SearchNoneRadio" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Foreground="{StaticResource Ink.Strong}" Text="検索結果の件数の上限" />
                  <TextBlock Style="{StaticResource Meta}" Margin="0,2,0,0" Text="この件数に達したら検索をやめます" />
                </StackPanel>
              </DockPanel>
              <!-- 入力が正しくないときの理由。場所はいつも空けておき、出ても下の行が動かない -->
              <TextBlock x:Name="SearchLimitInputError" Style="{StaticResource ErrorText}" Margin="0,8,0,0" MinHeight="16" TextWrapping="Wrap" Visibility="Hidden"
                         AutomationProperties.AutomationId="SearchLimitInputError" />
              <TextBlock x:Name="SearchLimitRange" Style="{StaticResource Micro}" Margin="0,8,0,0" TextWrapping="Wrap" />
              <TextBlock x:Name="SearchLimitCaution" Style="{StaticResource Meta}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</ScrollViewer>
