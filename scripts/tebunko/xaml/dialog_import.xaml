<!-- インデックスのインポートのダイアログ（［インデックス管理］タブの［インポート…］）。gui_main.ps1 の側（index_archive.ps1）が読み込む。
     色・文字・コントロールの形は scripts/shared/xaml/theme.xaml にまとめてある。 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="インデックスのインポート" Width="620" Height="440" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        FontFamily="{DynamicResource Font.Body}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource Bg.Surface}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="18,16,18,16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" Content="キャンセル" IsCancel="True" MinWidth="104" Height="32" Margin="0,0,8,0" />
      <Button x:Name="ImportButton" Style="{StaticResource Primary}" Content="インポート" IsDefault="True" MinWidth="104" Height="32" />
    </StackPanel>

    <StackPanel>
      <!-- 見出しの代わりに、zip の中身を枠で示す（名前・エクスポートした日時・ファイル数と大きさと版） -->
      <Border Background="{StaticResource Bg.Summary}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1" CornerRadius="6" Padding="12,10">
        <StackPanel>
          <TextBlock x:Name="ImportTitleText" Style="{StaticResource Label.Strong}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="ImportExportedText" Style="{StaticResource Meta}" Margin="0,2,0,0" />
          <TextBlock x:Name="ImportSizeText" Style="{StaticResource Meta}" Margin="0,2,0,0" />
        </StackPanel>
      </Border>
      <TextBlock x:Name="IntroText" Style="{StaticResource Meta}" Margin="0,8,0,6" TextWrapping="Wrap" />

      <TextBlock Style="{StaticResource Label}" HorizontalAlignment="Left" Margin="0,12,0,6"
                 Text="元のフォルダ（Office ファイルのある場所）" />
      <DockPanel>
        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="参照…" MinWidth="80" Margin="8,0,0,0" />
        <TextBox x:Name="FolderBox" AllowDrop="True" />
      </DockPanel>
      <TextBlock x:Name="SourceCheckText" Style="{StaticResource Meta}" Margin="2,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
      <TextBlock x:Name="FolderHint" Style="{StaticResource Micro}" Margin="2,4,0,0"
                 Text="パスの入力・貼り付け・フォルダのドラッグ＆ドロップで指定できます。" />

      <TextBlock Style="{StaticResource Label}" HorizontalAlignment="Left" Margin="0,14,0,6" Text="名前" />
      <TextBox x:Name="NameBox" />
      <TextBlock x:Name="NameHint" Style="{StaticResource Micro}" Margin="2,6,0,0"
                 Text="検索対象の一覧と検索結果に、この名前が出ます。\ / : * ? &quot; &lt; &gt; | は使えません。" />

      <TextBlock x:Name="NoticeText" Style="{StaticResource WarnText}" Margin="0,14,0,0" Visibility="Collapsed" />
      <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,10,0,0" Visibility="Collapsed" />
    </StackPanel>
  </DockPanel>
</Window>
