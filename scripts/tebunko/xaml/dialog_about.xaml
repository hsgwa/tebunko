<!-- 「バージョン情報」ダイアログ（ナビ下の「バージョン情報」）。gui.ps1（ui/about_dialog.ps1）が読み込む。
     版・コミットは中身を見るだけの表示で、確認や入力は無い（docs/design/gui/common.md「表示・アクセシビリティ」の例外）。
     色・文字・コントロールの形は scripts/shared/xaml/theme.xaml にまとめてある。 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="バージョン情報" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource Font.Body}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource Bg.Surface}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="28,24,28,20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="CloseButton" Content="OK" Style="{StaticResource Primary}" IsCancel="True" IsDefault="True" MinWidth="80" Height="32" />
    </StackPanel>

    <StackPanel>
      <Image x:Name="AppIcon" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" />
      <TextBlock Text="tebunko" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink.Strong}"
                 HorizontalAlignment="Center" Margin="0,12,0,0" />
      <TextBlock Style="{StaticResource Body}" Text="Office ファイル内テキスト検索ツール" Foreground="{StaticResource Ink.Muted}"
                 HorizontalAlignment="Center" Margin="0,8,0,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
        <TextBlock x:Name="VersionText" Style="{StaticResource Meta}" />
        <TextBlock x:Name="CommitText" Style="{StaticResource Meta}" Margin="12,0,0,0" />
      </StackPanel>
      <Separator Margin="0,16,0,16" Background="{StaticResource Border.Soft}" />
      <Border Background="{StaticResource Bg.Subtle}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1"
              CornerRadius="{StaticResource Radius.Control}" Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Meta}" FontWeight="SemiBold" Text="動作環境：" Margin="0,0,12,0" />
          <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Meta}" Foreground="{StaticResource Ink.Body}" Text="Windows 10 / 11" />
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Meta}" FontWeight="SemiBold" Text="ランタイム：" Margin="0,6,12,0" />
          <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Meta}" Foreground="{StaticResource Ink.Body}" Text="PowerShell 5.1 + WPF" Margin="0,6,0,0" />
        </Grid>
      </Border>
      <TextBlock Style="{StaticResource Micro}" Margin="0,14,0,0" Text="MIT ライセンスで公開しています" />
    </StackPanel>
  </DockPanel>
</Window>
