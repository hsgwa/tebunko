<!-- 「tebunko について」ダイアログ（タブ右端の［⋯］メニュー）。gui.ps1（ui/about_dialog.ps1）が読み込む。
     版・コミットは中身を見るだけの表示で、確認や入力は無い（docs/design/gui/common.md「表示・アクセシビリティ」の例外）。
     色・文字・コントロールの形は scripts/shared/xaml/theme.xaml にまとめてある。 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="tebunko について" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Background="White" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="20,18,20,16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="CloseButton" Content="閉じる" IsCancel="True" IsDefault="True" MinWidth="96" Height="32" />
    </StackPanel>

    <DockPanel>
      <Image x:Name="AppIcon" DockPanel.Dock="Left" Width="56" Height="56" Stretch="Uniform"
             VerticalAlignment="Top" Margin="0,2,18,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Style="{StaticResource DialogHeading}" Text="tebunko" />
        <TextBlock x:Name="VersionText" Style="{StaticResource Meta}" Margin="0,10,0,0" />
        <TextBlock x:Name="CommitText" Style="{StaticResource Meta}" Margin="0,4,0,0" />
        <TextBlock Style="{StaticResource Micro}" Margin="0,10,0,0" Text="ライセンス: MIT" />
      </StackPanel>
    </DockPanel>
  </DockPanel>
</Window>
