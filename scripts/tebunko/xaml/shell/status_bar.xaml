<!-- ステータスバー（直前の操作の結果）。tebunko.xaml の StatusBarHost に入れる（gui_main.ps1）。
     常時は読まない情報なので、小さく薄くする -->
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Bg.Hover}" BorderBrush="{DynamicResource Border.Soft}" BorderThickness="0,1,0,0">
  <Border.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Border.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <!-- インデックス管理の画面のときだけ出す、登録のフォルダ数（左）とファイルの合計（右）（ui/shell/nav.ps1 が出し入れ、ui/index/index_list.ps1 が文言を入れる） -->
    <TextBlock x:Name="IndexFooterFolders" Grid.Column="0" Style="{StaticResource Micro}" Foreground="{StaticResource Ink.Muted}" Margin="12,0,0,0"
               VerticalAlignment="Center" Visibility="Collapsed" Text="登録済み: 0 フォルダ" />
    <TextBlock x:Name="IndexFooterFiles" Grid.Column="2" Style="{StaticResource Micro}" Foreground="{StaticResource Ink.Muted}" Margin="12,0,12,0"
               VerticalAlignment="Center" Visibility="Collapsed" Text="合計: 0 ファイル" />
    <Grid Grid.Column="1">
      <TextBlock x:Name="StatusText" Style="{StaticResource Micro}" Foreground="{StaticResource Ink.Body}" Margin="12,0,12,0" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      <!-- 更新中だけ出す 1 行（ui/shell/status_bar.ps1）。出すときは StatusText を隠す。背景は変えない -->
      <TextBlock x:Name="IndexingStatusText" Style="{StaticResource Micro}" Foreground="{StaticResource Ink.Body}" Margin="12,0,12,0" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="Collapsed" />
    </Grid>
  </Grid>
</Border>
