<!-- ナビ（左の欄）。tebunko.xaml の NavHost に入れる（gui_main.ps1）。
     項目の名前（SearchTab・IndexTab・SettingsTab・KillTab）は、前のタブと同じ。画面の切り替えは ui/nav.ps1 の selectScreen を通す。
     NavPaneHost は、検索の画面のときに検索対象のツリーを差す口（今は空）。 -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource Bg.Subtle}">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Grid.Resources>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="1" />
    <RowDefinition Height="*" />
    <RowDefinition Height="1" />
    <RowDefinition Height="28" />
  </Grid.RowDefinitions>

  <ListBox x:Name="NavList" Grid.Row="0" Style="{StaticResource Nav.List}" Margin="0,8,0,0"
           AutomationProperties.Name="画面">
    <ListBoxItem x:Name="SearchTab" Style="{StaticResource NavItem}">
      <TextBlock Style="{x:Null}" Text="検索" />
    </ListBoxItem>
    <ListBoxItem x:Name="IndexTab" Style="{StaticResource NavItem}">
      <DockPanel>
        <!-- 取り込みに失敗したファイルがあるときの印 -->
        <TextBlock x:Name="IndexTabBadge" DockPanel.Dock="Right" Style="{x:Null}" Text="⚠" Visibility="Collapsed"
                   Foreground="{StaticResource Warn.Strong}" VerticalAlignment="Center" ToolTip="取り込みに失敗したファイルがあります" />
        <TextBlock Style="{x:Null}" Text="インデックス管理" />
      </DockPanel>
    </ListBoxItem>
    <ListBoxItem x:Name="SettingsTab" Style="{StaticResource NavItem}">
      <TextBlock Style="{x:Null}" Text="設定" />
    </ListBoxItem>
    <ListBoxItem x:Name="KillTab" Style="{StaticResource NavItem}">
      <DockPanel>
        <!-- バックグラウンドの Office が残っているときの印 -->
        <TextBlock x:Name="KillTabBadge" DockPanel.Dock="Right" Style="{x:Null}" Text="⚠" Visibility="Collapsed"
                   Foreground="{StaticResource Warn.Strong}" VerticalAlignment="Center" ToolTip="バックグラウンドの Office が残っています" />
        <TextBlock Style="{x:Null}" Text="Office の停止" />
      </DockPanel>
    </ListBoxItem>
  </ListBox>

  <Rectangle Grid.Row="1" Fill="{StaticResource Border.Separator}" />

  <ContentControl x:Name="NavPaneHost" Grid.Row="2" Focusable="False" IsTabStop="False"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

  <Rectangle Grid.Row="3" Fill="{StaticResource Border.Separator}" />
  <Button x:Name="AboutLink" Grid.Row="4" Style="{StaticResource Link}" HorizontalAlignment="Left" VerticalAlignment="Center"
          Margin="21,0,12,0" Content="tebunko について" AutomationProperties.Name="tebunko について" />
</Grid>
