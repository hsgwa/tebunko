<!-- 画面の上の知らせの帯 1 つ分。検索の画面・インデックス管理の画面・窓の上の 3 か所に差す（shell\regions.ps1 の領域の表。差す所ごとに Prefix を付けた名前で持つ）。
     文言・色・閉じられるか・ボタンは notice_banner.ps1 が、そのとき出す内容で決める -->
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="NoticePanel" Visibility="Collapsed" Style="{DynamicResource Banner}"
        Background="{DynamicResource Warn.Soft}" BorderBrush="{DynamicResource Warn}">
  <Border.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Border.Resources>
  <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
      <Button x:Name="NoticeButton" Style="{StaticResource Banner.Button}" Margin="10,0,0,0" Visibility="Collapsed" />
      <Button x:Name="NoticeClose" Style="{StaticResource Banner.Close}" Margin="10,0,0,0" ToolTip="閉じる"
              AutomationProperties.Name="帯を閉じる" />
    </StackPanel>
    <Path x:Name="NoticeIcon" DockPanel.Dock="Left" Data="{StaticResource Icon.CircleAlert}" Width="16" Height="16" Stretch="Uniform"
          Stroke="{StaticResource Warn}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
          Fill="Transparent" VerticalAlignment="Center" Margin="0,0,10,0" />
    <TextBlock x:Name="NoticeText" Style="{StaticResource Focal}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Banner.Warn.Text}"
               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
  </DockPanel>
</Border>
