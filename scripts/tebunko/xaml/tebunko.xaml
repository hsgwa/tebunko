<!-- 画面の枠（ウィンドウとタブ）。gui.ps1 が読み込み、各タブの中身は tab_*.xaml から入れる。
     色・文字・コントロールの形は scripts/shared/xaml/theme.xaml にまとめてある（loadWindow が読み込む）。 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="tebunko" Width="1000" Height="720" MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Background="#F6F7F9" UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.TaskbarItemInfo>
    <TaskbarItemInfo />
  </Window.TaskbarItemInfo>

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="20,14,20,14">

    <!-- 下部：ステータス表示（直前の操作の結果）。常時は読まない情報なので一番小さく薄くする -->
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource Micro}" Margin="2,12,0,0"
               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

    <TabControl x:Name="Tabs">

      <!-- ================= 1 インデックス管理 ================= -->
      <TabItem x:Name="IndexTab">
        <TabItem.Header>
          <!-- Style を外して、選択中のタブの文字色・太さ（TabItem 側）を受け継ぐ -->
          <TextBlock x:Name="IndexTabHeader" Style="{x:Null}" Text="1 インデックス管理" />
        </TabItem.Header>
        <!-- 中身は tab_index.xaml（gui.ps1 が読み込んで入れる） -->
      </TabItem>

      <!-- ================= 2 検索 ================= -->
      <TabItem x:Name="SearchTab">
        <TabItem.Header>
          <TextBlock Style="{x:Null}" Text="2 検索" />
        </TabItem.Header>
        <!-- 中身は tab_search.xaml（gui.ps1 が読み込んで入れる） -->
      </TabItem>

      <!-- ================= 8 設定 ================= -->
      <TabItem x:Name="SettingsTab">
        <TabItem.Header>
          <TextBlock Style="{x:Null}" Text="8 設定" />
        </TabItem.Header>
        <!-- 中身は tab_settings.xaml（gui.ps1 が読み込んで入れる） -->
      </TabItem>

      <!-- ================= 9 プロセス停止 ================= -->
      <TabItem x:Name="KillTab">
        <TabItem.Header>
          <TextBlock x:Name="KillTabHeader" Style="{x:Null}" Text="9 プロセス停止" />
        </TabItem.Header>
        <!-- 中身は tab_kill.xaml（gui.ps1 が読み込んで入れる） -->
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
