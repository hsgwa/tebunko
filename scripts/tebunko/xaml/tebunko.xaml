<!-- 画面の枠（ウィンドウ）。左にナビ、右に中身（ContentHost）とステータスバーを並べる。
     gui_main.ps1 が読み込み、ナビは shell/nav.xaml、ステータスバーは shell/status_bar.xaml、中身は画面ごとの XAML から入れる。
     タイトルバーは OS のものを使う（絵で描いた二重のタイトルバーは置かない）。
     色・文字・コントロールの形は scripts/shared/xaml/theme.xaml にまとめてある（loadWindow が読み込む）。 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="tebunko" Width="1280" Height="820" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource Font.Body}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource Bg.Surface}" UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.TaskbarItemInfo>
    <TaskbarItemInfo />
  </Window.TaskbarItemInfo>

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <!-- 左の欄は既定 220・最小 180・最大 360。右端の 1px の線をつまんで幅を変える -->
      <ColumnDefinition Width="220" MinWidth="180" MaxWidth="360" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ナビ（shell/nav.xaml） -->
    <ContentControl x:Name="NavHost" Grid.Column="0" Focusable="False" IsTabStop="False"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

    <Rectangle Grid.Column="1" Fill="{StaticResource Border.Splitter}" />
    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                  Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                  Focusable="False" AutomationProperties.Name="左の欄の幅" />

    <!-- 主な領域：中身（画面）とステータスバー。ステータスバーは左の欄の下には付かない -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="24" />
      </Grid.RowDefinitions>
      <!-- 窓の上の知らせの帯（ワークスペースが使えないとき。notice_banner.ps1）。画面を切り替えても残る -->
      <Border x:Name="WorkspaceNoticePanel" Visibility="Collapsed" Style="{StaticResource Banner}"
          Background="{StaticResource Warn.Soft}" BorderBrush="{StaticResource Warn}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
        <Button x:Name="WorkspaceNoticeButton" Style="{StaticResource Banner.Button}" Margin="10,0,0,0" Visibility="Collapsed" />
        <Button x:Name="WorkspaceNoticeClose" Style="{StaticResource Banner.Close}" Margin="10,0,0,0" ToolTip="閉じる"
                AutomationProperties.Name="帯を閉じる" />
      </StackPanel>
      <Path x:Name="WorkspaceNoticeIcon" DockPanel.Dock="Left" Data="{StaticResource Icon.CircleAlert}" Width="16" Height="16" Stretch="Uniform"
            Stroke="{StaticResource Warn}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Fill="Transparent" VerticalAlignment="Center" Margin="0,0,10,0" />
      <TextBlock x:Name="WorkspaceNoticeText" Style="{StaticResource Focal}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Banner.Warn.Text}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
    </DockPanel>
  </Border>
      <ContentControl x:Name="ContentHost" Grid.Row="1" Margin="16,12,16,12" Focusable="False" IsTabStop="False"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      <ContentControl x:Name="StatusBarHost" Grid.Row="2" Focusable="False" IsTabStop="False"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>

    <!-- 暗幕。ダイアログを出している間だけ、窓いっぱいに掛ける（shell.ps1 の showOwnedDialog が出し入れする） -->
    <Border x:Name="ScrimOverlay" Grid.Column="0" Grid.ColumnSpan="3" Panel.ZIndex="100"
            Background="{DynamicResource Overlay.Scrim}" Visibility="Collapsed" />
  </Grid>
</Window>
