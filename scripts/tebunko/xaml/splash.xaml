<!-- 起動中の表示。gui.ps1 がスクリプトを読み込む前に出し、画面（tebunko.xaml）が描き終わったら閉じる。
     早く出すため theme.xaml は読み込まず、色は theme.xaml と同じ値を直接書く
     （Bg.Window・Border.Normal・Ink.Strong・Ink.Muted・Accent・Border.Soft）。
     アイコンは showSplash が読めたときだけ SplashIcon に入れる（読めなくても起動は続ける）。 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="tebunko" Width="480" Height="300"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Background="#FFFFFF" BorderBrush="#D7DBE0" BorderThickness="1,0,1,1"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <DockPanel>
    <Border DockPanel.Dock="Top" Height="4" Background="#2563EB" />
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="240">
      <Image x:Name="SplashIcon" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,16" />
      <TextBlock Text="tebunko" FontSize="22" FontWeight="SemiBold" Foreground="#1F2937"
                 HorizontalAlignment="Center" Margin="0,0,0,20" />
      <ProgressBar x:Name="SplashProgress" Height="4" Minimum="0" Maximum="100" Value="0"
                   Foreground="#2563EB" Background="#E9ECF0" BorderThickness="0" />
      <TextBlock Text="起動中…" Margin="0,10,0,0" Foreground="#78828F" FontSize="12"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </DockPanel>
</Window>
