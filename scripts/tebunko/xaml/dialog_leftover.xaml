<!-- 前回残った Office の終了の確認（起動時）。ui/leftover_dialog.ps1 が読み込む。
     形は確認ダイアログ（shared/xaml/dialog_confirm.xaml）と同じで、見出し・結果の欄・補足・ボタンに、詳細の一覧（開け閉めできる）を足したもの。
     色・文字・コントロールの形は scripts/shared/xaml/theme.xaml にまとめてある。 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Office の終了" Width="520" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{DynamicResource Font.Body}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource Bg.Surface}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="8,0,0,0" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="20,16,20,20">
    <StackPanel x:Name="ButtonPanel" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="LeftoverCancelButton" IsCancel="True" IsDefault="True" />
      <Button x:Name="LeftoverStopButton" Style="{StaticResource Primary}" />
    </StackPanel>

    <StackPanel>
      <TextBlock x:Name="HeadingText" Style="{StaticResource Body}" TextWrapping="Wrap" />

      <!-- 結果：終了すると何が閉じて何が残るか -->
      <Border Margin="0,12,0,0" Background="{StaticResource Bg.Subtle}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1"
              CornerRadius="{StaticResource Radius.Card}" Padding="14,10">
        <ItemsControl x:Name="FactsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,5">
                <TextBlock DockPanel.Dock="Left" Width="22" VerticalAlignment="Top" FontWeight="SemiBold"
                           Text="{Binding Mark}" Foreground="{Binding MarkBrush}" />
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Foreground="{StaticResource Ink.Strong}" TextWrapping="Wrap" />
                  <TextBlock Style="{StaticResource Meta}" Text="{Binding Detail}" Margin="0,3,0,0" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- 詳細の開け閉め（既定は閉じている） -->
      <ToggleButton x:Name="DetailToggleButton" HorizontalAlignment="Left" Margin="0,10,0,0" MinWidth="0" Height="Auto" Padding="0,2"
              Cursor="Hand" Background="Transparent" BorderThickness="0"
              AutomationProperties.AutomationId="LeftoverDetailToggle">
        <ToggleButton.Template>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Ring" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent">
              <StackPanel Orientation="Horizontal">
                <Path x:Name="ToggleIcon" Data="{StaticResource Icon.ChevronRight}" Width="12" Height="12" Stretch="Uniform"
                      Stroke="{StaticResource Ink.Muted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" VerticalAlignment="Center" Margin="2,0,8,0" />
                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource Meta}"
                           Foreground="{StaticResource Ink.Muted}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Background" Value="{StaticResource Accent.Ring}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleIcon" Property="Data" Value="{StaticResource Icon.ChevronDown}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </ToggleButton.Template>
      </ToggleButton>

      <!-- 詳細：アプリ・PID・起動した時刻。数が多いときは一覧の中で動かす -->
      <Border x:Name="DetailBox" Visibility="Collapsed" Margin="0,8,0,0"
              BorderBrush="{StaticResource Border.Soft}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Subtle}" BorderBrush="{StaticResource Border.Soft}"
                  BorderThickness="0,0,0,1" CornerRadius="5,5,0,0" Padding="10,7">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource Meta}" FontWeight="SemiBold" Foreground="{StaticResource Ink.Strong}" Text="アプリ" />
              <TextBlock Grid.Column="1" Style="{StaticResource Meta}" FontWeight="SemiBold" Foreground="{StaticResource Ink.Strong}" Text="PID" />
              <TextBlock Grid.Column="2" Style="{StaticResource Meta}" FontWeight="SemiBold" Foreground="{StaticResource Ink.Strong}" Text="起動した時刻" />
            </Grid>
          </Border>
          <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl x:Name="DetailList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,0,0,1" Padding="10,7">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Foreground="{StaticResource Ink.Strong}" Text="{Binding AppName}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource Meta}" Text="{Binding Id}" />
                      <TextBlock Grid.Column="2" Style="{StaticResource Meta}" Text="{Binding TimeText}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <TextBlock x:Name="HintText" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,10,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
