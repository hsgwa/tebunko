<!-- インデックス管理の画面の枠。tebunko.xaml の ContentHost に入れる（gui_main.ps1）。上にインデックスの一覧、下に詳細（状態・取り込みの進み具合・失敗の一覧）を差す口を並べる。
     一覧と詳細の高さは、間の GridSplitter のドラッグで変わる（詳細は最大 397・最小 240。窓を低くすると詳細が先に縮む）。 -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Grid.Resources>
  <Grid.RowDefinitions>
    <RowDefinition Height="*" MinHeight="225" />
    <RowDefinition Height="Auto" />
    <RowDefinition x:Name="IndexDetailRow" Height="397" MinHeight="240" MaxHeight="397" />
  </Grid.RowDefinitions>

  <ContentControl x:Name="IndexListHost" Grid.Row="0" Focusable="False" IsTabStop="False"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

  <!-- 一覧と詳細の境目。上下にドラッグすると詳細の高さが変わる -->
  <GridSplitter Grid.Row="1" Height="11" Margin="0,3,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeNS"
                ToolTip="上下にドラッグすると、詳細の高さを変えられます">
    <GridSplitter.Template>
      <ControlTemplate TargetType="GridSplitter">
        <!-- 当たり判定は 11px 分とり、見た目は境目の細い線と、つまめることが分かる真ん中のグリップにする -->
        <Border Background="Transparent">
          <Grid>
            <Border Height="1" Background="{StaticResource Border.Soft}" VerticalAlignment="Center" />
            <Border x:Name="Grip" Width="48" Height="5" CornerRadius="3" Background="{StaticResource Border.Strong}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Grip" Property="Background" Value="{StaticResource Ink.Muted}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </GridSplitter.Template>
  </GridSplitter>

  <ContentControl x:Name="IndexDetailHost" Grid.Row="2" Focusable="False" IsTabStop="False"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
</Grid>
