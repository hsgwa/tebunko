<!-- インデックス管理の画面の枠。tebunko.xaml の ContentHost に入れる（gui_main.ps1）。いちばん上に更新の帯、その下にインデックスの一覧、下に詳細（状態・取り込みの進み具合・失敗の一覧）を差す口を並べる。
     一覧と詳細の高さは、間の GridSplitter のドラッグで変わる（詳細は最大 397・最小 240。窓を低くすると詳細が先に縮む）。 -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="-16,-12,-16,-12">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Grid.Resources>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="*" />
  </Grid.RowDefinitions>

  <!-- 画面の上の帯。更新中・中断・終了を 1 行で知らせる（地・線・文字・アイコンの色と形は index_detail.ps1 の setIndexingBanner が状態で変える）。
       右の枠（ContentHost の余白）をはみ出して、右の領域の上端・左右いっぱいに置く（下の Grid.Margin）。
       更新中は、見本にない細い進みの棒と、いま見ているファイルを同じ 1 行に並べる -->
  <Border x:Name="IndexingProgressPanel" Grid.Row="0" Visibility="Collapsed" Style="{StaticResource Banner}"
          Background="{StaticResource Badge.Run.Bg}" BorderBrush="{StaticResource Accent}">
    <DockPanel>
      <!-- 帯の右の組。ボタンの間・見積もり時間とボタンの間は 10（ボタンの左の余白で取る。右の空き 12 は帯の余白） -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
        <TextBlock x:Name="IndexingProgressEta" Style="{StaticResource Meta}" VerticalAlignment="Center" />
        <Button x:Name="IndexingSearchButton" Style="{StaticResource Banner.Button}" Margin="10,0,0,0" Content="検索する" Visibility="Collapsed" />
        <Button x:Name="IndexingResumeButton" Style="{StaticResource Banner.Button}" Margin="10,0,0,0" Content="続きから再開" MinWidth="88" Visibility="Collapsed" />
        <Button x:Name="IndexingStopButton" Style="{StaticResource Banner.Button}" Margin="10,0,0,0" Content="中止" MinWidth="72" />
        <Button x:Name="IndexingBannerClose" Style="{StaticResource Banner.Close}" Margin="10,0,0,0" ToolTip="閉じる"
                AutomationProperties.Name="帯を閉じる" Visibility="Collapsed" />
      </StackPanel>
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Path x:Name="IndexingBannerIcon" Grid.Column="0" Data="{StaticResource Icon.Info}" Width="16" Height="16" Stretch="Uniform"
              Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              Fill="Transparent" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock x:Name="IndexingProgressText" Grid.Column="1" Style="{StaticResource Focal}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Banner.Info.Text}"
                   VerticalAlignment="Center" MaxWidth="560" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <ProgressBar x:Name="IndexingProgress" Grid.Column="2" Width="140" Height="4" Maximum="1" Margin="14,0,0,0" VerticalAlignment="Center" />
        <TextBlock x:Name="IndexingProgressDetail" Grid.Column="3" Style="{StaticResource Micro}" Foreground="{StaticResource Banner.Info.Text}"
                   VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </Grid>
    </DockPanel>
  </Border>

  <!-- 帯の下。ContentHost の余白（16,12,16,12）を帯のために負の余白で打ち消した。一覧は余白を自分で戻し、仕切りと詳細は左右いっぱいに置く -->
  <Grid Grid.Row="1">
  <Grid.RowDefinitions>
    <RowDefinition Height="*" MinHeight="225" />
    <RowDefinition Height="Auto" />
    <RowDefinition x:Name="IndexDetailRow" Height="397" MinHeight="240" MaxHeight="397" />
  </Grid.RowDefinitions>

  <ContentControl x:Name="IndexListHost" Grid.Row="0" Margin="16,8,16,0" Focusable="False" IsTabStop="False"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

  <!-- 一覧と詳細の境目。上下にドラッグすると詳細の高さが変わる -->
  <GridSplitter x:Name="IndexSplitter" Grid.Row="1" Height="11" Margin="0,6,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeNS"
                ToolTip="上下にドラッグすると、詳細の高さを変えられます">
    <GridSplitter.Template>
      <ControlTemplate TargetType="GridSplitter">
        <!-- 当たり判定は 11px 分とり、見た目は境目の細い線と、つまめることが分かる真ん中のグリップにする -->
        <Border Background="Transparent">
          <Grid>
            <Border Height="1" Background="{StaticResource Border.Soft}" VerticalAlignment="Center" />
            <Border x:Name="Grip" Width="32" Height="3" CornerRadius="2" Background="{StaticResource Ink.Muted}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Grip" Property="Background" Value="{StaticResource Ink.Body}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </GridSplitter.Template>
  </GridSplitter>

  <ContentControl x:Name="IndexDetailHost" Grid.Row="2" Focusable="False" IsTabStop="False"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Grid>
</Grid>
