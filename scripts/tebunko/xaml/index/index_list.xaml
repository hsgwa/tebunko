<!-- インデックスの一覧（操作の行・［すべて更新］・［アクション ▾］・フォルダの追加・一覧の表・件数の帯）。index.xaml の IndexListHost に入れる（gui_main.ps1）。
     行の右端のボタンは［更新］［中止］だけ。エクスポート・削除・インポートは［アクション ▾］のメニュー（ActionExport・ActionDelete・ActionImport）。
     行の右クリックのメニュー（編集・エクスポート・削除。名前は EditIndexButton・ExportIndexButton・RemoveIndexButton）も残してある。 -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- ボタンの文字の左に線のアイコンを置く表示（文字は Content。アイコンの色はボタンの文字の色に合わせるので、無効・押し込み・主ボタンでも文字と同じ色になる） -->
      <DataTemplate x:Key="ButtonIcon.Refresh">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource Icon.RefreshCw}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="ButtonIcon.Plus">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource Icon.Plus}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
      </DataTemplate>
      <!-- 選んだ行（詳細欄に出している行）の色 -->
      <Style x:Key="IndexRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{StaticResource Select.Soft}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Grid.Resources>
  <Border>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="90" />
      </Grid.RowDefinitions>

      <!-- 頭は高さ 56 の操作の行（上下 12・ボタン 32）。左に「N / M 件を選択中」、右に ⓘ・［すべて更新］・［アクション ▾］・［＋ フォルダを追加］。
           ⓘ の説明（IndexScreenInfo の ToolTip）は index_view.ps1 の getIndexScreenInfoText が決める -->
      <StackPanel Grid.Row="0">
        <Grid Height="56">
          <TextBlock x:Name="SelectionCountText" Style="{StaticResource Meta}" VerticalAlignment="Center" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Label x:Name="IndexScreenInfo" Padding="0" Margin="0,0,12,0" VerticalAlignment="Center" ToolTipService.ShowDuration="30000"
                   AutomationProperties.Name="この画面の説明">
              <Path Data="{StaticResource Icon.Info}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Ink.Muted}"
                    StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
            </Label>
            <Button x:Name="IndexingButton" Content="すべて更新" ContentTemplate="{StaticResource ButtonIcon.Refresh}" MinWidth="104" Height="32" Margin="0,0,8,0" />
            <!-- ［アクション ▾］: 押すと下にメニューを開く（index_events.ps1）。メニューの項目の可否は updateIndexingButton が決める -->
            <Button x:Name="ActionsButton" Height="32" Margin="0,0,8,0">
              <Button.Content>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="アクション" VerticalAlignment="Center" />
                  <Path Data="{StaticResource Icon.ChevronDown}" Width="10" Height="10" Stretch="Uniform" Stroke="{StaticResource Ink.Muted}"
                        StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
              </Button.Content>
              <Button.ContextMenu>
                <ContextMenu x:Name="ActionsMenu">
                  <MenuItem x:Name="ActionUpdate" Header="更新" />
                  <MenuItem x:Name="ActionEdit" Header="編集…" />
                  <MenuItem x:Name="ActionExport" Header="エクスポート…" />
                  <MenuItem x:Name="ActionImport" Header="インポート…" />
                  <Separator />
                  <MenuItem x:Name="ActionDelete" Header="削除…" Foreground="{StaticResource Danger.Text}" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button x:Name="NewIndexButton" Style="{StaticResource Primary}" Height="32" Content="フォルダを追加" ContentTemplate="{StaticResource ButtonIcon.Plus}" AutomationProperties.Name="＋ フォルダを追加" />
          </StackPanel>
        </Grid>
        <TextBlock x:Name="IndexingHint" Style="{StaticResource Meta}" Margin="0,0,0,0" TextWrapping="Wrap" TextAlignment="Right" />
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,8,0,0">
        <DataGrid x:Name="IndexGrid" RowStyle="{StaticResource IndexRow}" SelectionMode="Single" CanUserSortColumns="False" AllowDrop="True" MinHeight="90">
          <DataGrid.ContextMenu>
            <ContextMenu x:Name="IndexRowMenu">
              <MenuItem x:Name="EditIndexButton" Header="編集…" ToolTip="選んだインデックスの名前と、元のフォルダの場所を変えます（インデックスはそのまま使います）" />
              <MenuItem x:Name="ExportIndexButton" Header="エクスポート…" ToolTip="選んだインデックスを 1 つの zip に書き出します（別の PC・ワークスペースで使えます）" />
              <Separator />
              <MenuItem x:Name="RemoveIndexButton" Header="削除…" ToolTip="選んだインデックスを一覧から消します（元のフォルダとファイルはそのまま残ります）" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="44">
              <!-- 見出しの全選択（一部だけ選んでいるときは横棒）。押したときの動きは index_events.ps1 -->
              <DataGridTemplateColumn.Header>
                <CheckBox x:Name="SelectAllCheckBox" IsThreeState="True" HorizontalAlignment="Center"
                          AutomationProperties.Name="すべて選ぶ" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" HorizontalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- 目で追う列を 1 本に絞るため、インデックス名だけ濃くする -->
            <DataGridTemplateColumn Header="名前" Width="170">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource Icon.Folder}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource File.Folder}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Style="{StaticResource Cell.Key}" Grid.Column="1" Text="{Binding Name}" Tag="TrimTip" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="パス" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Cell.Meta}" Text="{Binding Path}" Tag="TrimTip" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="ファイル数" Width="86">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Cell.Number}" Text="{Binding FileCountText}" ToolTip="{Binding FileCountToolTip}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="最終更新" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Cell.Meta}" Text="{Binding LastIngestedText}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Width="170">
              <!-- 見出しの説明（StatusColumnHeader の ToolTip）は index_view.ps1 の getIndexStatusHelpText が決める -->
              <DataGridTemplateColumn.Header>
                <TextBlock x:Name="StatusColumnHeader" Text="ステータス" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center" ToolTip="{Binding IndexToolTip}">
                    <!-- バッジは状態の名前だけ。数字（更新中の「45%」・要更新の「残り N 件」）は右に小さく添える（無いときは場所を取らない） -->
                    <StackPanel Orientation="Horizontal">
                      <Border Style="{StaticResource LevelBadge}" Tag="{Binding IndexLevel}">
                        <TextBlock Style="{StaticResource LevelBadgeText}" Tag="{Binding IndexLevel}" Text="{Binding IndexText}" />
                      </Border>
                      <TextBlock AutomationProperties.AutomationId="IndexStatusSubText" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="10" FontWeight="Normal"
                                 Foreground="{StaticResource Ink.Muted}" Text="{Binding IndexSub}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IndexSub}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                    <!-- 更新中だけ、下に細い進み具合の棒（幅 120・高さ 4。Percent が負のときは出さない） -->
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding IndexPercent, Mode=OneWay}" Width="120" Height="4" HorizontalAlignment="Left" Margin="0,4,0,0"
                                 Foreground="{StaticResource File.Folder}" Background="{StaticResource Border.Soft}" BorderThickness="0">
                      <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IndexLevel}" Value="Run">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ProgressBar.Style>
                    </ProgressBar>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="高速検索" Width="118">
              <DataGridTemplateColumn.HeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                  <Setter Property="ToolTip" Value="高速検索用のインデックスが、Windows Search にどこまで反映されたかを示します。" />
                </Style>
              </DataGridTemplateColumn.HeaderStyle>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource LevelBadge}" Tag="{Binding FastLevel}" ToolTip="{Binding FastToolTip}">
                    <TextBlock Style="{StaticResource LevelBadgeText}" Tag="{Binding FastLevel}" Text="{Binding FastText}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- 行の操作は［更新］［中止］だけ（状態は RowAction。エラーの行はボタンを出さず、列の幅は変えない）。
                 押したときの動きは一覧（IndexGrid）の Click で受ける（index_events.ps1） -->
            <DataGridTemplateColumn Header="操作" Width="96">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Tag="RowUpdate" Height="26" MinWidth="66" Padding="8,0" IsEnabled="{Binding RowUpdateEnabled}"
                            AutomationProperties.AutomationId="IndexRowUpdateButton" AutomationProperties.Name="更新">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding RowAction}" Value="Update">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                      <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.RefreshCw}" Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Ink.Muted}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                        <TextBlock Text="更新" Margin="5,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Tag="RowStop" Height="26" MinWidth="66" Padding="8,0"
                            AutomationProperties.AutomationId="IndexRowStopButton" AutomationProperties.Name="中止">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding RowAction}" Value="Stop">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                      <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.StopCircle}" Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Ink.Muted}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                        <TextBlock Text="中止" Margin="5,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <!-- 1 件も無いときの案内。表の見出しは出したまま、その下に出す -->
        <StackPanel x:Name="IndexGridPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,24,12,24">
          <Path Style="{StaticResource Illust.Path}" Data="{StaticResource Icon.FolderSearch}" HorizontalAlignment="Center" />
          <TextBlock Style="{StaticResource Label.Strong}" Margin="0,10,0,0" HorizontalAlignment="Center" Text="フォルダを追加してください" />
          <TextBlock Style="{StaticResource Meta}" Margin="0,4,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"
                     Text="検索したいフォルダを追加すると、ここに表示されます。" />
          <!-- 上の［＋ フォルダを追加］と同じ動き（押せるかどうかも上のボタンに合わせる） -->
          <Button x:Name="IndexEmptyAddButton" Style="{StaticResource Primary}" Content="フォルダを追加" ContentTemplate="{StaticResource ButtonIcon.Plus}" AutomationProperties.Name="＋ フォルダを追加" Margin="0,14,0,0" HorizontalAlignment="Center" MinWidth="130" Height="32"
                  IsEnabled="{Binding IsEnabled, ElementName=NewIndexButton}" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Grid>
