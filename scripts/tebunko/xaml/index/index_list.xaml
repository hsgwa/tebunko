<!-- インデックスの一覧（見出しと説明・［すべて更新］・インポート・フォルダの追加・一覧の表・件数の帯）。index.xaml の IndexListHost に入れる（gui_main.ps1）。
     編集・削除・エクスポートは、行の［⋯］から開くメニューの項目（名前は EditIndexButton・RemoveIndexButton・ExportIndexButton のまま）。 -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- 選んだ行（詳細欄に出している行）の色 -->
      <Style x:Key="IndexRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{StaticResource Select.Soft}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Grid.Resources>
  <Border>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="90" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0">
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="IndexingButton" Content="すべて更新" MinWidth="104" Height="34" Margin="0,0,8,0" />
            <Button x:Name="ImportIndexButton" Content="インポート…" Height="34" Margin="0,0,8,0" ToolTip="エクスポートした zip を読み込み、一覧に加えます" />
            <Button x:Name="NewIndexButton" Style="{StaticResource Primary}" Height="34" Content="＋ フォルダを追加" ToolTip="Office ファイルのあるフォルダを指定して、新しいインデックスを追加します" />
          </StackPanel>
          <TextBlock x:Name="IndexingHint" Style="{StaticResource Meta}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Right" />
        </StackPanel>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource PageTitle}" Text="インデックス管理" />
            <Path Data="{StaticResource Icon.Info}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Ink.Muted}"
                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  VerticalAlignment="Center" Margin="6,2,0,0" Fill="Transparent"
                       ToolTip="チェックを付けたインデックスだけを更新します。一覧にフォルダをドラッグ＆ドロップしても追加できます" />
          </StackPanel>
          <TextBlock Style="{StaticResource Meta}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="検索するフォルダとインデックスを管理します。ファイルを変更したら［すべて更新］でインデックスを最新にします。" />
        </StackPanel>
      </DockPanel>

      <Grid Grid.Row="1" Margin="0,12,0,0">
        <DataGrid x:Name="IndexGrid" RowStyle="{StaticResource IndexRow}" SelectionMode="Single" CanUserSortColumns="False" AllowDrop="True" MinHeight="90">
          <DataGrid.ContextMenu>
            <ContextMenu x:Name="IndexRowMenu">
              <MenuItem x:Name="EditIndexButton" Header="編集…" ToolTip="選んだインデックスの名前と、元のフォルダの場所を変えます（インデックスはそのまま使います）" />
              <MenuItem x:Name="ExportIndexButton" Header="エクスポート…" ToolTip="選んだインデックスを 1 つの zip に書き出します（別の PC・ワークスペースで使えます）" />
              <Separator />
              <MenuItem x:Name="RemoveIndexButton" Header="削除" ToolTip="選んだインデックスを一覧から消します（元のフォルダとファイルはそのまま残ります）" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="44">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" HorizontalAlignment="Center"
                            ToolTip="チェックを付けたインデックスだけを更新します（外してもインデックスは残ります）" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- 目で追う列を 1 本に絞るため、インデックス名だけ濃くする -->
            <DataGridTemplateColumn Header="インデックス名" Width="170">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource Icon.Folder}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource File.Folder}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Style="{StaticResource Cell.Key}" Text="{Binding Name}" ToolTip="{Binding Name}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="パス" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Cell.Meta}" Text="{Binding Path}" ToolTip="{Binding Path}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="ファイル数" Width="86">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Cell.Number}" Text="{Binding FileCountText}" ToolTip="{Binding FileCountToolTip}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="最終更新" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Cell.Meta}" Text="{Binding LastIngestedText}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="ステータス" Width="120">
              <DataGridTemplateColumn.HeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                  <Setter Property="ToolTip" Value="検索に使うインデックスの状態（最新・要更新・更新中・エラー・未作成）" />
                </Style>
              </DataGridTemplateColumn.HeaderStyle>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center" ToolTip="{Binding IndexToolTip}">
                    <Border Style="{StaticResource LevelBadge}" Tag="{Binding IndexLevel}">
                      <TextBlock Style="{StaticResource LevelBadgeText}" Tag="{Binding IndexLevel}" Text="{Binding IndexText}" />
                    </Border>
                    <!-- 更新中の細い進み具合の棒（Percent が負のときは出さない） -->
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding IndexPercent, Mode=OneWay}" Height="3" Margin="2,4,2,0"
                                 Foreground="{StaticResource File.Folder}" Background="{StaticResource Border.Soft}" BorderThickness="0">
                      <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IndexLevel}" Value="Run">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ProgressBar.Style>
                    </ProgressBar>
                    <!-- 途中で止まったときの「残り N 件」。無いときは場所を取らない -->
                    <TextBlock Margin="2,2,0,0" FontSize="11" Foreground="{StaticResource Warn}" Text="{Binding IndexSub}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IndexSub}" Value="">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="高速検索" Width="118">
              <DataGridTemplateColumn.HeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                  <Setter Property="ToolTip" Value="インデックス（高速検索用）が Windows Search にどこまで反映されたか" />
                </Style>
              </DataGridTemplateColumn.HeaderStyle>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource LevelBadge}" Tag="{Binding FastLevel}" ToolTip="{Binding FastToolTip}">
                    <TextBlock Style="{StaticResource LevelBadgeText}" Tag="{Binding FastLevel}" Text="{Binding FastText}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- 行の操作（編集・削除・エクスポート）は、行の［⋯］から開くメニュー（IndexRowMenu）に入れる。
                 ［⋯］は行ごとの部品なので、押したときの動きは一覧（IndexGrid）の Click で受ける（index_events.ps1） -->
            <DataGridTemplateColumn Header="操作" Width="56">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Tag="IndexRowMenu" Cursor="Hand" Background="Transparent" BorderThickness="0"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,2"
                          AutomationProperties.AutomationId="IndexRowMenuButton" AutomationProperties.Name="操作"
                          ToolTip="このインデックスの操作（編集・削除・エクスポート）">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent">
                          <Path Data="{StaticResource Icon.Ellipsis}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Ink.Muted}"
                                StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Background" Value="{StaticResource Bg.Hover}" />
                          </Trigger>
                          <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Background" Value="{StaticResource Accent.Ring}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <!-- 1 件も無いときの案内。表の見出しは出したまま、その下に出す -->
        <StackPanel x:Name="IndexGridPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,24,12,24">
          <Path Style="{StaticResource Illust.Path}" Data="{StaticResource Icon.FolderSearch}" HorizontalAlignment="Center" />
          <TextBlock Style="{StaticResource Label.Strong}" Margin="0,10,0,0" HorizontalAlignment="Center" Text="フォルダを追加してください" />
          <TextBlock Style="{StaticResource Meta}" Margin="0,4,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"
                     Text="検索したいフォルダを追加すると、ここに表示されます。" />
          <!-- 上の［＋ フォルダを追加］と同じ動き（押せるかどうかも上のボタンに合わせる） -->
          <Button x:Name="IndexEmptyAddButton" Style="{StaticResource Primary}" Content="＋ フォルダを追加" Margin="0,14,0,0" HorizontalAlignment="Center" MinWidth="130" Height="32"
                  IsEnabled="{Binding IsEnabled, ElementName=NewIndexButton}" />
        </StackPanel>
      </Grid>

      <!-- 登録の件数の帯（フォルダ数と、取り込み一覧にあるファイルの合計） -->
      <DockPanel Grid.Row="2" Margin="0,8,0,0">
        <TextBlock x:Name="IndexFooterFiles" DockPanel.Dock="Right" Style="{StaticResource Meta}" Text="合計: 0 ファイル" />
        <TextBlock x:Name="IndexFooterFolders" Style="{StaticResource Meta}" Text="登録済み: 0 フォルダ" />
      </DockPanel>
    </Grid>
  </Border>
</Grid>
