<!-- インデックスの詳細（選んだインデックスの基本設定・インデックスの情報・高速検索の状態、更新の進み具合、失敗の一覧）。
     index.xaml の IndexDetailHost に入れる（gui_main.ps1）。中身は縦にスクロールできる。
     更新中の表示（IndexingProgressPanel）は、いちばん上の帯。失敗の一覧（FailedPanel）は、いちばん下に置く。
     左右の部品のうち IndexDetail の名前の多くは gui_main.ps1 の名前の一覧に無く、index_detail.ps1 が読み込んだ中身から取る。 -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- 左右の項目の名前 -->
      <Style x:Key="FieldName" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>
      <!-- 値を入れる枠（読むだけ） -->
      <Style x:Key="FieldBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg.Subtle}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Soft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,5" />
      </Style>
      <!-- 状態を入れる囲み -->
      <Style x:Key="InfoCard" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Border.Soft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,10" />
      </Style>
    </ResourceDictionary>
  </Grid.Resources>
  <Border Style="{StaticResource Card}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <!-- インデックスの更新中の帯。件数がこの画面の主役 -->
        <Border x:Name="IndexingBanner" Background="{StaticResource Accent.Soft}" BorderBrush="{StaticResource Accent.Ring}"
                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12"
                Visibility="{Binding Visibility, ElementName=IndexingProgressPanel}">
          <StackPanel x:Name="IndexingProgressPanel" Visibility="Collapsed">
            <DockPanel>
              <Button x:Name="IndexingStopButton" DockPanel.Dock="Right" Content="中止" MinWidth="72" Margin="12,0,0,0" />
              <Button x:Name="IndexingLogButton" DockPanel.Dock="Right" Style="{StaticResource Link}" Content="ログを開く"
                      VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed" />
              <TextBlock x:Name="IndexingProgressEta" DockPanel.Dock="Right" Style="{StaticResource Meta}" VerticalAlignment="Center" />
              <TextBlock x:Name="IndexingProgressText" Style="{StaticResource Focal}" VerticalAlignment="Center" />
            </DockPanel>
            <ProgressBar x:Name="IndexingProgress" Margin="0,9,0,0" Maximum="1" />
            <TextBlock x:Name="IndexingProgressDetail" Style="{StaticResource Micro}" Margin="0,7,0,0"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          </StackPanel>
        </Border>

        <TextBlock x:Name="IndexDetailTitle" Style="{StaticResource Label.Strong}" Text="インデックスの状態" />

        <!-- 1 つ選んだときの左右 2 列（基本設定・インデックス情報）。何も選んでいないときは出さない -->
        <Grid x:Name="IndexDetailBody" Margin="0,10,0,0" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource Label.Strong}" Text="基本設定" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource FieldName}" Text="インデックス名" />
            <Border Style="{StaticResource FieldBox}">
              <TextBlock x:Name="IndexDetailName" Foreground="{StaticResource Ink.Value}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </Border>
            <TextBlock Style="{StaticResource FieldName}" Text="フォルダパス" Margin="0,10,0,4" />
            <Border Style="{StaticResource FieldBox}">
              <TextBlock x:Name="IndexDetailPath" Foreground="{StaticResource Ink.Value}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Border>
            <TextBlock x:Name="IndexDetailFolderStatus" Style="{StaticResource Meta}" Margin="0,4,0,0" />
            <Border Style="{StaticResource InfoCard}" Margin="0,10,0,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Label}" Text="インデックス" VerticalAlignment="Center" />
                  <Border x:Name="IndexDetailBadge" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="IndexDetailBadgeText" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock x:Name="IndexDetailBadgeSub" Style="{StaticResource Meta}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="IndexDetailUpdated" Style="{StaticResource Meta}" Margin="0,6,0,0" />
                <TextBlock x:Name="IndexDetailCount" Foreground="{StaticResource Ink.Value}" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource Label.Strong}" Text="インデックス情報" Margin="0,0,0,8" />
            <!-- 項目と値の表。値は 1 行で、あふれたら「…」 -->
            <ItemsControl x:Name="IndexDetailRows">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource Border.Row}" BorderThickness="0,0,0,1" Padding="0,5">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" Foreground="{StaticResource Ink.Value}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                 Text="{Binding Value}" ToolTip="{Binding Value}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource InfoCard}" Margin="0,10,0,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Label}" Text="高速検索" VerticalAlignment="Center" />
                  <Border x:Name="IndexDetailFastBadge" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="IndexDetailFastBadgeText" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                </StackPanel>
                <TextBlock x:Name="IndexDetailFastReason" Style="{StaticResource WarnText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <StackPanel x:Name="IndexDetailFastPanel" Margin="0,6,0,0" Visibility="Collapsed">
                  <TextBlock x:Name="IndexDetailFastText" Style="{StaticResource Meta}" />
                  <ProgressBar x:Name="IndexDetailFastBar" Margin="0,4,0,0" Maximum="1" Height="6" />
                </StackPanel>
                <TextBlock x:Name="IndexDetailFastChecked" Style="{StaticResource Meta}" Margin="0,6,0,0" />
                <TextBlock x:Name="IndexDetailFastNote" Style="{StaticResource Micro}" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource Meta}" Margin="0,14,0,0" Text="すべてのインデックスの合計" />
        <TextBlock x:Name="IndexSummaryText" Text="確認中…" Margin="0,4,0,0" />
        <TextBlock x:Name="IndexingStateText" Style="{StaticResource WarnText}" Margin="0,6,0,0" />

        <StackPanel x:Name="FailedPanel" Visibility="Collapsed" Margin="0,8,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Micro}" VerticalAlignment="Bottom"
                       Text="ダブルクリックでファイルの場所を開きます" />
            <TextBlock x:Name="FailedHeading" Style="{StaticResource ErrorText}" />
          </DockPanel>
          <DataGrid x:Name="FailedGrid" MaxHeight="130" Margin="0,6,0,0" SelectionMode="Single" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="ファイル" Width="280">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Cell.Key}" Text="{Binding RelPath}" ToolTip="{Binding RelPath}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="失敗の原因" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Cell}" TextTrimming="None" TextWrapping="Wrap"
                               Text="{Binding Reason}" ToolTip="{Binding Reason}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="日時" Binding="{Binding IngestedText}" Width="80"
                                  ElementStyle="{StaticResource Cell.Meta}" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Grid>
