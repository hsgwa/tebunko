<!-- インデックスの詳細（選んだインデックスの基本設定・インデックスの情報、更新の進み具合、失敗の一覧）。
     index.xaml の IndexDetailHost に入れる（gui_main.ps1）。中身は縦にスクロールできる。
     更新中の帯は画面の上（index.xaml）にある。取り込んだファイルの一覧は、別のダイアログ（dialog_index_files.xaml）で開く。
     左右の部品のうち IndexDetail の名前の多くは shell\regions.ps1 の名前の一覧に無く、index_detail.ps1 が読み込んだ中身から取る。 -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- 左右の項目の名前 -->
      <Style x:Key="FieldName" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>
      <!-- 値を入れる枠（読むだけ） -->
      <Style x:Key="FieldBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg.Subtle}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Soft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,5" />
      </Style>
      <!-- 状態を入れる囲み -->
      <Style x:Key="InfoCard" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Border.Soft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{StaticResource Bg.Summary}" />
      </Style>
    </ResourceDictionary>
  </Grid.Resources>
  <!-- 平らな面。上に細い線、見出しの帯（薄い地）、その下に左右 2 列（間は線 1 本） -->
  <Border BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,1,0,0">
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Window}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,0,0,1" Padding="16,8">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource Icon.Info}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Ink.Muted}"
                StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock x:Name="IndexDetailTitle" Style="{StaticResource Label.Strong}" VerticalAlignment="Center" Text="インデックスの状態" />
        </StackPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,10,16,10">

          <!-- 2 件以上を選んだとき（見出しは「N 件を選択中」）と、何も選んでいないときの案内 -->
          <TextBlock x:Name="MultiSelectHintText" Style="{StaticResource Meta}" Visibility="Collapsed" />

          <!-- 1 つ選んだときの左右 2 列（左は基本設定・インデックスの状態、右はインデックス情報の表）。何も選んでいないときは出さない -->
          <Grid x:Name="IndexDetailBody" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="1" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1" Background="{StaticResource Border.Soft}" />

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Style="{StaticResource Label.Strong}" Text="基本設定" Margin="0,0,0,8" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="98" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="名前" VerticalAlignment="Center" />
                <!-- 名前はその場で直す。Enter か欄から出たときに確定、Esc で取り消す（index_events.ps1・commitIndexDetailEdit） -->
                <TextBox x:Name="IndexDetailName" Grid.Column="1" AutomationProperties.AutomationId="IndexDetailName" AutomationProperties.Name="インデックスの名前" />
              </Grid>
              <Grid Margin="0,10,0,0" UseLayoutRounding="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="98" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="フォルダパス" VerticalAlignment="Center" />
                <TextBox x:Name="IndexDetailPath" Grid.Column="1" AutomationProperties.AutomationId="IndexDetailPath" AutomationProperties.Name="元のフォルダのパス" />
                <!-- フォルダの場所をその場で変える［変更…］（設定画面のワークスペースの［変更…］と同じ形）。欄の右に置く。押すとフォルダを選ぶ画面を出し、選んだ場所を欄に入れて、欄に入力したときと同じ道（changeIndexFolder → commitIndexDetailEdit）で変える -->
                <Button x:Name="IndexDetailPathButton" Grid.Column="2" Content="変更…" MinWidth="64" Margin="8,0,0,0"
                        AutomationProperties.AutomationId="IndexDetailPathButton" AutomationProperties.Name="フォルダの場所を変える"
                        ToolTip="元のフォルダの場所を変えます（インデックスはそのまま使います）" />
              </Grid>
              <!-- 名前・フォルダパスを確定できなかったときの理由（commitIndexDetailEdit） -->
              <TextBlock x:Name="IndexDetailEditError" Style="{StaticResource ErrorText}" Margin="98,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
              <!-- 文字と左のアイコンの色は updateIndexDetailPanel が getIndexDetailView の FolderBrush で当て、アイコンの形は FolderIcon（Icon.Check・Icon.Close）で替える -->
              <StackPanel Orientation="Horizontal" Margin="98,4,0,0">
                <Path x:Name="IndexDetailFolderIcon" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" Stretch="Uniform"
                      Visibility="Collapsed" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <TextBlock x:Name="IndexDetailFolderStatus" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
              <!-- 取り込むときにサブフォルダを含めるか（設定の subfolders）。付け外しはその場で設定に書く（changeIndexSubfolders）。説明の行は出さない -->
              <CheckBox x:Name="IndexDetailSubfolders" Content="サブフォルダを含める" Margin="98,10,0,0" AutomationProperties.AutomationId="IndexDetailSubfolders"
                        ToolTip="外すと、このフォルダの直下のファイルだけを取り込みます（次の更新で反映します）" />
              <!-- 取り込む拡張子（インデックスごと。設定の indexExtensionExcludes）。要約と［変更…］・［要更新］の札、下に件数の見出し（前回の控えの日時つき）。
                   ［変更…］で拡張子を選ぶダイアログを開き、［OK］でその場で設定に書く（changeIndexTextExtensions）。更新中は押せない -->
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="98" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,5,0,0"><Run Text="取り込み対象の" /><LineBreak /><Run Text="拡張子" /></TextBlock>
                <StackPanel Grid.Column="1">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="IndexDetailTextExtSummary" VerticalAlignment="Center" AutomationProperties.AutomationId="IndexDetailTextExtSummary" />
                    <Button x:Name="ChangeIndexTextExtensionsButton" Content="変更…" MinWidth="64" Margin="12,0,0,0"
                            AutomationProperties.AutomationId="ChangeIndexTextExtensionsButton" AutomationProperties.Name="取り込み対象の拡張子を変える" />
                    <Border x:Name="IndexDetailTextExtStaleBadge" Style="{StaticResource StatusBadge}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                            AutomationProperties.AutomationId="IndexDetailTextExtStaleBadge">
                      <TextBlock x:Name="IndexDetailTextExtStaleBadgeText" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                  </StackPanel>
                  <TextBlock x:Name="IndexDetailTextExtCaption" Style="{StaticResource Meta}" FontSize="11" Margin="0,2,0,0" AutomationProperties.AutomationId="IndexDetailTextExtCaption" />
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource InfoCard}" Margin="0,10,0,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Label.Strong}" Text="インデックス" VerticalAlignment="Center" />
                    <Border x:Name="IndexDetailBadge" Style="{StaticResource StatusBadge}" Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="IndexDetailBadgeText" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock x:Name="IndexDetailBadgeSub" Style="{StaticResource Meta}" Margin="8,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <!-- 元のフォルダが見つからないときの理由と直し方（バッジは「エラー」） -->
                  <TextBlock x:Name="IndexErrorText" Style="{StaticResource ErrorText}" Margin="0,8,0,0" Visibility="Collapsed" />
                  <TextBlock x:Name="IndexErrorHintText" Style="{StaticResource Meta}" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                  <!-- 更新中の行を選んでいるときの進み具合（全体の進みを出す。インデックスごとの件数は無い） -->
                  <StackPanel x:Name="IndexingDetailPanel" Margin="0,8,0,0" Visibility="Collapsed">
                    <ProgressBar x:Name="IndexingProgressBar" Maximum="1" Height="6" />
                    <TextBlock x:Name="IndexingCountText" Style="{StaticResource Meta}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock x:Name="IndexingFileText" Style="{StaticResource Micro}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  </StackPanel>
                  <TextBlock x:Name="IndexDetailUpdated" Style="{StaticResource Meta}" Margin="0,6,0,0" />
                  <TextBlock x:Name="IndexDetailCount" Style="{StaticResource Meta}" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="16,0,0,0">
              <DockPanel Margin="0,0,0,8">
                <!-- 取り込んだファイルの一覧をダイアログで開く（index_detail.ps1・openIndexFilesDialog）。見出しの右端に置く -->
                <Button x:Name="IndexFilesButton" DockPanel.Dock="Right" Style="{StaticResource Button.Small}" Content="ファイルの一覧"
                        AutomationProperties.AutomationId="IndexFilesButton" AutomationProperties.Name="取り込んだファイルの一覧を開く"
                        ToolTip="このインデックスに取り込んだファイルを一覧で見ます" />
                <TextBlock Style="{StaticResource Label.Strong}" Text="インデックス情報" VerticalAlignment="Center" />
              </DockPanel>
              <!-- 項目と値の表（見出しの行つき）。値は右に寄せ、1 行で、あふれたら「…」 -->
              <Border BorderBrush="{StaticResource Border.Normal}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <StackPanel>
                  <Border Background="{StaticResource Bg.Window}" Padding="10,5">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label.Strong}" Text="値" />
                      <TextBlock Style="{StaticResource Label.Strong}" Text="項目" />
                    </DockPanel>
                  </Border>
                  <ItemsControl x:Name="IndexDetailRows">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource Border.Row}" BorderThickness="0,1,0,0" Padding="10,5">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="{Binding Label}" Width="130" />
                            <TextBlock Foreground="{StaticResource Ink.Value}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" TextAlignment="Right"
                                       Text="{Binding Value}" ToolTip="{Binding Value}" />
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Grid>
