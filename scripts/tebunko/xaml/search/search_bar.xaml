<!-- 検索バー（検索ワード・検索ボタン・種類のチップ・探す範囲・検索条件・高速検索の状態）。search.xaml の SearchBarHost に入れる（gui_main.ps1）。 -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- 種類のチップ。押すたびに入り切りする（最後の 1 つは外せない。判断は ui/search/search_bar_view.ps1） -->
      <Style x:Key="KindChip" TargetType="ToggleButton">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Box" Style="{StaticResource Chip.Box}" Padding="10,5"
                      Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Input}">
                <StackPanel Orientation="Horizontal">
                  <Path x:Name="Mark" Data="{StaticResource Icon.Check}" Width="12" Height="12" Stretch="Uniform"
                        Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,5,0" Visibility="Collapsed" />
                  <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="12"
                             Foreground="{StaticResource Ink.Muted}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Box" Property="Background" Value="{StaticResource Select.Soft}" />
                  <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                  <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                  <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Accent.Hover}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </StackPanel.Resources>

  <Border Style="{StaticResource Card}" Padding="16,14">
    <StackPanel>
      <DockPanel>
        <TextBlock Style="{StaticResource Heading}" Text="検索ワード" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button x:Name="SearchButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="検索" MinWidth="110" Height="34" Margin="10,0,0,0" />
        <TextBox x:Name="WordBox" Height="34" />
      </DockPanel>

      <!-- 種類のチップ・探す範囲・検索条件 -->
      <DockPanel Margin="0,12,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox x:Name="CaseCheck" Content="大文字と小文字を区別" VerticalAlignment="Center" Margin="0,0,16,0"
                    ToolTip="オンにすると、英字の大文字と小文字を区別します（例: ID は id・Id に一致しない）" />
          <CheckBox x:Name="RegexCheck" Content="正規表現を使う" VerticalAlignment="Center" Margin="0,0,16,0" />
          <TextBlock x:Name="FastSearchText" Style="{StaticResource Micro}" VerticalAlignment="Center"
                     ToolTip="Windows Search で、検索語を含みうるフォルダを先に絞ります。正規表現・1 文字のワード・Windows Search が使えないときは、すべてを検索します" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="種類" Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <StackPanel x:Name="FileKindChips" Orientation="Horizontal">
            <ToggleButton x:Name="KindChipExcel" Style="{StaticResource KindChip}" Tag="excel" Content="Excel"
                          ToolTip="Excel のファイルを検索します" />
            <ToggleButton x:Name="KindChipWord" Style="{StaticResource KindChip}" Tag="word" Content="Word"
                          ToolTip="Word のファイルを検索します" />
            <ToggleButton x:Name="KindChipPowerPoint" Style="{StaticResource KindChip}" Tag="powerpoint" Content="PowerPoint"
                          ToolTip="PowerPoint のファイルを検索します" />
            <ToggleButton x:Name="KindChipText" Style="{StaticResource KindChip}" Tag="text" Content="テキスト"
                          ToolTip="テキストファイルを検索します" />
          </StackPanel>
          <Button x:Name="ScopeButton" Content="探す範囲 ▾" MinWidth="0" Height="28" Padding="10,0" Margin="6,0,0,0"
                  ToolTip="ファイルの中で検索する範囲を選びます">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="ShapeCheck" Header="図形も検索" IsCheckable="True" StaysOpenOnClick="True"
                          ToolTip="オンにすると、図形・テキストボックス・SmartArt・グラフの文字も検索します（種別が「図形」の結果。PowerPoint のテキストボックスはスライドの本文）" />
                <MenuItem x:Name="CommentCheck" Header="コメントも検索" IsCheckable="True" StaysOpenOnClick="True"
                          ToolTip="オンにすると、Excel・Word・PowerPoint のコメント（返信を含む）も検索します（種別が「コメント」の結果）" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </Border>

  <StackPanel Margin="2,8,0,0">
    <TextBlock x:Name="WordNotice" Style="{StaticResource WarnText}" Visibility="Collapsed" />
    <TextBlock x:Name="SearchTargetText" Style="{StaticResource Micro}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
  </StackPanel>
</StackPanel>
