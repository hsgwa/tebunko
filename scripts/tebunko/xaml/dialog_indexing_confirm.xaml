<!-- インデックス更新の確認ダイアログ（［すべて更新］を押した後、更新の対象を数え終えたときに開く）。gui.ps1 が読み込む。
     色・文字・コントロールの形は scripts/shared/xaml/theme.xaml にまとめてある。 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="インデックス更新の確認" Width="720" Height="640" MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        FontFamily="{DynamicResource Font.Body}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource Bg.Surface}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="18,16,18,16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" Content="キャンセル" IsCancel="True" Height="34" Margin="0,0,8,0" />
      <Button x:Name="StartButton" Style="{StaticResource Primary}" Content="更新を開始" IsDefault="True" MinWidth="110" Height="34" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <CheckBox x:Name="RetryCheck" Visibility="Collapsed" Margin="0,0,0,10" />
      <!-- クラウドにだけあるファイル（OneDrive・SharePoint のオンデマンド）が 1 件でもあるときだけ出す -->
      <TextBlock x:Name="CloudWarnText" Foreground="{StaticResource Warn.Strong}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6" />
      <CheckBox x:Name="CloudCheck" Visibility="Collapsed" Margin="0,0,0,4" />
      <CheckBox x:Name="CloudRememberCheck" Visibility="Collapsed" Margin="20,0,0,10" />
      <!-- 注意の枠（取り込むものが無いときの案内）。文字は NoteText に入れ、枠は NoteText の表示に合わせて出す -->
      <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="6" Background="{StaticResource Warn.Note}"
              BorderBrush="{StaticResource Warn.Line}" BorderThickness="1"
              Visibility="{Binding Visibility, ElementName=NoteText}">
        <TextBlock x:Name="NoteText" Foreground="{StaticResource Warn.Strong}" TextWrapping="Wrap" Visibility="Collapsed" />
      </Border>
    </StackPanel>

    <!-- インデックスの保存先のカード（getIndexLocationView）。見出し・パス・［フォルダを開く］を 1 組にし、その下に注意書き・警告の帯（共有のときだけ）・
         ［フォルダを開く］の結果（開けなかったときだけ。モーダルの間は本体のステータスバーが見えにくいため、ここに出す）を並べる -->
    <Border x:Name="IndexLocationCard" DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="15,11" CornerRadius="6"
            Background="{StaticResource Bg.Subtle}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1">
      <StackPanel>
        <DockPanel>
          <Button x:Name="OpenIndexLocationButton" DockPanel.Dock="Right" Content="フォルダを開く" Height="28" Margin="12,0,0,0" VerticalAlignment="Center" />
          <StackPanel>
            <TextBlock x:Name="IndexLocationLabel" Style="{StaticResource Meta}" FontSize="11" Text="インデックスの保存先" />
            <TextBlock x:Name="IndexLocationText" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Ink.Value}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
        <TextBlock x:Name="IndexLocationNote" FontSize="12" Foreground="{StaticResource Ink.Body}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <Border Style="{StaticResource Banner}" MinHeight="33" Padding="12,8,12,8" Margin="0,8,0,0" Background="{StaticResource Warn.Soft}" BorderBrush="{StaticResource Warn}"
                Visibility="{Binding Visibility, ElementName=IndexLocationWarning}">
          <DockPanel>
            <Path DockPanel.Dock="Left" Data="{StaticResource Icon.TriangleAlert}" Width="14" Height="14" Stretch="Uniform" Stroke="{StaticResource Warn}"
                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" VerticalAlignment="Top" Margin="0,1,8,0" />
            <TextBlock x:Name="IndexLocationWarning" FontSize="12" Foreground="{StaticResource Banner.Warn.Text}" TextWrapping="Wrap" Visibility="Collapsed" />
          </DockPanel>
        </Border>
        <TextBlock x:Name="IndexLocationStatus" FontSize="12" Foreground="{StaticResource Danger.Text}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <!-- 見出し。左のアイコンは、確認のメッセージ（dialog_confirm.xaml）と同じ「?」 -->
      <DockPanel>
        <Path DockPanel.Dock="Left" Data="{StaticResource Icon.CircleQuestionMark}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"
              VerticalAlignment="Center" Stroke="{StaticResource Accent}" StrokeThickness="1.8"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        <TextBlock Style="{StaticResource DialogHeading}" Text="インデックス更新の確認" VerticalAlignment="Center" />
      </DockPanel>
      <!-- 削除予定のインデックスがあるときだけ出す一文（getIndexingConfirmIntro） -->
      <TextBlock x:Name="IntroText" Style="{StaticResource Meta}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
      <!-- 初めて（どのインデックスも拡張子を外していない）とき、表の［変更…］で拡張子を選べることを案内する一文（getIndexingTextExtGuide） -->
      <TextBlock x:Name="TextExtGuideText" Style="{StaticResource Meta}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>

    <!-- 表と、いちばん下の合計の行（更新するフォルダ数・ファイル数。薄い地）を 1 つの枠に入れる -->
    <Border BorderBrush="{StaticResource Border.Soft}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
      <DockPanel>
      <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg.Summary}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,1,0,0" Padding="12,8">
        <StackPanel>
          <TextBlock x:Name="TotalText" Style="{StaticResource Label.Strong}" TextWrapping="Wrap" />
          <!-- 直下だけに変えたフォルダで、サブフォルダ側を外す件数（getIndexingSubfolderRemovalNote。0 件のときは隠す） -->
          <TextBlock x:Name="SubfolderRemovalNote" Style="{StaticResource Meta}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
          <!-- 取り込まない拡張子にしたファイルを外す件数（getIndexingTextExcludeRemovalNote。0 件のときは隠す。SubfolderRemovalNote とは独立に出し入れする） -->
          <TextBlock x:Name="TextExcludeRemovalNote" Style="{StaticResource Meta}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
      </Border>
      <DataGrid x:Name="PlanGrid" MinHeight="120" BorderThickness="0" CanUserAddRows="False" SelectionMode="Single" CanUserSortColumns="False">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="フォルダ名" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                  <TextBlock Style="{StaticResource Cell.Key}" Text="{Binding Name}" />
                  <!-- 設定が「サブフォルダを含めない」の行だけに出す札（読み取りだけ。選ぶのは［インデックス管理］の詳細）。TopOnlyText が空なら隠す -->
                  <Border Background="{StaticResource Bg.Tag}" CornerRadius="3" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TopOnlyText}" FontSize="10" FontWeight="Medium" Foreground="{StaticResource Ink.Muted}" />
                    <Border.Style>
                      <Style TargetType="Border">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding TopOnlyText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="対象ファイル数" Width="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource Cell.Number}" HorizontalAlignment="Stretch" Text="{Binding TotalText}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- 取り込む拡張子の要約と［変更…］（この回で取り込む行だけ。TextExtShown が false なら隠す）。［変更…］は ChangeIndexTextExtensionsButton（Tag にインデックス名） -->
          <DataGridTemplateColumn Header="取り込み対象の拡張子" Width="250" MinWidth="230">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <WrapPanel Orientation="Horizontal">
                  <TextBlock x:Name="IndexTextExtSummary" Style="{StaticResource Cell.Key}" Text="{Binding TextExtSummary}" ToolTip="{Binding TextExtTip}" VerticalAlignment="Center" />
                  <Button x:Name="ChangeIndexTextExtensionsButton" Content="変更…" Tag="{Binding Name}" Height="22" Padding="8,0" Margin="8,0,0,0" VerticalAlignment="Center" />
                  <WrapPanel.Style>
                    <Style TargetType="WrapPanel">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding TextExtShown}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </WrapPanel.Style>
                </WrapPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="ステータス" Width="130">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource LevelBadge}" Tag="{Binding Level}" ToolTip="{Binding DetailText}">
                  <TextBlock Style="{StaticResource LevelBadgeText}" Tag="{Binding Level}" Text="{Binding StatusText}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
