<!-- インデックスのエクスポートのダイアログ（［インデックス管理］タブの行のメニューの［エクスポート…］）。index_archive.ps1 が読み込む。
     色・文字・コントロールの形は scripts/shared/xaml/theme.xaml にまとめてある。 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="インデックスのエクスポート" Width="620" Height="400" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        FontFamily="{DynamicResource Font.Body}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource Bg.Surface}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="18,16,18,16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" Content="キャンセル" IsCancel="True" MinWidth="104" Height="32" Margin="0,0,8,0" />
      <Button x:Name="ExportButton" Style="{StaticResource Primary}" Content="エクスポート" IsDefault="True" MinWidth="104" Height="32" />
    </StackPanel>

    <!-- 取り扱いの注意（ボタンの上。橙の枠） -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Warn.Soft}" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
      <TextBlock x:Name="CautionText" Foreground="{StaticResource Banner.Warn.Text}" TextWrapping="Wrap" />
    </Border>

    <StackPanel>
      <!-- 見出しの代わりに、書き出す対象を枠で示す（名前・ファイル数） -->
      <Border Background="{StaticResource Bg.Summary}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1" CornerRadius="6" Padding="12,10">
        <StackPanel>
          <TextBlock x:Name="ExportTitleText" Style="{StaticResource Label.Strong}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="ExportSizeText" Style="{StaticResource Meta}" Margin="0,2,0,0" />
        </StackPanel>
      </Border>
      <TextBlock x:Name="IntroText" Style="{StaticResource Meta}" Margin="0,8,0,6" TextWrapping="Wrap" />

      <TextBlock Style="{StaticResource Label}" HorizontalAlignment="Left" Margin="0,12,0,6" Text="書き出し先のフォルダ" />
      <DockPanel>
        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="参照…" MinWidth="80" Margin="8,0,0,0" />
        <TextBox x:Name="ExportPathBox" AllowDrop="True" />
      </DockPanel>
      <TextBlock x:Name="ExportFileText" Style="{StaticResource Meta}" Margin="2,6,0,0" TextWrapping="Wrap" />
      <TextBlock Style="{StaticResource Micro}" Margin="2,4,0,0"
                 Text="パスの入力・貼り付け・フォルダのドラッグ＆ドロップで指定できます。zip の名前は自動で付きます。" />

      <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,10,0,0" Visibility="Collapsed" />
    </StackPanel>
  </DockPanel>
</Window>
