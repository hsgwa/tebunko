<!-- インデックスのエクスポートのダイアログ（［1 インデックス管理］タブの行のメニューの［エクスポート…］）。index_archive.ps1 が読み込む。
     色・文字・コントロールの形は scripts/shared/xaml/theme.xaml にまとめてある。 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="インデックスのエクスポート" Width="620" Height="280" MinWidth="520" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        FontFamily="{DynamicResource Font.Body}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Background="White" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="18,16,18,16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="ExportButton" Style="{StaticResource Primary}" Content="エクスポート" IsDefault="True" MinWidth="104" Height="32" />
      <Button x:Name="CancelButton" Content="キャンセル" IsCancel="True" MinWidth="104" Height="32" Margin="8,0,0,0" />
    </StackPanel>

    <StackPanel>
      <TextBlock Style="{StaticResource DialogHeading}" Text="インデックスをエクスポートする" />
      <TextBlock x:Name="IntroText" Style="{StaticResource Meta}" Margin="0,8,0,6" TextWrapping="Wrap" />

      <TextBlock Style="{StaticResource Label}" HorizontalAlignment="Left" Margin="0,12,0,6" Text="書き出し先のフォルダ" />
      <DockPanel>
        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="参照…" MinWidth="80" Margin="8,0,0,0" />
        <TextBox x:Name="ExportPathBox" AllowDrop="True" />
      </DockPanel>
      <TextBlock Style="{StaticResource Micro}" Margin="2,6,0,0"
                 Text="パスの入力・貼り付け・フォルダのドラッグ＆ドロップで指定できます。zip の名前は自動で付きます。" />

      <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,10,0,0" Visibility="Collapsed" />
    </StackPanel>
  </DockPanel>
</Window>
