<!-- テキストの開き方（拡張子ごとに「既定のアプリで開く」か「エディタで開く」か）を選ぶダイアログ。ui/settings/text_open_dialog.ps1 が読み込む。
     幅 720 で、上から 説明・要約と［変更したものだけ］と絞り込み欄・一覧（高さ 342 で固定。次の行を半分見せてスクロールできると分かるようにする）・
     エディタの行（いまはメモ帳だけ。押せない［変更…］に「将来の対応」の印）・ボタン（左に［既定に戻す］、右に［キャンセル］［OK］）。
     一覧の行（拡張子と、開き方を 1 回押して選ぶ 2 つのボタン）はコードで RowsPanel に並べる
     （行の作りは text_open_dialog.ps1、文言と判断は text_open_view.ps1）。開き方のボタンは RadioButton 2 つ（行ごとに GroupName）で、
     ここの WayRadio の見た目を付ける。色・文字・コントロールの形は scripts/shared/xaml/theme.xaml にまとめてある。 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="テキストの開き方" Width="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{DynamicResource Font.Body}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource Bg.Surface}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="8,0,0,0" />
      </Style>
      <!-- 扱いを選ぶ 3 つのボタンの 1 つ。選んでいるものは Select.Soft の地・Accent.Hover の太字、「取り込まない」を選んだものは Bg.Pressed の地、
           押せないもの（実行・登録になる形式の「既定のアプリで開く」）は Bg.Subtle の地・Ink.Disabled の文字。Tag は扱いの値（default・notepad・exclude） -->
      <Style x:Key="WayRadio" TargetType="RadioButton">
        <Setter Property="Width" Value="116" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Ink.Body}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Normal}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="Bd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Border x:Name="Ring" Margin="1" CornerRadius="4" Background="Transparent">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Ring" Property="Background" Value="{StaticResource Accent.Ring}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Select.Soft}" />
                  <Setter Property="Foreground" Value="{StaticResource Accent.Hover}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Subtle}" />
                  <Setter Property="Foreground" Value="{StaticResource Ink.Disabled}" />
                  <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="24,16,24,20">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <Button x:Name="TextExtResetButton" DockPanel.Dock="Left" Margin="0" AutomationProperties.AutomationId="TextExtResetButton" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="TextExtCancelButton" IsCancel="True" AutomationProperties.AutomationId="TextExtCancelButton" />
        <Button x:Name="TextExtOkButton" Style="{StaticResource Primary}" IsDefault="True" AutomationProperties.AutomationId="TextExtOkButton" />
      </StackPanel>
    </DockPanel>

    <!-- エディタの行（いまはメモ帳だけ。［変更…］は押せない見た目で、「将来の対応」の印を付ける） -->
    <Border x:Name="TextExtEditorRow" DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="12,8" CornerRadius="4"
            Background="{StaticResource Bg.Subtle}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1">
      <DockPanel>
        <Button x:Name="TextExtEditorChangeButton" DockPanel.Dock="Right" Height="26" MinWidth="64" IsEnabled="False"
                AutomationProperties.AutomationId="TextExtEditorChangeButton" />
        <Border x:Name="TextExtEditorMark" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="8,2" CornerRadius="9" VerticalAlignment="Center"
                Background="{StaticResource Warn.Soft}">
          <TextBlock x:Name="TextExtEditorMarkText" Style="{StaticResource Micro}" Foreground="{StaticResource Warn.Strong}" />
        </Border>
        <TextBlock x:Name="TextExtEditorHint" DockPanel.Dock="Right" Style="{StaticResource Meta}" Margin="12,0,0,0" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="TextExtEditorTitle" FontWeight="SemiBold" Foreground="{StaticResource Ink.Strong}" />
          <TextBlock x:Name="TextExtEditorName" Margin="12,0,0,0" Style="{StaticResource Meta}" AutomationProperties.AutomationId="TextExtEditorName" />
        </StackPanel>
      </DockPanel>
    </Border>

    <TextBlock x:Name="NoteText" DockPanel.Dock="Top" Style="{StaticResource Meta}" TextWrapping="Wrap" />

    <!-- 要約と［変更したものだけ］・絞り込み欄 -->
    <DockPanel DockPanel.Dock="Top" Margin="0,12,0,0">
      <Grid DockPanel.Dock="Right" Width="230" Margin="8,0,0,0">
        <TextBox x:Name="TextExtFilterBox" Height="28" VerticalContentAlignment="Center"
                 AutomationProperties.AutomationId="TextExtFilterBox" AutomationProperties.Name="拡張子で絞り込み" />
        <TextBlock x:Name="TextExtFilterPlaceholder" Style="{StaticResource Meta}" Margin="10,0,0,0" VerticalAlignment="Center"
                   IsHitTestVisible="False" Foreground="{StaticResource Ink.Disabled}" />
      </Grid>
      <ToggleButton x:Name="TextExtChangedOnly" DockPanel.Dock="Right" Height="28" MinWidth="0" Padding="12,0" Margin="0"
                    FontSize="12" AutomationProperties.AutomationId="TextExtChangedOnly">
        <ToggleButton.Template>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" CornerRadius="6" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Normal}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <TextBlock x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"
                         Foreground="{StaticResource Ink.Strong}" FontWeight="SemiBold" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Select.Soft}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Accent.Hover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </ToggleButton.Template>
      </ToggleButton>
      <TextBlock x:Name="TextExtSummary" Style="{StaticResource Meta}" VerticalAlignment="Center" AutomationProperties.AutomationId="TextExtSummary" />
    </DockPanel>

    <Border Margin="0,10,0,0" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Subtle}" BorderBrush="{StaticResource Border.Soft}"
                BorderThickness="0,0,0,1" CornerRadius="5,5,0,0" Padding="10,7">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ExtensionHeader" Grid.Column="1" Style="{StaticResource Meta}" FontWeight="SemiBold" Foreground="{StaticResource Ink.Strong}" />
            <TextBlock x:Name="WayHeader" Grid.Column="2" Style="{StaticResource Meta}" FontWeight="SemiBold" Foreground="{StaticResource Ink.Strong}" />
          </Grid>
        </Border>
        <!-- 一覧の高さは固定（絞り込みで行が減っても、ダイアログの高さは変えない）。右にスクロールバー -->
        <Grid Height="342">
          <ScrollViewer x:Name="TextExtList" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="RowsPanel" />
          </ScrollViewer>
          <TextBlock x:Name="TextExtEmpty" Style="{StaticResource Meta}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
