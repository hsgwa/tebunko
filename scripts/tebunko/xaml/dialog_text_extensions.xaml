<!-- テキストファイルの拡張子の扱い（取り込むか・開き方）を選ぶダイアログ。ui/settings/text_ext_dialog.ps1 が読み込む。
     行（拡張子と扱いの選択）はコードで RowsPanel に並べる。文言は ui/settings/text_ext_view.ps1。
     色・文字・コントロールの形は scripts/shared/xaml/theme.xaml にまとめてある。 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="テキストファイルの拡張子" Width="520" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{DynamicResource Font.Body}" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource Bg.Surface}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="8,0,0,0" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="20,16,20,20">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <Button x:Name="TextExtResetButton" DockPanel.Dock="Left" Margin="0" AutomationProperties.AutomationId="TextExtResetButton" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="TextExtCancelButton" IsCancel="True" AutomationProperties.AutomationId="TextExtCancelButton" />
        <Button x:Name="TextExtOkButton" Style="{StaticResource Primary}" IsDefault="True" AutomationProperties.AutomationId="TextExtOkButton" />
      </StackPanel>
    </DockPanel>

    <TextBlock x:Name="NoteText" DockPanel.Dock="Top" Style="{StaticResource Meta}" TextWrapping="Wrap" />

    <Border Margin="0,12,0,0" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Subtle}" BorderBrush="{StaticResource Border.Soft}"
                BorderThickness="0,0,0,1" CornerRadius="5,5,0,0" Padding="10,7">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ExtensionHeader" Grid.Column="0" Style="{StaticResource Meta}" FontWeight="SemiBold" Foreground="{StaticResource Ink.Strong}" />
            <TextBlock x:Name="WayHeader" Grid.Column="1" Style="{StaticResource Meta}" FontWeight="SemiBold" Foreground="{StaticResource Ink.Strong}" />
          </Grid>
        </Border>
        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel x:Name="RowsPanel" />
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
