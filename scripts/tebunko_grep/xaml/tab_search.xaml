<!-- ［2 検索］タブの中身。tebunko_grep.xaml の SearchTab に入れる（gui.ps1）。左：検索対象インデックスのツリー、右：検索ワードと結果 -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Grid.Resources>  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="248" MinWidth="150" />
    <ColumnDefinition Width="12" />
    <ColumnDefinition Width="*" MinWidth="420" />
  </Grid.ColumnDefinitions>

  <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="検索対象" Margin="0,0,0,10"
                 ToolTip="［1 インデックス管理］で作ったインデックスの一覧です" />
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
        <Button x:Name="CheckAllIndexButton" Content="すべて選択" MinWidth="0" Height="28" Padding="10,0" />
        <Button x:Name="UncheckAllIndexButton" Content="すべて解除" MinWidth="0" Height="28" Padding="10,0" Margin="8,0,0,0" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Micro}" Margin="2,10,0,0"
                 Text="チェックしたインデックス・フォルダだけを検索します。" />
      <Grid>
        <TreeView x:Name="IndexTree">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource TreeViewItem.Base}">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}" Margin="0,1">
                <CheckBox x:Name="Check" IsChecked="{Binding IsChecked, Mode=OneWay}" IsThreeState="True" Focusable="False" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock x:Name="Label" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding Exists}" Value="False">
                  <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFiles}" Value="True">
                  <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Ink.Muted}" />
                  <Setter TargetName="Label" Property="FontSize" Value="12" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                  <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Ink.Faint}" />
                </DataTrigger>
              </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
        <TextBlock x:Name="IndexTreePlaceholder" Style="{StaticResource Placeholder}" Margin="12,10"
                   VerticalAlignment="Top" TextWrapping="Wrap" Visibility="Collapsed"
                   Text="インデックスがありません。［1 インデックス管理］でインデックスを作成してください。" />
      </Grid>
    </DockPanel>
  </Border>

  <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" />

  <Grid Grid.Column="2">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <!-- 結果の表とプレビューの高さは、間の GridSplitter のドラッグで変わる（3 行目が結果の表、5 行目がプレビュー） -->
      <RowDefinition Height="*" MinHeight="60" />
      <RowDefinition Height="Auto" />
      <!-- 下限は、列見出し＋1 行（一致した行）が見える高さ -->
      <RowDefinition x:Name="DetailRow" Height="200" MinHeight="100" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 検索ワードと条件 -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,14">
      <StackPanel>
        <DockPanel>
          <TextBlock Style="{StaticResource Heading}" Text="検索ワード" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Button x:Name="SearchButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="検索" MinWidth="110" Height="34" Margin="10,0,0,0" />
          <TextBox x:Name="WordBox" Height="34" />
        </DockPanel>
        <!-- 検索条件（サクラエディタの Grep の条件にならう） -->
        <DockPanel Margin="0,12,0,0">
          <CheckBox x:Name="CaseCheck" DockPanel.Dock="Left" Content="大文字と小文字を区別" VerticalAlignment="Center" Margin="0,0,18,0"
                    ToolTip="オンにすると、英字の大文字と小文字を区別します（例: ID は id・Id に一致しない）" />
          <CheckBox x:Name="RegexCheck" DockPanel.Dock="Left" Content="正規表現を使う" VerticalAlignment="Center" Margin="0,0,18,0" />
          <CheckBox x:Name="ShapeCheck" DockPanel.Dock="Left" Content="図形も検索" VerticalAlignment="Center" Margin="0,0,18,0"
                    ToolTip="オンにすると、図形・テキストボックス・SmartArt・グラフの文字も検索します（種別が「図形」の結果。PowerPoint のテキストボックスはスライドの本文）" />
          <CheckBox x:Name="CommentCheck" DockPanel.Dock="Left" Content="コメントも検索" VerticalAlignment="Center" Margin="0,0,18,0"
                    ToolTip="オンにすると、Excel・Word・PowerPoint のコメント（返信を含む）も検索します（種別が「コメント」の結果）" />
          <TextBlock DockPanel.Dock="Left" Text="対象ファイル" Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Grid MaxWidth="320" HorizontalAlignment="Stretch"
                ToolTip="元のファイル名で検索するファイルを絞ります。; で区切り、! で始まるものは除外します。* は任意の文字列（* が無ければ部分一致）。空ならすべて&#10;例: *.xlsx;見積;!*old*">
            <TextBox x:Name="FileFilterBox" FontSize="12" />
            <TextBlock x:Name="FileFilterPlaceholder" Style="{StaticResource Placeholder}" FontSize="12"
                       Text="すべて（例: *.xlsx;見積;!*old*）" />
          </Grid>
        </DockPanel>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1" Margin="2,8,0,0">
      <TextBlock x:Name="WordNotice" Style="{StaticResource WarnText}" Visibility="Collapsed" />
      <DockPanel>
        <Button x:Name="GoIndexTabButton" DockPanel.Dock="Right" Style="{StaticResource Link}" Content="インデックスを作成する" Margin="12,0,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="SearchTargetText" Style="{StaticResource Micro}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </DockPanel>
    </StackPanel>

    <!-- 件数・進捗・絞り込み -->
    <DockPanel Grid.Row="2" Margin="0,12,0,6">
      <Grid DockPanel.Dock="Right" Width="240">
        <TextBox x:Name="FilterBox" FontSize="12" />
        <TextBlock x:Name="FilterPlaceholder" Style="{StaticResource Placeholder}" FontSize="12" Text="結果の中から探す" />
      </Grid>
      <TextBlock DockPanel.Dock="Right" Text="絞り込み" Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="0,0,10,0" />
      <ProgressBar x:Name="SearchProgress" DockPanel.Dock="Right" Width="180" Margin="0,0,16,0" Maximum="1" Visibility="Collapsed" VerticalAlignment="Center" />
      <!-- 検索結果の件数は、この画面の主役 -->
      <TextBlock x:Name="SummaryText" Style="{StaticResource Focal}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <!-- 結果の表 -->
    <DataGrid Grid.Row="3" x:Name="ResultGrid">
      <DataGrid.Columns>
        <DataGridTextColumn x:Name="IndexColumn" Header="インデックス" Binding="{Binding IndexName}" Width="100" Visibility="Collapsed"
                            ElementStyle="{StaticResource Cell.Meta}" />
        <DataGridTextColumn Header="フォルダ" Binding="{Binding RelDir}" Width="150" ElementStyle="{StaticResource Cell.Meta}" />
        <DataGridTextColumn Header="ファイル名" Binding="{Binding Book}" Width="170" ElementStyle="{StaticResource Cell.Key}" />
        <!-- 場所は表示用の文字（[シート] 売上 など）。並べ替えは元の名前（ページ003 など、桁をそろえてある）で行う -->
        <DataGridTextColumn Header="場所" Binding="{Binding PlaceText}" SortMemberPath="Location" Width="130" ElementStyle="{StaticResource Cell.Meta}" />
        <DataGridTextColumn Header="種別" Binding="{Binding Kind}" Width="64" ElementStyle="{StaticResource Cell.Meta}" />
        <DataGridTextColumn Header="行" Binding="{Binding LineNumber}" Width="50" ElementStyle="{StaticResource Cell.Number}" />
        <DataGridTextColumn Header="セル" Binding="{Binding CellText}" Width="80" CanUserSort="False" ElementStyle="{StaticResource Cell.Meta}" />
        <DataGridTemplateColumn Header="該当行" Width="*" SortMemberPath="Line">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ItemsControl ItemsSource="{Binding Segments}" ToolTip="{Binding DisplayLine}" ClipToBounds="True">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock x:Name="Seg" Style="{StaticResource Cell}" TextTrimming="None" Text="{Binding Text}" />
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsHit}" Value="True">
                        <Setter TargetName="Seg" Property="Background" Value="{StaticResource Hit}" />
                        <Setter TargetName="Seg" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="Seg" Property="Foreground" Value="{StaticResource Ink.Strong}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem x:Name="MenuOpen" Header="元のファイルを開く（編集する）" />
          <MenuItem x:Name="MenuOpenReadOnly" Header="読み取り専用で開く" />
          <MenuItem x:Name="MenuOpenNew" Header="新規で開く" />
          <MenuItem x:Name="MenuOpenFolder" Header="フォルダを開く" />
          <Separator />
          <MenuItem x:Name="MenuCopy" Header="選択行をコピー" InputGestureText="Ctrl+C" />
          <MenuItem x:Name="MenuCopyPath" Header="ファイルのパスをコピー" />
        </ContextMenu>
      </DataGrid.ContextMenu>
    </DataGrid>

    <!-- 結果の表とプレビューの境目。上下にドラッグするとプレビューの高さが変わる -->
    <GridSplitter Grid.Row="4" Height="11" Margin="0,3,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeNS"
                  ToolTip="上下にドラッグすると、プレビューの高さを変えられます">
      <GridSplitter.Template>
        <ControlTemplate TargetType="GridSplitter">
          <!-- 当たり判定は 11px 分とり、見た目は境目の細い線と、つまめることが分かる真ん中のグリップにする -->
          <Border Background="Transparent">
            <Grid>
              <Border Height="1" Background="{StaticResource Border.Soft}" VerticalAlignment="Center" />
              <Border x:Name="Grip" Width="48" Height="5" CornerRadius="3" Background="#CBD0D6"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Grip" Property="Background" Value="{StaticResource Ink.Muted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </GridSplitter.Template>
    </GridSplitter>

    <!-- 選択行のプレビュー（前後の行をシートのように表示する。行番号の列の幅 44 は config_gui.ps1 の NumberWidth と合わせる）。
         行を選んでいなくても枠は出したままにする（高さが変わらず、次に選んだときもその場に出る） -->
    <DockPanel Grid.Row="5" x:Name="DetailPanel" Margin="0,3,0,0">
      <DockPanel DockPanel.Dock="Top">
        <!-- 行を選ぶまでは押せない（プレビューの枠は行を選んでいなくても出したままにするため） -->
        <Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Content="フォルダを開く" Margin="8,0,0,0" IsEnabled="False" />
        <Button x:Name="OpenButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Excel で開く" MinWidth="120" IsEnabled="False" />
        <!-- 開き方（ダブルクリック・Enter・［開く］の動作。右クリックメニューでは、その時だけ別の開き方も選べる） -->
        <ComboBox x:Name="OpenModeCombo" DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="200" Margin="0,0,10,0">
          <ComboBoxItem Tag="normal" Content="通常（編集する）"
                        ToolTip="元のファイルをそのまま開きます。編集して上書き保存できます。" />
          <ComboBoxItem Tag="readOnly" Content="読み取り専用"
                        ToolTip="元のファイルを読み取り専用で開きます。誤って上書き保存することがありません（編集するときは名前を付けて保存します）。" />
          <ComboBoxItem Tag="new" Content="新規（元のファイルを占有しない）"
                        ToolTip="元のファイルを基にした新しい（無題の）ブック・文書として開きます。元のファイルを占有しないため、ほかの人が編集中でも開け、ほかの人の編集も妨げません。保存するときは名前を付けて保存します。" />
        </ComboBox>
        <TextBlock DockPanel.Dock="Right" Text="開き方" Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock x:Name="DetailTitle" Style="{StaticResource Heading}" VerticalAlignment="Center" Margin="0,0,10,0"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </DockPanel>
      <!-- 枠は四方に引く（高さを変えられるため、下・右にも枠が無いと切れて見える） -->
      <Border BorderBrush="{StaticResource Border.Soft}" BorderThickness="1" CornerRadius="8"
              Background="{StaticResource Bg.Surface}" Margin="0,8,0,0" ClipToBounds="True">
        <Grid>
          <DockPanel>
            <!-- 列見出しは、枠を低くしても隠れないよう、行とは別のスクロールに置く（横位置は config_gui.ps1 で PreviewScroll に合わせる） -->
            <ScrollViewer x:Name="PreviewHeaderScroll" DockPanel.Dock="Top" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          Focusable="False" Visibility="Collapsed">
              <StackPanel TextElement.FontSize="12">

                <!-- 列見出し（右端をドラッグすると、その列の幅が変わる。幅は PreviewColumn を各行のセルと共有する） -->
                <StackPanel Orientation="Horizontal">
                  <!-- 行番号の列の分（幅 44 は config_gui.ps1 の NumberWidth と合わせる） -->
                  <Border Width="44" Background="{StaticResource Bg.Subtle}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,0,1,1" />
                  <ItemsControl x:Name="PreviewHeader">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Width="{Binding Width}" Background="{StaticResource Bg.Subtle}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,0,1,1">
                          <Grid>
                            <TextBlock Text="{Binding Label}" Padding="6,3" FontSize="11" TextAlignment="Center"
                                       Foreground="{StaticResource Ink.Muted}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <Thumb HorizontalAlignment="Right" Width="6" Cursor="SizeWE"
                                   ToolTip="ドラッグすると列の幅を変えられます">
                              <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                  <Border Background="Transparent" />
                                </ControlTemplate>
                              </Thumb.Template>
                            </Thumb>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <!-- 枠の高さはドラッグで変わるため、行が入りきらないときは縦にもスクロールできるようにする -->
            <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Focusable="True">
              <ScrollViewer.ContextMenu>
                <ContextMenu>
                  <MenuItem x:Name="MenuPreviewCopy" Header="選んだセルをコピー" InputGestureText="Ctrl+C" />
                  <MenuItem x:Name="MenuPreviewCopyRow" Header="この行をコピー" />
                </ContextMenu>
              </ScrollViewer.ContextMenu>
              <StackPanel TextElement.FontSize="12">

                <ItemsControl x:Name="PreviewRows">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel x:Name="RowPanel" Orientation="Horizontal">
                        <Border Width="44" Background="{StaticResource Bg.Subtle}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,0,1,1">
                          <TextBlock x:Name="Num" Text="{Binding Number}" Padding="4,2,6,2" FontSize="11" TextAlignment="Right"
                                     Foreground="{StaticResource Ink.Faint}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Cells}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <!-- セル内改行のあるセルは折り返して複数行で表示する（高さの上限まで。全文はツールチップ） -->
                              <Border x:Name="CellBorder" Width="{Binding Column.Width}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="0,0,1,1">
                                <TextBlock x:Name="CellText" Text="{Binding Display}" ToolTip="{Binding ToolTip}" Padding="6,3"
                                           Foreground="{StaticResource Ink.Body}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="58" />
                              </Border>
                              <DataTemplate.Triggers>
                                <!-- コピーのために選んだセル（一致したセルは黄色のまま、枠だけを青にする） -->
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter TargetName="CellBorder" Property="Background" Value="#BFDBFE" />
                                  <Setter TargetName="CellBorder" Property="BorderBrush" Value="{StaticResource Accent.Hover}" />
                                  <Setter TargetName="CellBorder" Property="BorderThickness" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHit}" Value="True">
                                  <Setter TargetName="CellBorder" Property="Background" Value="{StaticResource Hit}" />
                                  <Setter TargetName="CellText" Property="FontWeight" Value="SemiBold" />
                                  <Setter TargetName="CellText" Property="Foreground" Value="{StaticResource Ink.Strong}" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsHit}" Value="True" />
                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                  </MultiDataTrigger.Conditions>
                                  <Setter TargetName="CellBorder" Property="BorderBrush" Value="{StaticResource Accent.Hover}" />
                                  <Setter TargetName="CellBorder" Property="BorderThickness" Value="1" />
                                </MultiDataTrigger>
                              </DataTemplate.Triggers>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <DataTemplate.Triggers>
                        <!-- 選択行は行全体を薄い青にし、行番号を目立たせる -->
                        <DataTrigger Binding="{Binding IsHitRow}" Value="True">
                          <Setter TargetName="RowPanel" Property="Background" Value="{StaticResource Select.Soft}" />
                          <Setter TargetName="Num" Property="FontWeight" Value="SemiBold" />
                          <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Accent.Hover}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
          <!-- 行を選んでいないときの案内（プレビューの枠は出したままにする） -->
          <TextBlock x:Name="PreviewPlaceholder" Style="{StaticResource Placeholder}" Margin="12,10"
                     VerticalAlignment="Top" TextWrapping="Wrap"
                     Text="結果の表で行を選ぶと、ここにその前後の行を表示します。" />
        </Grid>
      </Border>
    </DockPanel>

    <DockPanel Grid.Row="6" Margin="0,10,0,0">
      <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="結果をファイルに出力" MinWidth="150" />
      <!-- 横に長い行で、表示した列の範囲を知らせる（ふだんは隠す） -->
      <TextBlock x:Name="PreviewNote" DockPanel.Dock="Right" Style="{StaticResource WarnText}" Margin="8,0" VerticalAlignment="Center"
                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
      <TextBlock Style="{StaticResource Micro}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                 Text="行を選ぶと前後の行を表示　プレビューのセルをクリック → Ctrl+C でその値をコピー（Shift＋クリック・ドラッグで複数）　ダブルクリック・Enter：元のファイルを開く" />
    </DockPanel>
  </Grid>
</Grid>
