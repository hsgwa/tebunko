<!-- ［1 インデックス管理］タブの中身。tebunko_grep.xaml の IndexTab に入れる（gui.ps1） -->
<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </DockPanel.Resources>
  <!-- 下部：インデックス作成の開始と進捗 -->
  <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,13">
    <StackPanel>
      <DockPanel>
        <Button x:Name="IndexingButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="インデックス作成を開始" MinWidth="150" Height="34" />
        <TextBlock x:Name="IndexingHint" Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="0,0,14,0"
                   Text="押すと、何件取り込むかを確認してから、新しいファイル・変わったファイルだけを取り込みます。" />
      </DockPanel>

      <StackPanel x:Name="IndexingProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
        <DockPanel>
          <Button x:Name="IndexingStopButton" DockPanel.Dock="Right" Content="中止" MinWidth="72" Margin="12,0,0,0" />
          <Button x:Name="IndexingLogButton" DockPanel.Dock="Right" Style="{StaticResource Link}" Content="ログを開く"
                  VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed" />
          <TextBlock x:Name="IndexingProgressEta" DockPanel.Dock="Right" Style="{StaticResource Meta}" VerticalAlignment="Center" />
          <!-- インデックス作成中は、この件数がこの画面の主役 -->
          <TextBlock x:Name="IndexingProgressText" Style="{StaticResource Focal}" VerticalAlignment="Center" />
        </DockPanel>
        <ProgressBar x:Name="IndexingProgress" Margin="0,9,0,0" Maximum="1" />
        <TextBlock x:Name="IndexingProgressDetail" Style="{StaticResource Micro}" Margin="0,7,0,0"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </StackPanel>
    </StackPanel>
  </Border>

  <Border Style="{StaticResource Card}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="120" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 見出しと補足は、太さと大きさで分ける -->
      <StackPanel Grid.Row="0" Orientation="Horizontal">
        <TextBlock Style="{StaticResource Heading}" Text="インデックス一覧" />
        <TextBlock Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="10,0,0,0"
                   Text="チェックを付けたインデックスを取り込みます" />
      </StackPanel>

      <DockPanel Grid.Row="1" Margin="0,10,0,0">
        <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" Width="150">
          <Button x:Name="NewIndexButton" Content="追加…" ToolTip="Office ファイルのあるフォルダを指定して、新しいインデックスを追加します" />
          <Button x:Name="EditIndexButton" Content="編集…" Margin="0,8,0,0" ToolTip="選んだインデックスの名前と、元のフォルダの場所を変えます（インデックスはそのまま使います）" />
          <Button x:Name="RemoveIndexButton" Style="{StaticResource Danger}" Content="削除" Margin="0,8,0,0" ToolTip="選んだインデックスを一覧から消します（元のフォルダとファイルはそのまま残ります）" />
          <TextBlock Style="{StaticResource Micro}" Margin="2,14,0,0"
                     Text="一覧にフォルダをドラッグ＆ドロップしても追加できます。" />
        </StackPanel>
        <Grid>
          <DataGrid x:Name="IndexGrid" SelectionMode="Single" CanUserSortColumns="False" AllowDrop="True" MinHeight="90">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="作成" Width="52">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" HorizontalAlignment="Center"
                              ToolTip="チェックを付けたインデックスだけを取り込みます（外してもインデックスは残ります）" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- 目で追う列を 1 本に絞るため、インデックス名だけ濃くする -->
              <DataGridTemplateColumn Header="インデックス名" Width="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Cell.Key}" Text="{Binding Name}" ToolTip="{Binding Name}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="元のフォルダ" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Cell.Meta}" Text="{Binding Path}" ToolTip="{Binding Path}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="フォルダの状態" Width="140">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Cell}" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="ファイル" Width="76">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Cell.Number}" Text="{Binding FileCountText}" ToolTip="{Binding FileCountToolTip}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="最終取り込み" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Cell.Meta}" Text="{Binding LastIngestedText}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="IndexGridPlaceholder" Style="{StaticResource Placeholder}" Margin="12,40"
                     VerticalAlignment="Top" TextWrapping="Wrap"
                     Text="インデックスがありません。［追加…］で、Office ファイルのあるフォルダを指定してください。" />
        </Grid>
      </DockPanel>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,6">
        <TextBlock Style="{StaticResource Heading}" Text="インデックスの状態" />
        <TextBlock Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="10,0,0,0"
                   Text="すべてのインデックスの合計" />
      </StackPanel>
      <StackPanel Grid.Row="3">
        <TextBlock x:Name="IndexSummaryText" Text="確認中…" />
        <!-- インデックス（work）の置き場所。ツールのフォルダの外にも置ける -->
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock x:Name="WorkDirText" Style="{StaticResource Meta}" VerticalAlignment="Center" />
          <Button x:Name="ChangeWorkDirButton" Style="{StaticResource Link}" Content="変更…" VerticalAlignment="Center" Margin="12,0,0,0"
                  ToolTip="インデックス・取り込み一覧・ログを置くフォルダを変えます（今のインデックスは移しません）" />
          <Button x:Name="ResetWorkDirButton" Style="{StaticResource Link}" Content="既定に戻す" VerticalAlignment="Center" Margin="12,0,0,0"
                  Visibility="Collapsed" ToolTip="設定ファイルと同じフォルダの work に戻します" />
        </StackPanel>
        <TextBlock x:Name="IndexingStateText" Style="{StaticResource WarnText}" Margin="0,6,0,0" />
        <StackPanel x:Name="FailedPanel" Visibility="Collapsed" Margin="0,8,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Micro}" VerticalAlignment="Bottom"
                       Text="ダブルクリックでファイルの場所を開きます" />
            <TextBlock x:Name="FailedHeading" Style="{StaticResource ErrorText}" />
          </DockPanel>
          <DataGrid x:Name="FailedGrid" MaxHeight="130" Margin="0,6,0,0" SelectionMode="Single" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="ファイル" Width="280">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Cell.Key}" Text="{Binding RelPath}" ToolTip="{Binding RelPath}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="失敗の原因" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Cell}" TextTrimming="None" TextWrapping="Wrap"
                               Text="{Binding Reason}" ToolTip="{Binding Reason}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="日時" Binding="{Binding IngestedText}" Width="80"
                                  ElementStyle="{StaticResource Cell.Meta}" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</DockPanel>
