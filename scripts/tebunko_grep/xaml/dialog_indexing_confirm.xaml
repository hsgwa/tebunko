<!-- インデックス作成の確認ダイアログ（［インデックス作成を開始］を押した後、取り込み対象を数え終えたときに開く）。gui.ps1 が読み込む。
     色・文字・コントロールの形は scripts/shared/xaml/theme.xaml にまとめてある。 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="インデックス作成の確認" Width="880" Height="500" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Background="White" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../shared/xaml/theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="18,16,18,16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="StartButton" Style="{StaticResource Primary}" Content="インデックス作成を開始" IsDefault="True" MinWidth="130" Height="34" />
      <Button x:Name="CancelButton" Content="キャンセル" IsCancel="True" MinWidth="104" Height="34" Margin="8,0,0,0" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <CheckBox x:Name="RetryCheck" Visibility="Collapsed" Margin="0,0,0,10" />
      <!-- 取り込む合計件数が、この画面の主役 -->
      <TextBlock x:Name="TotalText" Style="{StaticResource Focal}" TextWrapping="Wrap" />
      <TextBlock x:Name="NoteText" Style="{StaticResource Meta}" Margin="0,6,0,0" Visibility="Collapsed" />
    </StackPanel>

    <TextBlock x:Name="IntroText" DockPanel.Dock="Top" Style="{StaticResource Meta}" Margin="0,0,0,12" />

    <DataGrid x:Name="PlanGrid" MinHeight="120" CanUserAddRows="False" SelectionMode="Single" CanUserSortColumns="False">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="インデックス" Width="140">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Cell.Key}" Text="{Binding Name}" ToolTip="{Binding Path}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- 何件取り込むかが、この表で見る値 -->
        <DataGridTemplateColumn Header="取り込み対象" Width="110">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Cell}" FontWeight="SemiBold" Text="{Binding TargetText}" Foreground="{Binding TargetBrush}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="内訳" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Cell}" Text="{Binding DetailText}" ToolTip="{Binding DetailText}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Office ファイル" Width="105">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Cell.Number}" HorizontalAlignment="Stretch" Text="{Binding TotalText}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="元のフォルダ" Width="180">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Style="{StaticResource Cell.Meta}" Text="{Binding Path}" ToolTip="{Binding Path}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
